			N("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,4),VerticalAlignment=Enum.VerticalAlignment.Center},sf)
			for _,nm in ipairs(names) do local b=btn(sf,nm,13,nm==target and PURP or RGB(60,80,150),{Size=UDim2.fromOffset(math.max(50,#nm*9+16),32)}) b.Activated:Connect(function() target=nm tgtL.Text="Target: "..nm build() end) end
			arow("Give coins","amount","Give",function(t) A_("coins",t) end)
