N("UIGradient",{Color=ColorSequence.new(RGB(255,140,140),RGB(200,40,40)),Rotation=90},fireB)
lbl(fireB,"FIRE",26,{Size=UDim2.fromScale(1,1)})
fireB.MouseButton1Down:Connect(function() holding=true end) fireB.MouseButton1Up:Connect(function() holding=false end) fireB.MouseLeave:Connect(function() holding=false end)
local function setAmmo()
	ammoT.Text=ammo.."/"..mag
	local on=tool~=nil and not introOn
	ammoF.Visible=on relB.Visible=on cross.Visible=on fireB.Visible=on
end
local function aimPoint()
	local cam=workspace.CurrentCamera local vp=cam.ViewportSize
	local ray=cam:ViewportPointToRay(vp.X/2,vp.Y/2)
	local rp=RaycastParams.new() rp.FilterType=Enum.RaycastFilterType.Exclude rp.FilterDescendantsInstances={lp.Character}
	local r=workspace:Raycast(ray.Origin,ray.Direction*600,rp)
	if r then return r.Position end
	return ray.Origin+ray.Direction*600
end
local function nearestAnimal()
	local c=lp.Character local r=c and c:FindFirstChild("HumanoidRootPart") local f=workspace:FindFirstChild("Animals") if not r or not f or not S then return end
	local best,bd=nil,S.St.rng
	for _,m in f:GetChildren() do local b=m.PrimaryPart if b and S.Zones[m:GetAttribute("Zone")] then local d=(b.Position-r.Position).Magnitude if d<bd then best,bd=b.Position,d end end end
	return best
end
local function fire(tgt)
	local c=lp.Character local head=c and c:FindFirstChild("Head") if not head or not tool or not S then return end
	local now=os.clock() if now-lastFire<1/S.St.rate or reloading then return end
	if ammo<=0 then Act:FireServer("Reload") lastFire=now+.4 return end
	lastFire=now ammo-=1 setAmmo() recoil=1
	local dir=tgt-head.Position Act:FireServer("Shoot",dir)
	local rng=S.St.rng local endp=head.Position+dir.Unit*math.min(dir.Magnitude,rng)
	local m=tool:FindFirstChild("Muzzle",true) local o=m and m.WorldPosition or head.Position
	local w=Cfg.WN[S.Equipped] tracer(o,endp,Cfg.RarCol[w.Rank]) burst(o,Cfg.RarCol[w.Rank],4,.6) Sfx("shoot")
end
local touch=UIS.TouchEnabled
task.spawn(function() while true do task.wait()
	local c=lp.Character
	local t=c and c:FindFirstChildOfClass("Tool")
	if t~=tool then
		tool=t holding=false
		if t then t.Activated:Connect(function() if not touch then holding=true end end) t.Deactivated:Connect(function() holding=false end) end
		setAmmo()
	end
	if tool and S and not introOn then
		if opts.Auto then local tg=nearestAnimal() if tg then fire(tg) end elseif holding then fire(aimPoint()) end
	end
end end)

-- CUTSCENES
local barT=N("Frame",{Size=UDim2.new(1,0,0,0),BackgroundColor3=RGB(0,0,0),BorderSizePixel=0,ZIndex=40},gui)
local barB=N("Frame",{AnchorPoint=Vector2.new(0,1),Position=UDim2.fromScale(0,1),Size=UDim2.new(1,0,0,0),BackgroundColor3=RGB(0,0,0),BorderSizePixel=0,ZIndex=40},gui)
local capL=lbl(gui,"",34,{Size=UDim2.new(1,0,0,50),AnchorPoint=Vector2.new(0,1),Position=UDim2.new(0,0,1,-70),ZIndex=41,TextTransparency=1,TextStrokeTransparency=0})
local function bars(on) local h=on and 54 or 0 TS:Create(barT,TweenInfo.new(.3),{Size=UDim2.new(1,0,0,h)}):Play() TS:Create(barB,TweenInfo.new(.3),{Size=UDim2.new(1,0,0,h)}):Play() end
local function capCut(pos,name,rank)
	if cutOn or introOn or not opts.Cut then return end
	local cam=workspace.CurrentCamera if not cam then return end
	cutOn=true
	local dur=rank>=6 and 2.6 or 1.5
	capL.Text="CAUGHT: "..name.."  ["..Cfg.Rar[rank].."]" capL.TextColor3=Cfg.RarCol[rank] capL.TextTransparency=0
	bars(true)
	pcall(function()
		cam.CameraType=Enum.CameraType.Scriptable
		local start=cam.CFrame local t0=os.clock()
		while os.clock()-t0<dur do
			local k=(os.clock()-t0)/dur
			local ang=k*(rank>=6 and 2.4 or 1.4)
			local eye=pos+Vector3.new(math.sin(ang)*(12+k*4),4+k*3,math.cos(ang)*(12+k*4))
			cam.CFrame=start:Lerp(CFrame.lookAt(eye,pos+Vector3.new(0,3,0)),math.min(1,k*4))
			RunS.RenderStepped:Wait()
		end
	end)
	cam.CameraType=Enum.CameraType.Custom
	bars(false) capL.TextTransparency=1
	cutOn=false
end
introFn=function()
	if introOn or cutOn then return end
	local cam=workspace.CurrentCamera introOn=true
	Act:FireServer("Seen")
	if cur then Close(cur) end
	tl.Visible=false rt.Visible=false bc.Visible=false setAmmo()
	local skip=false
	local skipB=btn(gui,"Skip >>",18,RGB(60,60,90),{Size=UDim2.fromOffset(110,38),AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-16,0,64),ZIndex=60})
	skipB.Activated:Connect(function() skip=true end)
	local sub=lbl(gui,"",28,{Size=UDim2.new(.9,0,0,90),AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,1,-64),TextWrapped=true,ZIndex=45,TextStrokeTransparency=0})
	local title=lbl(gui,"ANIMAL HUNTING SIMULATOR",40,{Size=UDim2.new(1,0,0,60),Position=UDim2.new(0,0,.14,0),ZIndex=45,TextColor3=GOLD,TextTransparency=1,TextStrokeTransparency=1,TextWrapped=true})
	bars(true)
	local function CF(ex,ey,ez,lx,ly,lz) return CFrame.lookAt(Vector3.new(ex,ey,ez),Vector3.new(lx,ly,lz)) end
	local Zs=Cfg.Zones local f1,f3,f6=Zs[1].Center,Zs[3].Center,Zs[6].Center
	local shots={
		{CF(0,60,70,0,25,-200),CF(70,45,10,0,28,-200),5.5,"Welcome, hunter! This is the Hub - the castle of the Animal Kingdom."},
		{CF(-230,45,60,-130,15,-130),CF(230,45,60,130,15,-130),6,"Six glowing portals lead to the zones: Forest, Desert, Snow, Volcano, Ocean and Sky."},
		{CF(f1.X+90,50,f1.Z+110,f1.X,5,f1.Z),CF(f1.X-60,35,f1.Z+90,f1.X,5,f1.Z),5.5,"Hunt animals with your gun: aim with the dot, then press FIRE."},
		{CF(f3.X-100,60,f3.Z+100,f3.X,5,f3.Z),CF(f3.X+80,40,f3.Z+80,f3.X,5,f3.Z),5,"Rarer animals live in harder zones - unlock them with coins."},
		{CF(f6.X+80,70,f6.Z+120,f6.X,10,f6.Z),CF(f6.X-70,45,f6.Z+90,f6.X,10,f6.Z),5,"Every animal you hunt is added to your collection."},
		{CF(0,70,190,0,2,330),CF(-90,50,250,0,2,330),5.5,"Place your animals on the base pedestals - they earn coins for you!"},
		{CF(60,40,90,0,10,0),CF(-60,30,60,0,12,0),5.5,"Spend coins on weapons and upgrades, then Rebirth for permanent bonuses."},
	}
	pcall(function()
		cam.CameraType=Enum.CameraType.Scriptable
		TS:Create(title,TweenInfo.new(1),{TextTransparency=0,TextStrokeTransparency=0}):Play()
		for i,sh in ipairs(shots) do
			if skip then break end
			sub.Text=sh[4] sub.TextTransparency=1 TS:Create(sub,TweenInfo.new(.4),{TextTransparency=0}):Play()
			if i==2 then TS:Create(title,TweenInfo.new(.6),{TextTransparency=1,TextStrokeTransparency=1}):Play() end
			local t0=os.clock()
			while os.clock()-t0<sh[3] and not skip do
				local k=(os.clock()-t0)/sh[3]
				cam.CFrame=sh[1]:Lerp(sh[2],k*k*(3-2*k))
				RunS.RenderStepped:Wait()
			end
		end
	end)
	cam.CameraType=Enum.CameraType.Custom
	bars(false) sub:Destroy() title:Destroy() skipB:Destroy()
	tl.Visible=true rt.Visible=true bc.Visible=true introOn=false setAmmo()
	Act:FireServer("Seen")
end
