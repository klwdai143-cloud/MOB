	tabSet=tabRow(top,{"Player","Server"},function() return admTab end,function(n) admTab=n build() tabSet() end,0,2,110)
	Rf.adm=function() build() tabSet() end
	local ab=btn(gui,"ADMIN",16,RED,{Size=UDim2.fromOffset(96,36),Position=UDim2.new(0,10,1,-60)}) ab.Activated:Connect(function() Open("adm") end)
end
local evBar=N("Frame",{AnchorPoint=Vector2.new(.5,0),Position=UDim2.new(.5,0,0,64),Size=UDim2.fromOffset(300,34),BackgroundColor3=RGB(40,30,70),Visible=false},gui) rd(evBar,17) st(evBar,RGB(255,200,60),2)
local evT=lbl(evBar,"",16,{Size=UDim2.fromScale(1,1)})
task.spawn(function() while true do task.wait(1)
	local e=S and S.Event
	if e and e.endT>os.time() then local left=e.endT-os.time() evBar.Visible=not introOn evT.Text=string.format("EVENT: %s  %02d:%02d",e.name,math.floor(left/60),left%60) else evBar.Visible=false end
end end)
local tgtC,tgtG,shC,shG=0,0,0,0
RunS.RenderStepped:Connect(function()
	shC+=(tgtC-shC)*.2 shG+=(tgtG-shG)*.2
	if math.abs(tgtC-shC)<1 then shC=tgtC end if math.abs(tgtG-shG)<1 then shG=tgtG end
	coinT.Text=fmt(shC) gemT.Text=fmt(shG)
end)
-- PUSH
Push.OnClientEvent:Connect(function(k,a,b,c,d,e)
	if k=="State" then
		local first=S==nil S=a
		if first then for o,v in S.Opts do opts[o]=v end applyOpts() if introFn then task.spawn(introFn) end end
		if mag==0 and not reloading then ammo,mag=S.Ammo or S.St.mag,S.St.mag setAmmo() end
		tgtC,tgtG=S.Coins,S.Gems if rwBadge then rwBadge.Visible=S.Daily.t~=math.floor(os.time()/86400) end
		local n=#S.Animals for _ in S.Placed do n+=1 end animT.Text=tostring(n)
		if cur and Rf[cur] and cur~="adm" then Rf[cur]() end
	elseif k=="Notify" then toast(a,b)
	elseif k=="Ammo" then ammo,mag=a,b setAmmo()
	elseif k=="Reload" then reloadT0=os.clock() reloadDur=a reloading=true ammoT.Text="Reloading..." Sfx("reload") task.delay(a,function() reloading=false setAmmo() end)
	elseif k=="Tracer" then tracer(a,b,c) Sfx("shoot")
	elseif k=="Hit" then dmgPop(a,b,c) Sfx("hit") burst(a,WHITE,6,.4)
	elseif k=="Caught" then
		local col=Cfg.RarCol[b] burst(e,col,40,1) Sfx("caught") task.spawn(capCut,e,a,b)
		toast("You caught "..a.." ["..Cfg.Rar[b].."]"..(c>0 and ("  +"..c.." gems") or "")..(d and "  NEW!" or ""),col)
	elseif k=="Coin" then coinFly(a)
	elseif k=="Sfx" then Sfx(a)
	elseif k=="ZoneUnlocked" then local z for _,zz in Cfg.Zones do if zz.Name==a then z=zz end end Sfx("unlock") banner("New Zone Unlocked!",z.Emoji.." "..a.." Zone",z.Col)
	elseif k=="Banner" then banner(a,b,c) Sfx("unlock")
	elseif k=="Burst" then burst(a,RGB(255,150,50),40,1.6) Sfx("unlock")
	elseif k=="Rebirth" then flash() Sfx("unlock") banner("REBIRTH!","x"..(a+1).." coin multiplier",PURP) end
end)
