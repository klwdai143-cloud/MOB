C.A={}
C.AN={}
for _,z in ipairs(C.Zones) do
	for _,a in ipairs(z.List) do
		table.insert(C.A,a)
		C.AN[a.Name]=a
	end
end
local WL={
{"Pistol",1,10,2.5,12,1.2,130,0,"c",1.3,"#2b2d33"},{"Revolver",2,18,1.8,6,1.6,150,600,"c",1.5,"#3a3f3a"},
{"Combat Shotgun",3,36,1.4,8,1.8,160,6000,"c",2.4,"#2d3f66"},{"Plasma Rifle",4,70,4.5,30,2,190,50000,"c",2.8,"#40306a"},
{"Gold Rifle",5,130,5.5,30,2,210,400000,"c",2.8,"#d9a520"},{"Crimson Rifle",6,260,6.5,35,2.2,230,3000000,"c",3,"#7a1418"},
{"Crystal Sniper",7,520,3,10,2.4,300,250,"g",3.4,"#206070"},{"Void Sniper",8,1000,3.5,12,2.4,320,700,"g",3.4,"#4a1a60"},
{"Celestial Cannon",9,2000,4,15,2.6,340,1800,"g",3.6,"#1a2a80"},{"Divine Rifle",10,4200,5,20,2.6,360,5000,"g",3.6,"#e8c030"}}
C.W,C.WN={}, {}
for _,r in WL do local w={Name=r[1],Rank=r[2],Dmg=r[3],Rate=r[4],Mag=r[5],Reload=r[6],Range=r[7],Cost=r[8],Cur=r[9],Len=r[10],Hex=r[11]} table.insert(C.W,w) C.WN[w.Name]=w end
C.Up={{"Damage","💪",100,"+8% damage"},{"FireRate","⚡",150,"+4% fire rate"},{"Ammo","🔫",120,"+10% ammo"},{"Reload","🔄",120,"-2% reload time"},{"Range","🎯",100,"+5% range"},{"Crit","💥",200,"+1% crit chance"},{"Speed","👟",100,"+3% walk speed"}}
C.UpMax=50
function C.UpCost(base,l) return math.floor(base*1.35^l) end
C.Quests={
{t="hunt",g=10,txt="Hunt %d animals",rc=500,rg=10},{t="unique",g=5,txt="Discover %d new animals",rc=1500,rg=15},
{t="weapon",g=1,txt="Buy %d new weapon",rc=2000,rg=20},{t="place",g=3,txt="Place %d animals in your base",rc=3000,rg=20},
{t="upgrade",g=5,txt="Buy %d upgrades",rc=5000,rg=25},{t="coins",g=20000,txt="Collect %d coins",rc=8000,rg=30},
{t="zone",g=1,txt="Unlock %d new zone",rc=20000,rg=60}}
function C.Quest(qi) local n=#C.Quests local q=C.Quests[(qi-1)%n+1] local k=1+math.floor((qi-1)/n) return q,q.g*k,q.rc*k,q.rg*k end
C.Daily={{c=500},{g=50},{c=2500},{g=100},{c=10000},{g=200},{c=50000,g=500}}
C.Packs={{g=10,c=5000},{g=50,c=40000},{g=250,c=250000}}
C.Boosts={{"Coins","2x Coins (10 min)",30,"🪙"},{"Dmg","2x Damage (10 min)",30,"💥"}}
function C.SlotCost(k) return 250*3^(k-4) end
function C.RebCost(r) return 250000*4^r end
return C
]]></ProtectedString></Properties></Item><Item class="RemoteEvent" referent="RBX5"><Properties><string name="Name">Act</string></Properties></Item><Item class="RemoteEvent" referent="RBX6"><Properties><string name="Name">Push</string></Properties></Item></Item><Item class="ServerScriptService" referent="RBX13"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX10"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Models</string><ProtectedString name="Source"><![CDATA[local Cfg=require(game:GetService("ReplicatedStorage"):WaitForChild("Config"))
local M={}
local SP,NEON=Enum.Material.SmoothPlastic,Enum.Material.Neon
local BALL,CYL=Enum.PartType.Ball,Enum.PartType.Cylinder
local BLACK,WHITE=Color3.new(0,0,0),Color3.new(1,1,1)
local function mk(par,name,size,col,mat,shape,cls)
	local p=Instance.new(cls or "Part") p.Name=name p.Size=size p.Color=col p.Material=mat or SP
	p.CanCollide=false p.Massless=true p.TopSurface=Enum.SurfaceType.Smooth p.BottomSurface=Enum.SurfaceType.Smooth
	if shape then p.Shape=shape end p.Parent=par return p
end
local function weld(a,b,c0,c1) local w=Instance.new("Weld") w.Name="W" w.Part0=a w.Part1=b w.C0=c0 w.C1=c1 or CFrame.new() w.Parent=b return w end
local function emitter(par,col,size,rate,spd)
	local e=Instance.new("ParticleEmitter") e.Color=ColorSequence.new(col) e.LightEmission=1 e.Rate=rate
	e.Size=NumberSequence.new(size,0) e.Lifetime=NumberRange.new(1,1.6) e.Speed=NumberRange.new(1,spd or 3)
	e.SpreadAngle=Vector2.new(180,180) e.Transparency=NumberSequence.new(.2,1) e.Parent=par return e
end
function M.Animal(d,scale,label)
	local s=d.Size*(scale or 1) local N=d.Name local ty=d.Type
	local col=d.Col local dark=col:Lerp(BLACK,.35) local light=d.Col2 or col:Lerp(WHITE,.45) local acc=Cfg.RarCol[d.Rank]
	local m=Instance.new("Model") m.Name=N
	local body=mk(m,"Body",Vector3.new(1,1,1),col) body.Anchored=true m.PrimaryPart=body
	local function R(a,b,c) return CFrame.Angles(a or 0,b or 0,c or 0) end
	local function A(n,w,h,l,x,y,z,c,mat,shape,cf)
		local p=mk(m,n,Vector3.new(w*s,h*s,l*s),c or col,mat,shape) local off=CFrame.new(x*s,y*s,z*s)*(cf or CFrame.new()) p.CFrame=body.CFrame*off weld(body,p,off) return p
	end
	local Abody=A
	local function J(n,w,h,l,px,py,pz,cx,cy,cz,c,mat,shape,cf0)
		local p=mk(m,n,Vector3.new(w*s,h*s,l*s),c or col,mat,shape) weld(body,p,CFrame.new(px*s,py*s,pz*s)*(cf0 or CFrame.new()),CFrame.new(cx*s,cy*s,cz*s)) return p
	end
	-- head group: everything added while a head is open is welded to the head, so it can nod / look around
	local function beginHead(hx,hy,hz,w,h,l,px,py,pz,c,shape)
		local hp=J("Head",w,h,l,px,py,pz,px-hx,py-hy,pz-hz,c,nil,shape)
		A=function(n,w2,h2,l2,x,y,z,c2,mat,shape2,cf)
			local p=mk(m,n,Vector3.new(w2*s,h2*s,l2*s),c2 or col,mat,shape2) weld(hp,p,CFrame.new((x-hx)*s,(y-hy)*s,(z-hz)*s)*(cf or CFrame.new())) return p
		end
		return hp
	end
	local function endHead() A=Abody end
	local function eyes(y,z,x,sz) for sx=-1,1,2 do
		if d.Rank<4 then A("Eye",sz*1.1,sz*1.35,sz*.5,x*sx,y,z,BLACK) A("Glint",sz*.4,sz*.4,sz*.3,x*sx-sx*sz*.15,y+sz*.3,z-sz*.2,WHITE)
		else A("Eye",sz,sz,sz*.6,x*sx,y,z,acc,NEON) end end end
	local footc=nil
	local function legs(n,lx,lz,y,w,len,c) local i=0 for _,zz in lz do for _,xx in lx do i+=1
		local lg=J("Leg"..i,w,len,w,xx,y,zz,0,len/2,0,c or dark)
		if footc then local ft=mk(m,"Foot",Vector3.new(w*1.2*s,.16*s,w*1.5*s),footc) weld(lg,ft,CFrame.new(0,(-len/2+.08)*s,-.06*s)) end
	end end end
	local function wings(w,l,px,py,pz,c,mat) for _,sx in {-1,1} do local p=J(sx<0 and "WingL" or "WingR",w,.07,l,px*sx,py,pz,-sx*w/2,0,0,c,mat) p:SetAttribute("S",sx) end end
	local H=1
	if ty=="quad" then
		body.Size=Vector3.new(.9*s,.8*s,1.8*s) H=1
		A("Chest",1,.95,.9,0,.05,-.55) A("Rump",1,.9,.9,0,.04,.55) A("Belly",.8,.22,1.8,0,-.4,0,light) A("Back",.7,.12,1.7,0,.44,0,dark)
		local tall=N:find("Rabbit") or N:find("Fox")
		beginHead(0,.4,-1.05,.9,.82,.82,0,.5,-.75,col)
		A("Snout",.54,.36,.5,0,.26,-1.5,light) A("Nose",.2,.14,.12,0,.36,-1.78,BLACK)
		eyes(.52,-1.46,.24,.16)
		for sx=-1,1,2 do
			if N:find("Elephant") then A("Ear",.1,.9,.8,.6*sx,.5,-.9,light) A("Tusk",.1,.1,.6,.2*sx,.05,-1.8,WHITE)
			else A("Ear",.16,tall and .65 or ((N:find("Wolf") or N:find("Coyote") or N:find("Leopard") or N:find("Tiger") or N:find("Bear")) and .3 or .28),.16,.24*sx,tall and .95 or .85,-1,N:find("Bear") and col or dark) end
			if N:find("Boar") then A("Tusk",.08,.25,.08,.2*sx,.2,-1.55,WHITE) end
			if N:find("Anubis") or N:find("Pharaoh") or N:find("Sphinx") then A("Gold",.22,.6,.12,.25*sx,1.1,-1,Color3.fromRGB(255,210,60),NEON) end
		end
		if N:find("Deer") or N:find("Stag") then
			local c=N:find("Stag") and Color3.fromRGB(120,255,160) or Color3.fromRGB(150,100,50) local m2=N:find("Stag") and NEON or nil
			for sx=-1,1,2 do A("Antler",.1,.8,.1,.2*sx,1.2,-1,c,m2,nil,R(0,0,-.3*sx)) A("Tine",.08,.4,.08,.35*sx,1.5,-1,c,m2,nil,R(0,0,.4*sx)) A("Tine",.08,.4,.08,.25*sx,1.45,-.8,c,m2) end
		end
		if N:find("Fox") then for sx=-1,1,2 do A("Cheek",.25,.25,.3,.28*sx,.25,-1.3,WHITE,nil,BALL) end end
		if N:find("Bear") or N:find("Boar") then A("Muzzle",.4,.3,.3,0,.2,-1.55,light,nil,BALL) end
		if N:find("Elephant") then for i=1,3 do A("Trunk",.3,.3,.4,0,.2-i*.18,-1.6-i*.12,col) end end
		if N:find("Camel") then A("Neck",.3,.7,.3,0,.7,-.95,col,nil,nil,R(.5)) end
		endHead()
