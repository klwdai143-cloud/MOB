		for _,sx in {-1,1} do J("Arm"..(sx<0 and 1 or 2),.2,.2,.9,.4*sx,0,-.6,0,0,.45,col) A("Claw",.5,.2,.35,.55*sx,0,-1.4,dark) end
		for i,y in {.2,.5,.8} do A("Tail",.3,.3,.5,0,y+.1,.7+(i==3 and -.2 or 0)-i*.05,dark,nil,BALL) end
		A("Sting",.15,.15,.4,0,1.15,.2,Color3.fromRGB(255,60,60),NEON)
