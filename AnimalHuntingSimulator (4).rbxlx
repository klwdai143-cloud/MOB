			arow("Unfreeze",nil,"Release",function() A_("unfreeze","") end,RGB(90,150,220))
			arow("Kill",nil,"Kill",function() A_("kill","") end,RED)
			arow("Kick","reason","Kick",function(t) A_("kick",t) end,RED)
			arow("Wipe data",nil,"WIPE",function() A_("wipe","") end,RED)
		else
			arow("Announcement","message","Send",function(t) Act:FireServer("Admin","announce",t) end,GOLD)
			for _,e in ipairs({{"golden","Golden Hour"},{"lucky","Lucky Rain"},{"blood","Blood Moon"},{"meteor","Meteor Shower"},{"rainbow","Rainbow Blessing"}}) do
				arow("Event: "..e[2],nil,"Start",function() Act:FireServer("Admin","event",e[1]) end,PURP)
			end
			arow("End current event",nil,"End",function() Act:FireServer("Admin","endevent","") end,RED)
			arow("Time of day","0 - 24","Set",function(t) Act:FireServer("Admin","time",t) end,BLUE)
			arow("Rare luck x","1 - 50","Set",function(t) Act:FireServer("Admin","luck",t) end,GREEN)
			arow("Spawn animal here","exact name","Spawn",function(t) Act:FireServer("Admin","spawn",t) end,GREEN)
			arow("Remove all animals",nil,"Clear",function() Act:FireServer("Admin","clear","") end,RED)
			arow("Kick everyone else",nil,"Kick all",function() Act:FireServer("Admin","kickall","") end,RED)
