	local g=workspace:FindFirstChild("Gates")
	if g and S then for _,m in g:GetChildren() do
		local b=m:FindFirstChild("Barrier") local z=Cfg.Zones[m:GetAttribute("Zone")]
		if b and z and S.Zones[z.Name] then b.CanCollide=false b.Transparency=1 local pr=b:FindFirstChild("Prompt") if pr then pr.Enabled=false end end
	end end
	local pf=workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Portals")
	if pf and S then for _,pm in ipairs(pf:GetChildren()) do local zi=pm:GetAttribute("Zone") local z=Cfg.Zones[zi] local tr=pm:FindFirstChild("Portal") if z and tr and S.Zones[z.Name] then local pr=tr:FindFirstChildOfClass("ProximityPrompt") if pr then pr.Enabled=false end end end end
	if cur=="rw" or cur=="shop" then if S then Rf[cur]() end end
end end)
-- lava glow
local function lava(p) TS:Create(p,TweenInfo.new(1.2+math.random(),Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),{Color=RGB(255,60,10)}):Play() end
for _,p in CS:GetTagged("Lava") do lava(p) end CS:GetInstanceAddedSignal("Lava"):Connect(lava)
-- animal animation (head look, grazing, walk cycle, breathing, tail wag, wing flaps)
local anims={}
local function deathAnim(m)
	local b=m.PrimaryPart if not b then return end
	anims[m]=nil
	local inf=b:FindFirstChild("Info") if inf then inf:Destroy() end
	local start=b.CFrame local t0=os.clock()
	task.spawn(function()
		while m.Parent and os.clock()-t0<1.3 do
			local k=(os.clock()-t0)/1.3
			b.CFrame=start*CFrame.new(0,k*5,0)*CFrame.Angles(0,k*10,k*1.4)
			for _,p in ipairs(m:GetChildren()) do if p:IsA("BasePart") then p.Transparency=k end end
			task.wait()
		end
	end)
end
local function reg(m)
	local js={}
	task.wait(.2)
	for _,p in ipairs(m:GetChildren()) do
		local w=p:IsA("BasePart") and p:FindFirstChild("W")
		if w then
			local n=p.Name local num=tonumber(n:match("%d+$")) or 0 local kind,idx
			if n:match("^Leg") then kind,idx="leg",num elseif n:match("^Arm") then kind,idx="arm",num
			elseif n:match("^Wing") then kind,idx="wing",p:GetAttribute("S") or 1
			elseif n=="Tail" then kind,idx="tail",0 elseif n:match("^Seg") then kind,idx="seg",num
			elseif n=="Head" then kind,idx="head",0
			elseif n=="Chest" or n=="Rump" or n=="Belly" or n=="Shoulder" or n=="Hump" or n=="Mantle" then kind,idx="bob",0 end
			if kind then table.insert(js,{w=w,c0=w.C0,k=kind,i=idx}) end
		end
	end
	anims[m]={js=js,ph=math.random()*6,yaw=0,flinch=-9}
	m:GetAttributeChangedSignal("Dead"):Connect(function() deathAnim(m) end)
	m:GetAttributeChangedSignal("Hit"):Connect(function()
		if anims[m] then anims[m].flinch=os.clock() end
		local h=N("Highlight",{FillColor=WHITE,FillTransparency=.3,OutlineTransparency=1},m) Debris:AddItem(h,.15)
	end)
end
task.spawn(function()
	local f=workspace:WaitForChild("Animals")
	for _,m in ipairs(f:GetChildren()) do task.spawn(reg,m) end
	f.ChildAdded:Connect(function(m) task.spawn(reg,m) end) f.ChildRemoved:Connect(function(m) anims[m]=nil end)
end)
local ringC,baseGrip={}, {}
local lastGripT=0
RunS.RenderStepped:Connect(function(dt)
	local cam=workspace.CurrentCamera local t=os.clock()
	local myc=lp.Character local myr=myc and myc:FindFirstChild("HumanoidRootPart")
	for m,a in pairs(anims) do
		local b=m.PrimaryPart
		if b and (b.Position-cam.CFrame.Position).Magnitude<170 then
			local st=m:GetAttribute("State") local fly=m:GetAttribute("Fly") local sc=m:GetAttribute("Sc") or 1
			local walking=st=="Walk" local graze=st=="Graze" local alert=st=="Alert"
			local ph=t*(walking and 6.5 or 0)+a.ph
			local fl=math.max(0,1-(t-a.flinch)*3)
			local want=0
			if alert and myr then local rel=b.CFrame:PointToObjectSpace(myr.Position) want=math.max(-.9,math.min(.9,-math.atan2(rel.X,-rel.Z))) end
			a.yaw=a.yaw+(want-a.yaw)*.12
			for _,j in ipairs(a.js) do
				if j.w.Parent then
					local k=j.k
					if k=="leg" or k=="arm" then
						local ang=0
						if walking then ang=math.sin(ph+(((j.i%2==0)~=(k=="arm")) and math.pi or 0))*.6
						elseif alert and j.i<=2 then ang=-.15 else ang=math.sin(t*1.1+a.ph+j.i)*.02 end
						j.w.C0=j.c0*CFrame.Angles(ang,0,0)
					elseif k=="head" then
						local pitch=math.sin(t*1.2+a.ph)*.04
						if walking then pitch=math.sin(ph*2)*.07 elseif graze then pitch=-.6+math.sin(t*2.5+a.ph)*.1 end
						pitch=pitch+fl*.5
						j.w.C0=j.c0*CFrame.Angles(pitch,a.yaw,0)
					elseif k=="bob" then
						j.w.C0=j.c0*CFrame.new(0,(math.sin(ph*2)*.04*(walking and 1 or 0)+math.sin(t*1.5+a.ph)*.018)*sc,0)
					elseif k=="wing" then
						local ff=walking and 9 or (fly and 5 or 0)
						j.w.C0=j.c0*CFrame.Angles(0,0,ff>0 and math.sin(t*ff+a.ph)*.8*j.i or 0)
					elseif k=="tail" then
						j.w.C0=j.c0*CFrame.Angles(math.sin(t*3+a.ph)*.06,math.sin(t*(walking and 6 or 2.5)+a.ph)*.45,0)
					else
						j.w.C0=j.c0*CFrame.new(b.Size.X*(j.i/7)*.7*math.sin(t*(walking and 5 or 1.8)-j.i*.8+a.ph),0,0)
					end
				end
			end
		end
	end
	if tool then
		for _,p in ipairs(tool:GetDescendants()) do
			local sp=p:IsA("BasePart") and p:GetAttribute("Spin")
			if sp then local w=p:FindFirstChild("W") if w then ringC[w]=ringC[w] or w.C0 w.C0=ringC[w]*CFrame.Angles(t*sp*2,0,0) end end
		end
		-- weapon feel: recoil kick, reload tilt, walking sway, equip raise
		local g=baseGrip[tool] if not g then g=tool.Grip baseGrip[tool]={g=tool.Grip,t0=t} g=baseGrip[tool] end
		recoil=math.max(0,recoil-dt*7)
		local rl=0 if reloading then local pr=math.min(1,(t-reloadT0)/math.max(.1,reloadDur)) rl=math.sin(pr*math.pi) end
		local hum=myc and myc:FindFirstChildOfClass("Humanoid")
		local moving=hum and hum.MoveDirection.Magnitude>.1
		local sway=moving and math.sin(t*9)*.05 or math.sin(t*1.4)*.015
		local eq=math.max(0,1-(t-g.t0)*4)
		tool.Grip=g.g*CFrame.new(sway*.5,sway-rl*.25-eq*.6,recoil*.45)*CFrame.Angles(recoil*.35+rl*.9+eq*1.1,0,rl*.25)
	end
end)
]]></ProtectedString></Properties></Item></Item></Item><Item class="Players" referent="RBX17"><Properties><string name="Name">Players</string></Properties></Item><Item class="SoundService" referent="RBX18"><Properties><string name="Name">SoundService</string></Properties></Item></roblox>