      <Item class="LocalScript" referent="RBX648">
        <Properties>
          <string name="Name">HUDClient</string>
          <ProtectedString name="Source">
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local player=Players.LocalPlayer
local notify=ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Notify")
notify.OnClientEvent:Connect(function(message)
    local gui=player:WaitForChild("PlayerGui"):FindFirstChild("AnimalHuntingHUD")
    if not gui then return end
    local label=Instance.new("TextLabel")
    label.Size=UDim2.fromScale(0.42,0.07); label.Position=UDim2.fromScale(0.29,0.18)
    label.BackgroundColor3=Color3.fromRGB(20,35,65); label.TextColor3=Color3.new(1,1,1)
    label.TextScaled=true; label.Text=message; label.Parent=gui
    task.delay(2.5,function() if label then label:Destroy() end end)
end)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
