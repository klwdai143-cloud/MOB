  <Item class="ServerScriptService" referent="RBX634">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX635">
      <Properties>
        <string name="Name">GameServer</string>
        <ProtectedString name="Source">
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local capture = remotes:WaitForChild("CaptureAnimal")
local notify = remotes:WaitForChild("Notify")
local function setup(player)
    local stats = Instance.new("Folder"); stats.Name="leaderstats"; stats.Parent=player
    local coins=Instance.new("IntValue"); coins.Name="Coins"; coins.Value=250; coins.Parent=stats
    local gems=Instance.new("IntValue"); gems.Name="Gems"; gems.Value=25; gems.Parent=player
    local inventory=Instance.new("Folder"); inventory.Name="AnimalCollection"; inventory.Parent=player
end
Players.PlayerAdded:Connect(setup)
capture.OnServerEvent:Connect(function(player, animalName)
    if typeof(animalName) ~= "string" or #animalName &gt; 40 then return end
    local folder=player:FindFirstChild("AnimalCollection")
    if not folder then return end
    local v=Instance.new("StringValue"); v.Name="Animal"; v.Value=animalName; v.Parent=folder
    local stats=player:FindFirstChild("leaderstats")
    if stats and stats:FindFirstChild("Coins") then stats.Coins.Value += 25 end
    notify:FireClient(player,"Captured: "..animalName.."  +25 Coins")
end)
</ProtectedString>
      </Properties>
    </Item>
  </Item>
