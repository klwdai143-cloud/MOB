newPanel("settings", "Settings", "⚙️", 360, 290, H"8AA0D0", {"settings"}, function(body)
	local opts = {{"music", "Music"}, {"sfx", "SFX"}, {"auto", "Auto Shoot"}, {"low", "Low Graphics"}}
	for i, o in ipairs(opts) do
		local y = (i - 1) * 54
		local row = new("Frame", {Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, y), BackgroundColor3 = Color3.fromRGB(26, 32, 76)}, body); corner(row, 10)
		txt(row, {Size = UDim2.new(1, -90, 1, 0), Position = UDim2.fromOffset(14, 0), Text = o[2], TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left})
		local on = D.settings[o[1]]
		local sw = new("TextButton", {Text = "", Size = UDim2.fromOffset(64, 30), Position = UDim2.new(1, -76, 0.5, -15), BackgroundColor3 = on and H"2FBF3A" or Color3.fromRGB(80, 84, 110), AutoButtonColor = false}, row); corner(sw, 15)
		local knob = new("Frame", {Size = UDim2.fromOffset(24, 24), Position = on and UDim2.new(1, -28, 0.5, -12) or UDim2.new(0, 4, 0.5, -12), BackgroundColor3 = Color3.new(1, 1, 1)}, sw); corner(knob, 12)
		sw.Activated:Connect(function() play("click", 0.4, 1.2); act("Setting", o[1], not D.settings[o[1]]) end)
	end
end)

-- ===== Daily rewards =====
local rewardUI = {}
newPanel("rewards", "Daily Rewards", "🎁", 560, 300, H"FFB020", {"daily"}, function(body)
	local streak, last = D.daily.streak, D.daily.last
	local ready = nowT() - last >= 86400
	if nowT() - last >= 172800 then streak = 0 end
	local idx = streak % 7
	for i, r in ipairs(Config.Daily) do
		local c = new("Frame", {Size = UDim2.fromOffset(72, 130), Position = UDim2.fromOffset((i - 1) * 77, 4), BackgroundColor3 = (i == idx + 1 and ready) and H"3A6A2A" or Color3.fromRGB(34, 42, 96)}, body); corner(c, 10)
		stroke(c, (i == idx + 1 and ready) and H"7CFF8A" or Color3.fromRGB(70, 90, 170), 2.5)
		txt(c, {Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 4), Text = "Day " .. i, TextSize = 16})
		local s = ""
		if r.coins then s = s .. "🪙\n" .. fmt(r.coins) .. "\n" end
		if r.gems then s = s .. "💎\n" .. fmt(r.gems) end
		txt(c, {Size = UDim2.new(1, 0, 0, 84), Position = UDim2.fromOffset(0, 28), Text = s, TextSize = 15})
		if i <= idx and not ready or (i <= idx and ready) then
			local ov = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, ZIndex = 5}, c); corner(ov, 10)
			txt(ov, {Size = UDim2.fromScale(1, 1), Text = "✔", TextSize = 36, TextColor3 = H"7CFF8A", ZIndex = 6})
		end
	end
	rewardUI.timer = btn(body, "", ready and H"2FBF3A" or H"4A5078", UDim2.new(1, -20, 0, 52), UDim2.fromOffset(10, 150), function() act("ClaimDaily") end, 22)
	rewardUI.ready = ready
end)
local function updateRewardTimer()
	if rewardUI.timer and rewardUI.timer.Parent and D then
		local left = D.daily.last + 86400 - nowT()
		if left <= 0 then rewardUI.timer.Text = "Claim Reward!" else
			rewardUI.timer.Text = string.format("Next Reward: %02d:%02d:%02d", math.floor(left / 3600), math.floor(left % 3600 / 60), left % 60)
		end
	end
end

