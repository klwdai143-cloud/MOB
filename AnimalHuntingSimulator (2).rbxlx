Molten Boar|Volcano|Rare|quad|1.2|3A2A26|7A3A22|FF6A1E|bulky,shortleg,tusks,glowcracks
Rock Golem|Volcano|Rare|biped|2.0|6A5A52|3A302C|FF7A1E|golem,rock,glowcracks
Raptor|Volcano|Epic|quad|1.4|D84A1E|FF9A3A|FFD060|longleg,slim,longtail,horns
Fire Tiger|Volcano|Epic|quad|1.6|FF6A1E|FFD060|2A1410|ears,stripes,longtail,flame
Magma Dragon|Volcano|Legendary|quad|2.4|5A2A22|FF6A1E|FFB030|wings,horns,spikes,longtail,glowcracks
Phoenix|Volcano|Mythic|bird|2.2|FF7A1E|FFD060|FF3A1E|phoenix,flame
Inferno Golem|Volcano|Mythic|biped|3.2|3A2A26|FF5A1E|FFA030|golem,rock,glowcracks
Volcanic Titan|Volcano|Divine|biped|4.0|2E2220|FF4A1E|FFC030|titan,rock,glowcracks
]]

C.Animals = {}
C.AnimalByName = {}
C.ZoneAnimals = {Forest = {}, Desert = {}, Snow = {}, Volcano = {}}
do
	local perRarity = {}
	for line in ANIMALS:gmatch("[^\r\n]+") do
		local f = {}
		for part in (line .. "|"):gmatch("([^|]*)|") do f[#f + 1] = part end
		local feats = {}
		for ft in (f[9] or ""):gmatch("[^,]+") do feats[ft] = true end
		local r = C.RIndex[f[3]]
		perRarity[r] = (perRarity[r] or 0) + 1
		local a = {name = f[1], zone = f[2], rarity = f[3], r = r, kind = f[4], s = tonumber(f[5]), c1 = H(f[6]), c2 = H(f[7]), c3 = H(f[8]), feats = feats}
		a.income = math.floor(C.Income[r] * (1 + 0.12 * (perRarity[r] - 1)) * 10) / 10
		a.hp = C.HP[r]
		a.weight = C.Weight[r]
		C.Animals[#C.Animals + 1] = a
		C.AnimalByName[a.name] = a
		table.insert(C.ZoneAnimals[a.zone], a)
	end
end

C.Weapons = {
	{name="Pistol",         rarity="Common",    kind="pistol",  dmg=8,    rate=2.5, mag=12, reload=1.2, range=120, pellets=1, cost=0,        cur="coins"},
	{name="Revolver",       rarity="Uncommon",  kind="revolver",dmg=16,   rate=3,   mag=6,  reload=1.8, range=120, pellets=1, cost=1500,     cur="coins"},
	{name="Hunter Shotgun", rarity="Rare",      kind="shotgun", dmg=14,   rate=1.5, mag=8,  reload=2.2, range=100, pellets=5, spread=4, cost=15000, cur="coins"},
	{name="Assault Rifle",  rarity="Epic",      kind="rifle",   dmg=70,   rate=5,   mag=30, reload=1.8, range=170, pellets=1, cost=150000,  cur="coins"},
	{name="Golden Rifle",   rarity="Legendary", kind="rifle",   dmg=150,  rate=6,   mag=30, reload=1.7, range=180, pellets=1, cost=1500000, cur="coins"},
	{name="Inferno Rifle",  rarity="Mythic",    kind="rifle",   dmg=320,  rate=6.5, mag=35, reload=1.6, range=190, pellets=1, cost=15000000,cur="coins"},
	{name="Crystal Rifle",  rarity="Exotic",    kind="rifle",   dmg=700,  rate=7,   mag=40, reload=1.5, range=200, pellets=1, cost=300,     cur="gems"},
	{name="Void Rifle",     rarity="Secret",    kind="rifle",   dmg=1500, rate=8,   mag=45, reload=1.4, range=210, pellets=1, cost=1000,    cur="gems"},
	{name="Starlight Rifle",rarity="Celestial", kind="rifle",   dmg=3200, rate=9,   mag=50, reload=1.3, range=220, pellets=1, cost=3000,    cur="gems"},
	{name="Angel Rifle",    rarity="Divine",    kind="rifle",   dmg=7000, rate=10,  mag=60, reload=1.2, range=240, pellets=1, cost=10000,   cur="gems"},
}
C.WeaponByName = {}
for i, w in ipairs(C.Weapons) do w.tier = i; w.r = C.RIndex[w.rarity]; C.WeaponByName[w.name] = w end

C.Upgrades = {
	{id="damage", name="Damage",          icon="💪", per=0.04,  unit="% Damage",   base=100, mult=1.45, max=50},
	{id="rate",   name="Fire Rate",       icon="⚡", per=0.02,  unit="% Fire Rate",base=150, mult=1.50, max=50},
	{id="ammo",   name="Ammo Capacity",   icon="🧰", per=0.03,  unit="% Ammo",     base=120, mult=1.45, max=50},
	{id="reload", name="Reload Speed",    icon="🔄", per=0.015, unit="% Reload",   base=140, mult=1.50, max=40},
	{id="range",  name="Range",           icon="🎯", per=0.02,  unit="% Range",    base=130, mult=1.45, max=50},
	{id="crit",   name="Critical Chance", icon="💥", per=0.005, unit="% Crit",     base=200, mult=1.55, max=40},
	{id="speed",  name="Movement Speed",  icon="👟", per=0.4,   unit=" Speed",     base=110, mult=1.50, max=30},
}
C.UpgradeById = {}
for _, u in ipairs(C.Upgrades) do C.UpgradeById[u.id] = u end
function C.UpgradeCost(u, lvl) return math.floor(u.base * u.mult ^ lvl) end

C.Zones = {
	{name="Forest",  center=Vector3.new(-300,0,-250), price=0,      color=H"2EE05A", icon="🌲", req="Lv. 1+"},
	{name="Desert",  center=Vector3.new(-340,0,60),   price=5000,   color=H"FFB020", icon="🌵", req="Lv. 50+"},
	{name="Snow",    center=Vector3.new(300,0,-250),  price=50000,  color=H"3AB8FF", icon="❄️", req="Lv. 100+"},
	{name="Volcano", center=Vector3.new(340,0,60),    price=500000, color=H"FF4A1E", icon="🌋", req="Lv. 200+"},
}
C.ZoneByName = {}
for _, z in ipairs(C.Zones) do
	z.dir = (Vector3.new(0, 0, 0) - z.center) * Vector3.new(1, 0, 1)
	z.dir = z.dir.Unit
	z.gate = z.center + z.dir * 188
	z.inside = z.center + z.dir * 60
	C.ZoneByName[z.name] = z
end
C.ZoneRadius = 150
C.PlayRadius = 92

C.Plots = {}
for i = 1, 6 do
	C.Plots[i] = {center = Vector3.new(-275 + (i - 1) * 110, 0, 300), color = ({H"3A7BFF", H"FF3A4A", H"34C759", H"B050F0", H"FF9A1E", H"12C8C8"})[i]}
end
C.MaxSlots = 12
function C.SlotCost(n) return math.floor(2500 * 3 ^ (n - 5)) end -- slot n (5..12)

C.CoinPacks = {{coins=50000, gems=50}, {coins=500000, gems=450}, {coins=5000000, gems=4000}}
C.GemPacks  = {{gems=250, robux=149, product=0}, {gems=1000, robux=499, product=0}, {gems=5000, robux=1999, product=0}} -- put real DevProduct IDs in "product"
C.Boosts = {
	{id="coins2", name="2x Coins", desc="10 minutes", gems=50,  dur=600, mult=2},
	{id="coins3", name="3x Coins", desc="10 minutes", gems=120, dur=600, mult=3},
}
C.Special = {
	{id="slot", name="+1 Base Slot", desc="Unlock a base slot", gems=150},
	{id="cash", name="Cash Drop", desc="10 min of income", gems=40},
}
C.Daily = {{coins=1000}, {gems=25}, {coins=5000}, {gems=60}, {coins=25000}, {gems=120}, {coins=100000, gems=250}}

C.Quests = {
	{id="hunt",    text="Hunt %s animals",              base=10,    mult=1.6, rc=500,   rg=10, max=99},
	{id="place",   text="Place %s animals in your base",base=5,     mult=1.5, rc=800,   rg=10, max=99},
	{id="weapon",  text="Get a new weapon",             base=1,     mult=1,   rc=2500,  rg=25, max=9},
	{id="earn",    text="Collect %s coins",             base=5000,  mult=3,   rc=2000,  rg=15, max=99},
	{id="zone",    text="Unlock a new zone",            base=1,     mult=1,   rc=10000, rg=50, max=3},
	{id="upgrade", text="Upgrade your weapon %s times", base=5,     mult=1.5, rc=1000,  rg=10, max=99},
}
C.QuestById = {}
for _, q in ipairs(C.Quests) do C.QuestById[q.id] = q end
function C.QuestTarget(q, t) return math.floor(q.base * q.mult ^ (t - 1)) end
function C.QuestReward(q, t) return math.floor(q.rc * 1.5 ^ (t - 1)), math.floor(q.rg * (1 + 0.2 * (t - 1))) end

function C.Stats(w, upg)
	upg = upg or {}
	local function u(id) return upg[id] or 0 end
	return {
		dmg = w.dmg * (1 + 0.04 * u("damage")), rate = w.rate * (1 + 0.02 * u("rate")), mag = math.floor(w.mag * (1 + 0.03 * u("ammo"))),
		reload = w.reload * math.max(0.3, 1 - 0.015 * u("reload")), range = w.range * (1 + 0.02 * u("range")),
		crit = 0.05 + 0.005 * u("crit"), pellets = w.pellets, spread = w.spread or 0, speed = 16 + 0.4 * u("speed"),
	}
end
function C.RebirthCost(n) return math.floor(250000 * 4 ^ n) end
function C.Fmt(n)
	n = n or 0
	local s = {{1e15,"Qa"},{1e12,"T"},{1e9,"B"},{1e6,"M"},{1e3,"K"}}
	for _, p in ipairs(s) do
		if n >= p[1] then
			local v = n / p[1]
			local str = (v >= 100 and string.format("%.0f", v)) or (v >= 10 and string.format("%.1f", v)) or string.format("%.2f", v)
			str = str:gsub("(%..-)0+$", "%1"):gsub("%.$", "")
			return str .. p[2]
		end
	end
	return tostring(math.floor(n))
end
return C
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">AnimalBuilder</string><ProtectedString name="Source"><![CDATA[-- Procedural animal models built only from Parts (Motor6D rigs animated on the client)
local B = {}
local SP = Enum.Material.SmoothPlastic

local function mk(model, name, size, color, mat)
	local p = Instance.new("Part")
	p.Name = name; p.Size = size; p.Color = color; p.Material = mat or SP
	p.Anchored = false; p.CanCollide = false; p.CanTouch = false; p.Massless = true; p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function round(p)
	local m = Instance.new("SpecialMesh"); m.MeshType = Enum.MeshType.Sphere; m.Parent = p
end

function B.build(spec)
	local s, c1, c2, c3, f = spec.s, spec.c1, spec.c2, spec.c3, spec.feats
	local model = Instance.new("Model"); model.Name = spec.name
	local J = {}
	local root = mk(model, "Root", Vector3.new(0.4, 0.4, 0.4), c1); root.Transparency = 1; root.CanQuery = false
	model.PrimaryPart = root
	local bodyMat = (f.ice and Enum.Material.Ice) or (f.rock and Enum.Material.Slate) or SP

	local function motor(p0, p1, name, c0, c1_, role, ph, extra)
		local m = Instance.new("Motor6D"); m.Name = name; m.Part0 = p0; m.Part1 = p1
		m.C0 = c0 or CFrame.new(); m.C1 = c1_ or CFrame.new()
		m:SetAttribute("Role", role); m:SetAttribute("Ph", ph or 0)
		if extra then for k, v in pairs(extra) do m:SetAttribute(k, v) end end
		m.Parent = p1
		J[#J + 1] = {p0, p1, m.C0, m.C1}
		return m
	end
	local function add(parent, name, size, off, color, mat, rot)
		local p = mk(model, name, size, color, mat)
		local w = Instance.new("Weld"); w.Part0 = parent; w.Part1 = p
		w.C0 = CFrame.new(off) * (rot or CFrame.new()); w.Parent = p
		J[#J + 1] = {parent, p, w.C0, CFrame.new()}
		return p
	end
	local function eyes(head, hs, z, col)
		for _, sx in ipairs({-1, 1}) do
			local e = add(head, "Eye", Vector3.new(hs * 0.16, hs * 0.16, hs * 0.1), Vector3.new(sx * hs * 0.27, hs * 0.12, z), col or Color3.new(0.05, 0.05, 0.08))
			if spec.feats.glowcracks or spec.feats.flame then e.Material = Enum.Material.Neon; e.Color = c3 end
		end
	end
	local top, hip

	local kind = spec.kind
	if kind == "quad" then
		local bl, bh, bw = 2.6 * s, 1.5 * s, 1.5 * s
		if f.slim then bw = 1.0 * s; bh = 1.25 * s end
		if f.bulky then bw = 2.0 * s; bh = 2.0 * s end
		local L = 1.3 * s
		if f.shortleg then L = 0.7 * s end
		if f.longleg then L = 1.9 * s end
		local body = mk(model, "Body", Vector3.new(bw, bh, bl), c1, bodyMat)
		if f.round then round(body) end
		motor(root, body, "Body", nil, nil, "body", 0)
		add(body, "Belly", Vector3.new(bw * 0.92, bh * 0.4, bl * 0.8), Vector3.new(0, -bh * 0.33, 0), c2, bodyMat)
		local lx, lz, lw = bw * 0.32, bl * 0.34, math.max(bw * 0.28, 0.35 * s)
		local pos = {{-lx, -lz, 0}, {lx, -lz, math.pi}, {-lx, lz, math.pi}, {lx, lz, 0}}
		for i, p in ipairs(pos) do
			local leg = mk(model, "Leg" .. i, Vector3.new(lw, L, lw), f.darklegs and c3 or c2, bodyMat)
			motor(body, leg, "Leg" .. i, CFrame.new(p[1], -bh / 2 + 0.05 * s, p[2]), CFrame.new(0, L / 2, 0), "leg", p[3])
			add(leg, "Paw", Vector3.new(lw * 1.1, L * 0.2, lw * 1.2), Vector3.new(0, -L / 2 + L * 0.1, -lw * 0.05), c3)
		end
		local hs = bh * 0.85
		local head = mk(model, "Head", Vector3.new(hs * 0.95, hs, hs), c1, bodyMat)
		if f.round then round(head) end
		motor(body, head, "Head", CFrame.new(0, bh * 0.25, -bl / 2 + 0.1 * s), CFrame.new(0, 0, hs * 0.4), "head", 0)
		add(head, "Snout", Vector3.new(hs * 0.52, hs * 0.4, hs * 0.55), Vector3.new(0, -hs * 0.18, -hs * 0.6), c2, bodyMat)
		add(head, "Nose", Vector3.new(hs * 0.18, hs * 0.14, hs * 0.1), Vector3.new(0, -hs * 0.05, -hs * 0.9), Color3.new(0.08, 0.06, 0.08))
		eyes(head, hs, -hs * 0.5)
		if f.ears or f.bigears or f.longears then
			local ew, eh = hs * 0.26, hs * 0.38
			if f.longears then ew, eh = hs * 0.2, hs * 1.0 end
			if f.bigears then ew, eh = hs * 0.6, hs * 0.6 end
			for _, sx in ipairs({-1, 1}) do
				add(head, "Ear", Vector3.new(ew, eh, hs * 0.14), Vector3.new(sx * hs * 0.32, hs * 0.5 + eh * 0.4, hs * 0.1), f.longears and c1 or c1, bodyMat, CFrame.Angles(0, 0, sx * -0.15))
			end
		end
		if f.antlers then
			for _, sx in ipairs({-1, 1}) do
				local col = spec.c3
				add(head, "Antler", Vector3.new(0.14 * s, 1.5 * s, 0.14 * s), Vector3.new(sx * hs * 0.3, hs * 0.5 + 0.7 * s, 0), col, nil, CFrame.Angles(0, 0, sx * -0.35))
				add(head, "Tine", Vector3.new(0.12 * s, 0.7 * s, 0.12 * s), Vector3.new(sx * hs * 0.65, hs * 0.5 + 0.9 * s, -0.1 * s), col, nil, CFrame.Angles(0.5, 0, sx * -0.2))
				add(head, "Tine", Vector3.new(0.12 * s, 0.6 * s, 0.12 * s), Vector3.new(sx * hs * 0.5, hs * 0.5 + 0.5 * s, 0.15 * s), col, nil, CFrame.Angles(-0.5, 0, sx * -0.2))
			end
		end
		if f.horns then
			for _, sx in ipairs({-1, 1}) do
				add(head, "Horn", Vector3.new(0.2 * s, 0.9 * s, 0.2 * s), Vector3.new(sx * hs * 0.32, hs * 0.55 + 0.3 * s, hs * 0.1), c3, nil, CFrame.Angles(-0.5, 0, sx * -0.3))
			end
		end
		if f.tusks then
			for _, sx in ipairs({-1, 1}) do add(head, "Tusk", Vector3.new(0.15 * s, 0.15 * s, 0.7 * s), Vector3.new(sx * hs * 0.3, -hs * 0.3, -hs * 0.8), Color3.new(1, 1, 0.9), nil, CFrame.Angles(0.4, 0, 0)) end
		end
		if f.trunk then
			add(head, "Trunk", Vector3.new(hs * 0.35, hs * 0.35, hs * 1.4), Vector3.new(0, -hs * 0.55, -hs * 0.9), c1, bodyMat, CFrame.Angles(-0.45, 0, 0))
			for _, sx in ipairs({-1, 1}) do add(head, "Tusk", Vector3.new(0.18 * s, 0.18 * s, 0.9 * s), Vector3.new(sx * hs * 0.4, -hs * 0.45, -hs * 0.8), Color3.new(1, 1, 0.92), nil, CFrame.Angles(0.35, 0, 0)) end
		end
		if f.mane then add(head, "Mane", Vector3.new(hs * 1.4, hs * 1.4, hs * 0.6), Vector3.new(0, 0, hs * 0.35), c3) end
		if f.headdress then
			add(head, "Nemes", Vector3.new(hs * 1.35, hs * 1.2, hs * 0.6), Vector3.new(0, -hs * 0.05, hs * 0.3), c3)
			add(head, "Crown", Vector3.new(hs * 0.5, hs * 0.35, hs * 0.5), Vector3.new(0, hs * 0.65, 0), c3, Enum.Material.Neon)
		end
		if f.anubis then
			add(body, "Collar", Vector3.new(bw * 1.05, bh * 0.35, bl * 0.18), Vector3.new(0, bh * 0.3, -bl * 0.42), c3, Enum.Material.Neon)
		end
		if f.humps then
			for _, zz in ipairs({-0.2, 0.2}) do add(body, "Hump", Vector3.new(bw * 0.7, bh * 0.7, bl * 0.25), Vector3.new(0, bh * 0.6, zz * bl), c1) end
		end
		if f.stripes then
			for i = 1, 4 do add(body, "Stripe", Vector3.new(bw + 0.04 * s, bh * 0.8, 0.14 * s), Vector3.new(0, 0.05 * s, -bl * 0.35 + i * bl * 0.15), c3) end
		end
		if f.spots then
			for i = 1, 6 do add(body, "Spot", Vector3.new(0.3 * s, 0.1 * s, 0.3 * s), Vector3.new(((i % 3) - 1) * bw * 0.28, bh / 2, -bl * 0.35 + i * bl * 0.12), c3) end
		end
		if f.spikes then
			for i = 1, 5 do add(body, "Spike", Vector3.new(0.3 * s, 0.55 * s, 0.3 * s), Vector3.new(0, bh / 2 + 0.2 * s, -bl * 0.35 + i * bl * 0.15), c3, Enum.Material.Neon) end
		end
		if f.glowcracks then
			for i = 1, 4 do add(body, "Crack", Vector3.new(bw * 0.5, 0.08 * s, 0.14 * s), Vector3.new(((i % 2) - 0.5) * bw * 0.3, bh / 2 + 0.02, -bl * 0.3 + i * bl * 0.15), c3, Enum.Material.Neon) end
			local l = Instance.new("PointLight"); l.Color = c3; l.Range = 8 * s; l.Brightness = 1; l.Parent = body
		end
		if f.wings then
			for _, sx in ipairs({-1, 1}) do
				local w = mk(model, sx < 0 and "WingL" or "WingR", Vector3.new(3.0 * s, 0.12 * s, 1.9 * s), c2, f.ice and Enum.Material.Ice or SP)
				motor(body, w, w.Name, CFrame.new(sx * bw / 2, bh * 0.4, -bl * 0.1), CFrame.new(-sx * 1.5 * s, 0, 0), "wing", 0, {Side = sx})
				add(w, "Edge", Vector3.new(3.0 * s, 0.14 * s, 0.25 * s), Vector3.new(0, 0, -0.8 * s), c3)
			end
		end
		-- tail
		local tl = (f.tailshort and 0.5 or (f.longtail and 1.8 or 1.1)) * s
		local tw = (f.foxtail and 0.6 or 0.32) * s
		local tail = mk(model, "Tail", Vector3.new(tw, tw, tl), f.foxtail and c1 or c1, bodyMat)
		motor(body, tail, "Tail", CFrame.new(0, bh * 0.25, bl / 2 - 0.05 * s), CFrame.new(0, 0, -tl / 2), "tail", 0)
		if f.foxtail then
			local tip = add(tail, "TipEnd", Vector3.new(tw * 1.05, tw * 1.05, tl * 0.35), Vector3.new(0, 0, tl * 0.32), c2)
			if f.flame then tip.Color = c3; tip.Material = Enum.Material.Neon end
		elseif f.longtail and (f.stripes or f.spots) then
			add(tail, "TipEnd", Vector3.new(tw * 1.02, tw * 1.02, tl * 0.2), Vector3.new(0, 0, tl * 0.38), c3)
		end
		hip = L + bh / 2 - 0.05 * s
		top = bh / 2 + hs * 0.7 + (f.antlers and 1.2 * s or 0) + (f.horns and 0.6 * s or 0)

	elseif kind == "biped" then
		local ts, ls, as, hs = Vector3.new(1.8 * s, 2.2 * s, 1.1 * s), 1.5 * s, 2.0 * s, 1.1 * s
		local lw = 0.75 * s
		if f.penguin then ts = Vector3.new(1.5 * s, 2.0 * s, 1.2 * s); ls = 0.5 * s; as = 1.0 * s; lw = 0.5 * s end
		if f.gorilla then ts = Vector3.new(2.2 * s, 2.0 * s, 1.5 * s); ls = 1.0 * s; as = 2.6 * s end
		if f.titan or f.golem then ts = Vector3.new(2.4 * s, 2.4 * s, 1.5 * s); lw = 1.0 * s end
		local body = mk(model, "Body", ts, c1, bodyMat)
		motor(root, body, "Body", nil, nil, "body", 0)
		if f.penguin then add(body, "Belly", Vector3.new(ts.X * 0.8, ts.Y * 0.8, 0.1 * s), Vector3.new(0, -0.1 * s, -ts.Z / 2), c2) end
		if f.yeti then add(body, "Fur", Vector3.new(ts.X * 1.05, ts.Y * 0.4, ts.Z * 1.05), Vector3.new(0, -ts.Y * 0.3, 0), c2, bodyMat) end
		if f.golem or f.titan then
			local core = add(body, "Core", Vector3.new(ts.X * 0.4, ts.Y * 0.4, 0.15 * s), Vector3.new(0, 0.2 * s, -ts.Z / 2), c3, Enum.Material.Neon)
			for i = 1, 3 do add(body, "Rock", Vector3.new(0.7 * s, 0.6 * s, 0.7 * s), Vector3.new((i - 2) * ts.X * 0.3, ts.Y / 2 + 0.2 * s, 0.1 * s), c2, bodyMat, CFrame.Angles(0.3 * i, 0.4 * i, 0.2)) end
			if f.glowcracks then local l = Instance.new("PointLight"); l.Color = c3; l.Range = 12 * s; l.Brightness = 1.2; l.Parent = body end
		end
		local lxx = ts.X * 0.25
		for i, sx in ipairs({-1, 1}) do
			local leg = mk(model, "Leg" .. i, Vector3.new(lw, ls, lw), (f.penguin and c3) or (f.yeti and c2) or c1, bodyMat)
			motor(body, leg, "Leg" .. i, CFrame.new(sx * lxx, -ts.Y / 2, 0), CFrame.new(0, ls / 2, 0), "leg", sx < 0 and 0 or math.pi)
			if f.penguin then add(leg, "Foot", Vector3.new(lw * 1.2, 0.15 * s, lw * 1.8), Vector3.new(0, -ls / 2, -0.2 * s), c3) end
		end
		local aw = f.penguin and 0.3 * s or 0.7 * s
		if f.gorilla or f.titan or f.golem then aw = 0.95 * s end
		for i, sx in ipairs({-1, 1}) do
			local arm = mk(model, "Arm" .. i, Vector3.new(aw, as, aw), (f.yeti and c2) or c1, bodyMat)
			motor(body, arm, "Arm" .. i, CFrame.new(sx * (ts.X / 2 + aw / 2), ts.Y * 0.4, 0), CFrame.new(0, as * 0.4, 0), "arm", sx < 0 and math.pi or 0)
			if f.yeti then add(arm, "Hand", Vector3.new(aw * 1.2, aw * 1.2, aw * 1.2), Vector3.new(0, -as * 0.45, 0), c3) end
		end
		local head = mk(model, "Head", Vector3.new(hs, hs, hs), f.penguin and c1 or c1, bodyMat)
		motor(body, head, "Head", CFrame.new(0, ts.Y / 2, 0), CFrame.new(0, -hs * 0.45, 0), "head", 0)
		eyes(head, hs, -hs * 0.5, f.penguin and Color3.new(1, 1, 1) or nil)
		if f.penguin then add(head, "Beak", Vector3.new(hs * 0.4, hs * 0.2, hs * 0.4), Vector3.new(0, -hs * 0.1, -hs * 0.6), c3) end
		if f.yeti then add(head, "Face", Vector3.new(hs * 0.8, hs * 0.55, 0.1 * s), Vector3.new(0, -hs * 0.05, -hs * 0.5), c3) end
		if f.leaves then
			for i = 1, 4 do add(head, "Leaf", Vector3.new(1.5 * s, 1.0 * s, 1.5 * s), Vector3.new(((i % 2) - 0.5) * s, hs * 0.7 + (i % 3) * 0.3 * s, ((math.floor(i / 2)) - 0.5) * s), c2) end
		end
		if f.titan then
			for _, sx in ipairs({-1, 1}) do add(body, "Shoulder", Vector3.new(0.5 * s, 1.2 * s, 0.5 * s), Vector3.new(sx * ts.X * 0.55, ts.Y / 2 + 0.5 * s, 0), c3, Enum.Material.Neon, CFrame.Angles(0, 0, sx * -0.3)) end
		end
		if f.gorilla then add(head, "Brow", Vector3.new(hs * 1.1, hs * 0.2, hs * 0.3), Vector3.new(0, hs * 0.25, -hs * 0.45), c3) end
		hip = ls + ts.Y / 2
		top = ts.Y / 2 + hs + 0.3 * s

	elseif kind == "bird" then
		local bs = Vector3.new(1.2 * s, 1.2 * s, 2.0 * s)
		if f.ostrich then bs = Vector3.new(1.6 * s, 1.7 * s, 2.2 * s) end
		local body = mk(model, "Body", bs, c1, bodyMat); round(body)
		motor(root, body, "Body", nil, nil, "body", 0)
		add(body, "Belly", Vector3.new(bs.X * 0.8, bs.Y * 0.5, bs.Z * 0.7), Vector3.new(0, -bs.Y * 0.25, -0.1 * s), c2, bodyMat)
		local hs = 0.9 * s
		local head = mk(model, "Head", Vector3.new(hs, hs, hs), c1, bodyMat); round(head)
		local neck = f.ostrich and 2.2 * s or 0.4 * s
		if f.ostrich then
			local n = add(body, "Neck", Vector3.new(0.4 * s, neck, 0.4 * s), Vector3.new(0, bs.Y / 2 + neck * 0.4, -bs.Z * 0.35), c3)
		end
		motor(body, head, "Head", CFrame.new(0, bs.Y * 0.4 + (f.ostrich and neck or 0), -bs.Z * 0.42), CFrame.new(0, 0, hs * 0.35), "head", 0)
		add(head, "Beak", Vector3.new(0.3 * s, 0.25 * s, 0.6 * s), Vector3.new(0, -0.1 * s, -hs * 0.65), f.ostrich and c3 or Color3.fromRGB(255, 190, 40), nil, CFrame.Angles(0.1, 0, 0))
		eyes(head, hs, -hs * 0.4, f.owl and Color3.fromRGB(255, 220, 60) or nil)
		if f.bat then
			for _, sx in ipairs({-1, 1}) do add(head, "Ear", Vector3.new(0.25 * s, 0.7 * s, 0.1 * s), Vector3.new(sx * hs * 0.3, hs * 0.7, 0), c1, nil, CFrame.Angles(0, 0, sx * -0.2)) end
		end
		if f.owl then for _, sx in ipairs({-1, 1}) do add(head, "Tuft", Vector3.new(0.15 * s, 0.5 * s, 0.15 * s), Vector3.new(sx * hs * 0.3, hs * 0.65, 0), c2) end end
		if f.phoenix then
			for i = 1, 3 do add(head, "Crest", Vector3.new(0.12 * s, 0.9 * s, 0.12 * s), Vector3.new((i - 2) * 0.25 * s, hs * 0.7, hs * 0.1), c3, Enum.Material.Neon, CFrame.Angles(0.3, 0, (i - 2) * -0.4)) end
		end
		if not f.ostrich then
			for _, sx in ipairs({-1, 1}) do
				local span = (f.phoenix and 3.4 or 2.4) * s
				local w = mk(model, sx < 0 and "WingL" or "WingR", Vector3.new(span, 0.12 * s, 1.4 * s), c2, f.ice and Enum.Material.Ice or (f.flame and Enum.Material.Neon or SP))
				if f.bat then w.Color = c1 end
				motor(body, w, w.Name, CFrame.new(sx * bs.X * 0.45, bs.Y * 0.2, 0), CFrame.new(-sx * span / 2, 0, 0), "wing", 0, {Side = sx})
				add(w, "Tip", Vector3.new(span * 0.5, 0.14 * s, 0.9 * s), Vector3.new(sx * span * 0.25, 0, 0.1 * s), c3, (f.phoenix or f.flame) and Enum.Material.Neon or SP)
			end
		else
			for _, sx in ipairs({-1, 1}) do add(body, "WingStub", Vector3.new(0.3 * s, 1.0 * s, 1.4 * s), Vector3.new(sx * bs.X * 0.55, 0, 0), c2) end
		end
		local tl = (f.phoenix and 2.6 or 1.2) * s
		local tail = mk(model, "Tail", Vector3.new(0.9 * s, 0.1 * s, tl), c2, f.flame and Enum.Material.Neon or SP)
		motor(body, tail, "Tail", CFrame.new(0, 0.1 * s, bs.Z / 2 - 0.1 * s), CFrame.new(0, 0, -tl / 2), "tail", 0)
		local legL = f.ostrich and 2.6 * s or 0.8 * s
		for i, sx in ipairs({-1, 1}) do
			local leg = mk(model, "Leg" .. i, Vector3.new(0.18 * s, legL, 0.18 * s), f.ostrich and Color3.fromRGB(240, 150, 140) or Color3.fromRGB(255, 190, 40))
			motor(body, leg, "Leg" .. i, CFrame.new(sx * bs.X * 0.25, -bs.Y * 0.4, 0.1 * s), CFrame.new(0, legL / 2, 0), "leg", sx < 0 and 0 or math.pi)
		end
		hip = legL + bs.Y * 0.4
		top = bs.Y / 2 + hs + (f.ostrich and neck or 0)
		if not f.ostrich then model:SetAttribute("Fly", true); hip = 0.8 * s end

	elseif kind == "serpent" then
		local n = 8
		local prev, prevLen = root, 0
		local first
		for i = 1, n do
			local w = 0.9 * s * (1 - (i - 1) * 0.08)
			local len = 0.95 * s
			local seg = mk(model, i == 1 and "Body" or ("Seg" .. i), Vector3.new(w, w, len), (i % 2 == 0) and c2 or c1, bodyMat)
			round(seg)
			if i == 1 then
				motor(root, seg, "Body", nil, nil, "body", 0)
				first = seg
			else
				motor(prev, seg, "Seg" .. i, CFrame.new(0, 0, prevLen / 2), CFrame.new(0, 0, -len / 2), "seg", i * 0.7, {Idx = i})
			end
			prev, prevLen = seg, len
		end
		eyes(first, 0.9 * s, -0.5 * s, Color3.fromRGB(255, 220, 40))
		add(first, "Tongue", Vector3.new(0.08 * s, 0.05 * s, 0.5 * s), Vector3.new(0, -0.1 * s, -0.65 * s), c3, Enum.Material.Neon)
		if f.hood then add(first, "Hood", Vector3.new(1.8 * s, 1.4 * s, 0.15 * s), Vector3.new(0, 0.2 * s, 0.5 * s), c3) end
		if f.spikes then for i = 1, 4 do add(first, "Spike", Vector3.new(0.2 * s, 0.4 * s, 0.2 * s), Vector3.new(0, 0.55 * s, 0.3 * s + i * 0.5 * s), c3, Enum.Material.Neon) end end
		hip = 0.45 * s; top = 1.2 * s

	elseif kind == "fish" then
		local bs = Vector3.new(1.6 * s, 1.5 * s, 4.2 * s)
		local body = mk(model, "Body", bs, c1); round(body)
		motor(root, body, "Body", nil, nil, "body", 0)
		add(body, "Belly", Vector3.new(bs.X * 0.8, bs.Y * 0.45, bs.Z * 0.75), Vector3.new(0, -bs.Y * 0.28, -0.1 * s), c2); 
		add(body, "Dorsal", Vector3.new(0.15 * s, 1.3 * s, 1.2 * s), Vector3.new(0, bs.Y * 0.6, 0.2 * s), c1, nil, CFrame.Angles(-0.4, 0, 0))
		for _, sx in ipairs({-1, 1}) do
			add(body, "Fin", Vector3.new(1.3 * s, 0.12 * s, 0.9 * s), Vector3.new(sx * bs.X * 0.75, -bs.Y * 0.25, -0.4 * s), c1, nil, CFrame.Angles(0, 0, sx * 0.4))
			add(body, "Eye", Vector3.new(0.18 * s, 0.18 * s, 0.1 * s), Vector3.new(sx * bs.X * 0.4, 0.15 * s, -bs.Z * 0.35), Color3.new(0.05, 0.05, 0.08))
		end
		local tail = mk(model, "Tail", Vector3.new(0.2 * s, 1.9 * s, 1.1 * s), c1)
		motor(body, tail, "Tail", CFrame.new(0, 0, bs.Z / 2 - 0.1 * s), CFrame.new(0, 0, -0.5 * s), "tail", 0, {Yaw = true})
		for i = 1, 5 do add(body, "Tooth", Vector3.new(0.12 * s, 0.2 * s, 0.1 * s), Vector3.new((i - 3) * 0.28 * s, -bs.Y * 0.2, -bs.Z / 2), Color3.new(1, 1, 1)) end
		hip = 0.7 * s; top = bs.Y / 2 + 1.1 * s

	elseif kind == "scorp" then
		local body = mk(model, "Body", Vector3.new(1.5 * s, 0.7 * s, 2.2 * s), c1)
		motor(root, body, "Body", nil, nil, "body", 0)
		add(body, "Plate", Vector3.new(1.3 * s, 0.2 * s, 1.8 * s), Vector3.new(0, 0.4 * s, 0), c2)
		local head = mk(model, "Head", Vector3.new(0.9 * s, 0.6 * s, 0.7 * s), c1)
		motor(body, head, "Head", CFrame.new(0, 0, -1.1 * s), CFrame.new(0, 0, 0.3 * s), "head", 0)
		eyes(head, 0.8 * s, -0.35 * s, c3)
		for _, sx in ipairs({-1, 1}) do
			local arm = mk(model, sx < 0 and "ArmL" or "ArmR", Vector3.new(0.3 * s, 0.3 * s, 1.3 * s), c1)
			motor(body, arm, arm.Name, CFrame.new(sx * 0.8 * s, 0, -1.0 * s), CFrame.new(0, 0, 0.6 * s), "arm", sx < 0 and 0 or math.pi)
			add(arm, "Claw", Vector3.new(0.8 * s, 0.25 * s, 0.7 * s), Vector3.new(sx * 0.15 * s, 0, -0.9 * s), c2)
		end
		for i = 1, 6 do
			local sx = (i % 2 == 0) and 1 or -1
			local leg = mk(model, "Leg" .. i, Vector3.new(0.9 * s, 0.14 * s, 0.14 * s), c2)
			motor(body, leg, "Leg" .. i, CFrame.new(sx * 0.7 * s, -0.2 * s, (math.ceil(i / 2) - 2) * 0.6 * s), CFrame.new(-sx * 0.45 * s, 0, 0), "leg", (i % 3) * 1.0)
		end
		local prev, prevPart = body, nil
		for i = 1, 4 do
			local seg = mk(model, "Seg" .. i, Vector3.new(0.45 * s, 0.45 * s, 0.7 * s), i == 4 and c3 or c1)
			if i == 1 then motor(body, seg, "Seg1", CFrame.new(0, 0.2 * s, 1.1 * s), CFrame.new(0, 0, -0.35 * s), "seg", 0, {Idx = 1})
			else motor(prev, seg, "Seg" .. i, CFrame.new(0, 0.1 * s, 0.35 * s) , CFrame.new(0, 0, -0.35 * s) * CFrame.Angles(0.45, 0, 0), "seg", i * 0.5, {Idx = i}) end
			if i == 4 then seg.Material = Enum.Material.Neon end
			prev = seg
		end
		hip = 0.5 * s; top = 1.6 * s
	end

	-- pose all parts from the joint list so the model is correct before it is simulated (also used in ViewportFrames)
	root.CFrame = CFrame.new()
	for _, j in ipairs(J) do j[2].CFrame = j[1].CFrame * j[3] * j[4]:Inverse() end

	model:SetAttribute("Hip", hip or 1)
	model:SetAttribute("Top", top or 2)
	model:SetAttribute("State", "idle")
	return model
end

return B
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">WeaponBuilder</string><ProtectedString name="Source"><![CDATA[-- Procedural weapon models (barrel points to -Z, Handle is the grip)
local Config = require(script.Parent.Config)
local W = {}

-- body colour, accent (neon) colour
local PAL = {
	Common     = {Color3.fromRGB(40,42,48),    Color3.fromRGB(220,224,230)},
	Uncommon   = {Color3.fromRGB(46,52,48),    Color3.fromRGB(70,255,90)},
	Rare       = {Color3.fromRGB(34,48,90),    Color3.fromRGB(60,190,255)},
	Epic       = {Color3.fromRGB(60,34,110),   Color3.fromRGB(230,90,255)},
	Legendary  = {Color3.fromRGB(235,185,50),  Color3.fromRGB(30,30,34)},
	Mythic     = {Color3.fromRGB(150,24,30),   Color3.fromRGB(255,120,40)},
	Exotic     = {Color3.fromRGB(30,90,100),   Color3.fromRGB(40,255,240)},
	Secret     = {Color3.fromRGB(80,30,120),   Color3.fromRGB(255,60,230)},
	Celestial  = {Color3.fromRGB(24,40,130),   Color3.fromRGB(150,200,255)},
	Divine     = {Color3.fromRGB(250,246,235), Color3.fromRGB(255,208,70)},
}

function W.build(def)
	local pal = PAL[def.rarity]; local body, acc = pal[1], pal[2]
	local tier = def.tier or Config.RIndex[def.rarity]
	local model = Instance.new("Model"); model.Name = def.name
	local J = {}
	local function mk(name, size, off, color, mat, rot)
		local p = Instance.new("Part"); p.Name = name; p.Size = size; p.Color = color; p.Material = mat or Enum.Material.SmoothPlastic
		p.CanCollide = false; p.CanTouch = false; p.Massless = true; p.CastShadow = false; p.Anchored = false
		p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local handle = mk("Handle", Vector3.new(0.4, 1.0, 0.55), nil, body)
	handle.CFrame = CFrame.new()
	local function add(name, size, off, color, mat, rot)
		local p = mk(name, size, off, color, mat)
		local w = Instance.new("Weld"); w.Part0 = handle; w.Part1 = p; w.C0 = CFrame.new(off) * (rot or CFrame.new()); w.Parent = p
		J[#J + 1] = {handle, p, w.C0}
		return p
	end
	local muzzleZ
	local k = def.kind
	if k == "pistol" then
		add("Slide", Vector3.new(0.42, 0.45, 2.0), Vector3.new(0, 0.7, -0.6), body)
		add("Barrel", Vector3.new(0.2, 0.2, 0.5), Vector3.new(0, 0.7, -1.85), Color3.fromRGB(25,25,28))
		add("Trim", Vector3.new(0.44, 0.08, 1.4), Vector3.new(0, 0.95, -0.4), acc, Enum.Material.Neon)
		add("Guard", Vector3.new(0.12, 0.12, 0.7), Vector3.new(0, 0.2, -0.45), body)
		muzzleZ = -2.15
	elseif k == "revolver" then
		add("Frame", Vector3.new(0.42, 0.5, 1.2), Vector3.new(0, 0.7, -0.4), body)
		local d = add("Drum", Vector3.new(0.7, 0.6, 0.6), Vector3.new(0, 0.7, -0.5), Color3.fromRGB(70,76,72), Enum.Material.Metal)
		add("Barrel", Vector3.new(0.24, 0.24, 1.6), Vector3.new(0, 0.85, -1.6), Color3.fromRGB(30,32,30))
		add("Trim", Vector3.new(0.26, 0.08, 1.6), Vector3.new(0, 1.0, -1.6), acc, Enum.Material.Neon)
		muzzleZ = -2.45
	elseif k == "shotgun" then
		add("BarrelA", Vector3.new(0.28, 0.28, 3.4), Vector3.new(-0.16, 0.85, -1.8), Color3.fromRGB(30,40,70))
		add("BarrelB", Vector3.new(0.28, 0.28, 3.4), Vector3.new(0.16, 0.85, -1.8), Color3.fromRGB(30,40,70))
		add("Trim", Vector3.new(0.6, 0.07, 3.0), Vector3.new(0, 1.03, -1.8), acc, Enum.Material.Neon)
		add("Receiver", Vector3.new(0.5, 0.6, 1.2), Vector3.new(0, 0.7, -0.1), body)
		add("Stock", Vector3.new(0.4, 0.7, 1.7), Vector3.new(0, 0.5, 1.2), Color3.fromRGB(120,76,40), Enum.Material.Wood, CFrame.Angles(-0.15, 0, 0))
		add("Pump", Vector3.new(0.5, 0.4, 1.0), Vector3.new(0, 0.55, -1.5), Color3.fromRGB(120,76,40), Enum.Material.Wood)
		muzzleZ = -3.5
	else -- rifle
		add("Receiver", Vector3.new(0.5, 0.7, 2.4), Vector3.new(0, 0.75, -0.7), body)
		add("Barrel", Vector3.new(0.22, 0.22, 2.4), Vector3.new(0, 0.85, -3.0), Color3.fromRGB(28,28,32))
		add("Guard", Vector3.new(0.45, 0.45, 1.6), Vector3.new(0, 0.75, -2.3), body)
		add("Stock", Vector3.new(0.42, 0.85, 1.4), Vector3.new(0, 0.55, 1.2), body, nil, CFrame.Angles(-0.2, 0, 0))
		add("Mag", Vector3.new(0.34, 1.1, 0.55), Vector3.new(0, 0.1, -0.7), Color3.fromRGB(30,30,34), nil, CFrame.Angles(0.15, 0, 0))
		add("Rail", Vector3.new(0.3, 0.12, 1.8), Vector3.new(0, 1.18, -0.7), Color3.fromRGB(24,24,28))
		local sc = add("Scope", Vector3.new(0.36, 0.36, 1.1), Vector3.new(0, 1.45, -0.7), Color3.fromRGB(30,30,36))
		add("Lens", Vector3.new(0.3, 0.3, 0.06), Vector3.new(0, 1.45, -1.27), acc, Enum.Material.Neon)
		add("Trim", Vector3.new(0.52, 0.08, 2.0), Vector3.new(0, 1.12, -0.7), acc, Enum.Material.Neon)
		add("TrimB", Vector3.new(0.24, 0.08, 1.8), Vector3.new(0, 0.97, -3.0), acc, Enum.Material.Neon)
		if tier >= 5 then add("Fin", Vector3.new(0.1, 0.5, 0.9), Vector3.new(0, 1.1, 0.5), acc, Enum.Material.Neon) end
		if tier == 7 then
			for i = 1, 3 do add("Crystal", Vector3.new(0.18, 0.18, 0.9), Vector3.new((i - 2) * 0.35, 0.5, -3.0), acc, Enum.Material.Neon, CFrame.Angles(0.2 * i, 0.4 * (i - 2), 0.3)) end
		end
		if tier == 10 then
			for _, sx in ipairs({-1, 1}) do
				add("Wing", Vector3.new(1.6, 0.08, 0.7), Vector3.new(sx * 0.9, 1.0, 0.4), Color3.new(1, 1, 1), Enum.Material.Neon, CFrame.Angles(0, sx * 0.5, sx * 0.35))
				add("WingB", Vector3.new(1.2, 0.08, 0.5), Vector3.new(sx * 1.3, 0.8, 0.8), acc, Enum.Material.Neon, CFrame.Angles(0, sx * 0.6, sx * 0.5))
			end
		end
		muzzleZ = -4.3
	end
	local att = Instance.new("Attachment"); att.Name = "Muzzle"; att.Position = Vector3.new(0, 0.8, muzzleZ); att.Parent = handle
	if tier >= 4 then
		local l = Instance.new("PointLight"); l.Color = acc; l.Range = 7; l.Brightness = 0.8; l.Parent = handle
		local pe = Instance.new("ParticleEmitter"); pe.Color = ColorSequence.new(acc); pe.Rate = 3 + tier; pe.Lifetime = NumberRange.new(0.6, 1.1)
		pe.Speed = NumberRange.new(0.5, 1.5); pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0)})
		pe.LightEmission = 1; pe.SpreadAngle = Vector2.new(180, 180); pe.Parent = handle
		pe.Name = "Aura"
	end
	for _, j in ipairs(J) do j[2].CFrame = j[1].CFrame * j[3] end
	model.PrimaryPart = handle
	return model
end

return W
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX18"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX16"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[-- Builds the whole world with code: terrain, hub, 4 zones, roads, bridges, castle, player bases
local RS = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local Config = require(RS.Config)
local Net = require(script.Parent.Modules.Net)
local AnimalBuilder = require(RS.AnimalBuilder)
local WeaponBuilder = require(RS.WeaponBuilder)
local H = Config.H
local T = workspace.Terrain
local R = Random.new(1337)
local V3, CF = Vector3.new, CFrame.new
local PI = math.pi
local Plastic, Smooth, Neon = Enum.Material.Plastic, Enum.Material.SmoothPlastic, Enum.Material.Neon

shared.Solids = {Forest = {}, Desert = {}, Snow = {}, Volcano = {}}

-- ===== lighting / sky / atmosphere =====
Lighting.ClockTime = 14; Lighting.Brightness = 3; Lighting.GeographicLatitude = 25
Lighting.Ambient = Color3.fromRGB(120, 128, 150); Lighting.OutdoorAmbient = Color3.fromRGB(150, 160, 190)
Lighting.EnvironmentDiffuseScale = 0.6; Lighting.EnvironmentSpecularScale = 0.4
Lighting.GlobalShadows = true
local function inst(class, props, parent)
	local i = Instance.new(class); for k, v in pairs(props) do i[k] = v end; i.Parent = parent; return i
end
inst("Atmosphere", {Density = 0.28, Offset = 0.2, Color = Color3.fromRGB(190, 215, 245), Decay = Color3.fromRGB(110, 150, 210), Glare = 0, Haze = 1.2}, Lighting)
inst("Sky", {SunAngularSize = 14}, Lighting)
inst("BloomEffect", {Intensity = 0.35, Size = 24, Threshold = 0.95}, Lighting)
inst("ColorCorrectionEffect", {Saturation = 0.25, Contrast = 0.08, Brightness = 0.02}, Lighting)
inst("SunRaysEffect", {Intensity = 0.05, Spread = 0.6}, Lighting)
inst("Clouds", {Cover = 0.55, Density = 0.65, Color = Color3.new(1, 1, 1)}, T)
T.WaterColor = Color3.fromRGB(60, 190, 255); T.WaterTransparency = 0.55; T.WaterWaveSize = 0.15; T.WaterWaveSpeed = 8; T.WaterReflectance = 0.5
T:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(86, 196, 62))
T:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(238, 190, 110))
T:SetMaterialColor(Enum.Material.Sandstone, Color3.fromRGB(214, 140, 72))
T:SetMaterialColor(Enum.Material.Snow, Color3.fromRGB(240, 248, 255))
T:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(112, 110, 135))
T:SetMaterialColor(Enum.Material.Basalt, Color3.fromRGB(46, 40, 48))
T:SetMaterialColor(Enum.Material.Ice, Color3.fromRGB(150, 220, 255))
T:SetMaterialColor(Enum.Material.Glacier, Color3.fromRGB(170, 225, 250))
T:SetMaterialColor(Enum.Material.Slate, Color3.fromRGB(90, 90, 110))

local Map = inst("Folder", {Name = "Map"}, workspace)
local function folder(n, par) return inst("Folder", {Name = n}, par or Map) end
local Hub, Decor = folder("Hub"), folder("Decor")

-- ===== helpers =====
local function P(par, size, cf, color, mat, props)
	local p = Instance.new("Part")
	p.Anchored = true; p.Size = size; p.CFrame = cf; p.Color = color; p.Material = mat or Plastic
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	if props then for k, v in pairs(props) do p[k] = v end end
	p.Parent = par
	return p
end
local function cylV(par, pos, h, r, color, mat, props) -- vertical cylinder, pos = centre
	local p = P(par, V3(h, r * 2, r * 2), CF(pos) * CFrame.Angles(0, 0, PI / 2), color, mat, props); p.Shape = Enum.PartType.Cylinder; return p
end
local function ball(par, pos, d, color, mat, props)
	local p = P(par, V3(d, d, d), CF(pos), color, mat, props); p.Shape = Enum.PartType.Ball; return p
end
local function light(par, color, range, br) return inst("PointLight", {Color = color, Range = range, Brightness = br, Shadows = false}, par) end
local function dirv(a) return V3(math.cos(a), 0, math.sin(a)) end
local function rnd(a, b) return R:NextNumber(a, b) end
local GREENS = {H"3FA845", H"47B84B", H"36963C", H"54C050"}
local STONE, STONE2 = Color3.fromRGB(150, 150, 172), Color3.fromRGB(116, 116, 140)
local WOOD, WOOD2 = Color3.fromRGB(150, 98, 52), Color3.fromRGB(102, 66, 36)
local ROCKC = {Color3.fromRGB(112, 110, 135), Color3.fromRGB(96, 96, 122), Color3.fromRGB(128, 124, 150)}

local function solid(zone, pos, r) if zone then table.insert(shared.Solids[zone], {pos.X, pos.Z, r}) end end

local function tree(par, pos, s, zone)
	local m = folder("Tree", par)
	P(m, V3(1.5 * s, 7 * s, 1.5 * s), CF(pos + V3(0, 3.5 * s, 0)), WOOD2, Smooth)
	local c = GREENS[R:NextInteger(1, #GREENS)]
	P(m, V3(7 * s, 5 * s, 7 * s), CF(pos + V3(0, 8.5 * s, 0)), c, Smooth, {CanCollide = false, CastShadow = false})
	P(m, V3(5 * s, 3.5 * s, 5 * s), CF(pos + V3(rnd(-1, 1) * s, 12 * s, rnd(-1, 1) * s)), GREENS[R:NextInteger(1, #GREENS)], Smooth, {CanCollide = false, CastShadow = false})
	P(m, V3(4.4 * s, 3.6 * s, 4.4 * s), CF(pos + V3(3 * s, 6.8 * s, -1.5 * s)), c, Smooth, {CanCollide = false, CastShadow = false})
	solid(zone, pos, 3 * s)
end
local function pine(par, pos, s, snow, zone)
	local m = folder("Pine", par)
	P(m, V3(1.2 * s, 4 * s, 1.2 * s), CF(pos + V3(0, 2 * s, 0)), WOOD2, Smooth)
	local sizes = {6, 4.8, 3.6, 2.2}
	local col = snow and H"2F8F58" or H"2E9A48"
	for i, w in ipairs(sizes) do
		local y = (3.5 + (i - 1) * 2.4) * s
		P(m, V3(w * s, 2.4 * s, w * s), CF(pos + V3(0, y, 0)), col, Smooth, {CanCollide = false, CastShadow = false})
		if snow then P(m, V3((w + 0.3) * s, 0.7 * s, (w + 0.3) * s), CF(pos + V3(0, y + 1.1 * s, 0)), H"F4FAFF", Smooth, {CanCollide = false, CastShadow = false}) end
	end
	solid(zone, pos, 2.2 * s)
end
local function deadTree(par, pos, s, color, zone)
	local m = folder("Dead", par)
	P(m, V3(1.1 * s, 7 * s, 1.1 * s), CF(pos + V3(0, 3.5 * s, 0)), color, Smooth)
	P(m, V3(0.7 * s, 3.5 * s, 0.7 * s), CF(pos + V3(1.4 * s, 6 * s, 0)) * CFrame.Angles(0, 0, -0.9), color, Smooth, {CanCollide = false})
	P(m, V3(0.6 * s, 3 * s, 0.6 * s), CF(pos + V3(-1.2 * s, 5 * s, 0)) * CFrame.Angles(0, 0, 0.9), color, Smooth, {CanCollide = false})
	solid(zone, pos, 1.5 * s)
end
local function rock(par, pos, s, color, mat, zone)
	local p = P(par, V3(rnd(3, 6) * s, rnd(2, 4.5) * s, rnd(3, 6) * s), CF(pos + V3(0, s, 0)) * CFrame.Angles(rnd(-0.2, 0.2), rnd(0, PI), rnd(-0.2, 0.2)), color or ROCKC[R:NextInteger(1, 3)], mat or Enum.Material.Slate)
	solid(zone, pos, 3 * s)
	return p
end
local function bush(par, pos, s, col)
	P(par, V3(3 * s, 2 * s, 3 * s), CF(pos + V3(0, s, 0)), col or GREENS[R:NextInteger(1, 4)], Smooth, {CanCollide = false})
	if R:NextNumber() < 0.5 then
		local fc = ({H"FF5A7A", H"FFE04A", H"FFFFFF", H"B070FF"})[R:NextInteger(1, 4)]
		for i = 1, 3 do P(par, V3(0.5, 0.5, 0.5), CF(pos + V3(rnd(-1, 1) * s, 2 * s, rnd(-1, 1) * s)), fc, Neon, {CanCollide = false, CastShadow = false}) end
	end
end
local function cactus(par, pos, s, zone)
	local g = H"3FA64A"
	cylV(par, pos + V3(0, 3 * s, 0), 6 * s, 0.7 * s, g, Smooth)
	local side = R:NextInteger(0, 1) * 2 - 1
	cylV(par, pos + V3(side * 1.6 * s, 3.4 * s, 0), 2.6 * s, 0.45 * s, g, Smooth, {CanCollide = false})
	P(par, V3(1.6 * s, 0.9 * s, 0.9 * s), CF(pos + V3(side * 0.9 * s, 2.2 * s, 0)), g, Smooth, {CanCollide = false})
	solid(zone, pos, 1.2 * s)
end
local function fence(par, a, b)
	local d = b - a; local len = d.Magnitude; if len < 1 then return end
	local mid = (a + b) / 2
	local look = CFrame.lookAt(V3(mid.X, 0, mid.Z), V3(b.X, 0, b.Z))
	local n = math.max(1, math.floor(len / 6))
	for i = 0, n do
		local p = a + d * (i / n)
		P(par, V3(0.7, 3.2, 0.7), CF(p.X, 1.6, p.Z), WOOD, Smooth, {CastShadow = false})
	end
	P(par, V3(0.35, 0.5, len), look * CF(0, 2.5, 0), WOOD, Smooth, {CanCollide = false, CastShadow = false})
	P(par, V3(0.35, 0.5, len), look * CF(0, 1.3, 0), WOOD, Smooth, {CanCollide = false, CastShadow = false})
end
local lampCount = 0
local function lamp(par, pos)
	P(par, V3(0.5, 7, 0.5), CF(pos + V3(0, 3.5, 0)), WOOD2, Smooth)
	local l = P(par, V3(1.3, 1.6, 1.3), CF(pos + V3(0, 7.6, 0)), H"FFC850", Neon, {CanCollide = false, Transparency = 0.1})
	P(par, V3(1.7, 0.3, 1.7), CF(pos + V3(0, 8.5, 0)), WOOD2, Smooth, {CanCollide = false})
	lampCount = lampCount + 1
	if lampCount % 2 == 0 then light(l, H"FFC070", 16, 1.2) end
end
local function path(par, a, b, w, y)
	local d = b - a; local len = d.Magnitude; local mid = (a + b) / 2
	y = y or 0.3
	local cf = CFrame.lookAt(V3(mid.X, y, mid.Z), V3(b.X, y, b.Z))
	P(par, V3(w, 0.6, len), cf, STONE, Enum.Material.Cobblestone, {CastShadow = false})
	P(par, V3(w + 1.6, 0.5, len), cf * CF(0, -0.02, 0), STONE2, Enum.Material.Slate, {CastShadow = false})
end
local function sign(par, pos, text, color, w, h)
	local a = P(par, V3(0.5, 0.5, 0.5), CF(pos), color, Smooth, {Transparency = 1, CanCollide = false, CanQuery = false})
	local g = inst("BillboardGui", {Size = UDim2.fromOffset(w or 240, h or 60), StudsOffset = V3(0, 0, 0), AlwaysOnTop = false, MaxDistance = 220}, a)
	inst("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = text, TextColor3 = color, Font = Enum.Font.FredokaOne, TextScaled = true, TextStrokeTransparency = 0}, g)
	return a
end
local function prompt(par, action, obj, dist, hold)
	return inst("ProximityPrompt", {ActionText = action, ObjectText = obj, MaxActivationDistance = dist or 12, HoldDuration = hold or 0, RequiresLineOfSight = false}, par)
end
local function steppedRoof(par, pos, w, color, steps)
	for i = 1, steps do
		local s = w * (1 - (i - 1) / steps * 0.85)
		P(par, V3(s, 2.2, s), CF(pos + V3(0, (i - 1) * 2.2 + 1.1, 0)), color, Smooth)
	end
end
local function tower(par, pos, w, h, roofColor)
	P(par, V3(w, h, w), CF(pos + V3(0, h / 2, 0)), Color3.fromRGB(120, 124, 150), Enum.Material.Brick)
	P(par, V3(w + 2, 2, w + 2), CF(pos + V3(0, h + 1, 0)), Color3.fromRGB(90, 94, 120), Smooth)
	steppedRoof(par, pos + V3(0, h + 2, 0), w + 4, roofColor, 5)
	P(par, V3(3, 4, 0.5), CF(pos + V3(0, h * 0.7, -w / 2 - 0.1)), H"1A2A5A", Neon, {Color = H"5AB4FF", CanCollide = false})
end
local function watchtower(par, pos)
	local m = folder("Watchtower", par)
	for _, sx in ipairs({-1, 1}) do for _, sz in ipairs({-1, 1}) do
		P(m, V3(0.9, 17, 0.9), CF(pos + V3(sx * 3, 8.5, sz * 3)), WOOD2, Smooth)
	end end
	for i = 1, 3 do
		P(m, V3(7, 0.4, 0.4), CF(pos + V3(0, i * 4.5, 3)), WOOD, Smooth, {CanCollide = false})
		P(m, V3(7, 0.4, 0.4), CF(pos + V3(0, i * 4.5, -3)), WOOD, Smooth, {CanCollide = false})
	end
	P(m, V3(8.5, 0.7, 8.5), CF(pos + V3(0, 17, 0)), WOOD, Smooth)
	for _, sx in ipairs({-1, 1}) do
		P(m, V3(0.4, 2.2, 8.5), CF(pos + V3(sx * 4, 18.5, 0)), WOOD, Smooth, {CanCollide = false})
		P(m, V3(8.5, 2.2, 0.4), CF(pos + V3(0, 18.5, sx * 4)), WOOD, Smooth, {CanCollide = false})
	end
	P(m, V3(10, 0.8, 10), CF(pos + V3(0, 22, 0)), H"B8503A", Smooth)
	P(m, V3(7, 0.8, 7), CF(pos + V3(0, 22.8, 0)), H"B8503A", Smooth)
	for _, sx in ipairs({-1, 1}) do for _, sz in ipairs({-1, 1}) do P(m, V3(0.5, 4, 0.5), CF(pos + V3(sx * 4.2, 20, sz * 4.2)), WOOD2, Smooth, {CanCollide = false}) end end
	P(m, V3(1.6, 17, 0.4), CF(pos + V3(0, 8.5, -3.2)) , WOOD, Smooth, {CanCollide = false, Transparency = 0.2})
end
local function paw(par, cf, size, color)
	-- paw emblem from 5 discs (axis along Z, facing -Z)
	local function d(off, r)
		local p = P(par, V3(0.6, r * 2, r * 2), cf * CF(off.X, off.Y, 0) * CFrame.Angles(0, PI / 2, 0), color, Neon, {CanCollide = false, CastShadow = false}); p.Shape = Enum.PartType.Cylinder
	end
	d(V3(0, -size * 0.15, 0), size * 0.38)
	d(V3(-size * 0.42, size * 0.3, 0), size * 0.16); d(V3(-size * 0.15, size * 0.52, 0), size * 0.16)
	d(V3(size * 0.15, size * 0.52, 0), size * 0.16); d(V3(size * 0.42, size * 0.3, 0), size * 0.16)
end
local function banner(par, pos, facing)
	P(par, V3(0.6, 12, 0.6), CF(pos + V3(-3.5, 6, 0)), WOOD2, Smooth); P(par, V3(0.6, 12, 0.6), CF(pos + V3(3.5, 6, 0)), WOOD2, Smooth)
	P(par, V3(8.5, 0.6, 0.6), CF(pos + V3(0, 11.5, 0)), WOOD2, Smooth, {CanCollide = false})
	local cloth = P(par, V3(5.4, 8, 0.3), CF(pos + V3(0, 7, 0)), H"D8283A", Smooth, {CanCollide = false})
	local g = inst("SurfaceGui", {Face = Enum.NormalId.Front, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 40}, cloth)
	inst("TextLabel", {Size = UDim2.fromScale(1, 0.7), BackgroundTransparency = 1, Text = "🐾", TextScaled = true, TextColor3 = Color3.new(1, 1, 1)}, g)
	local g2 = inst("SurfaceGui", {Face = Enum.NormalId.Back, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 40}, cloth)
	inst("TextLabel", {Size = UDim2.fromScale(1, 0.7), BackgroundTransparency = 1, Text = "🐾", TextScaled = true, TextColor3 = Color3.new(1, 1, 1)}, g2)
	lamp(par, pos + V3(-5.5, 0, 0)); lamp(par, pos + V3(5.5, 0, 0))
end
local function emitter(par, props)
	local e = Instance.new("ParticleEmitter")
	for k, v in pairs(props) do e[k] = v end
	e.Parent = par; return e
end
