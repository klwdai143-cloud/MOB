<?xml version="1.0" encoding="utf-8"?>
<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><Item class="Workspace" referent="RBX2"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">true</bool><int name="StreamingMinRadius">96</int><int name="StreamingTargetRadius">640</int></Properties><Item class="Terrain" referent="RBX1"><Properties><string name="Name">Terrain</string></Properties></Item></Item><Item class="Lighting" referent="RBX3"><Properties><string name="Name">Lighting</string><token name="Technology">3</token></Properties></Item><Item class="ReplicatedStorage" referent="RBX7"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Shared configuration: rarities, animals, weapons, zones, upgrades, shop, quests
local C = {}
local function H(h) return Color3.fromRGB(tonumber(h:sub(1,2),16), tonumber(h:sub(3,4),16), tonumber(h:sub(5,6),16)) end
C.H = H

C.Rarities = {"Common","Uncommon","Rare","Epic","Legendary","Mythic","Exotic","Secret","Celestial","Divine"}
C.RIndex = {}
for i, n in ipairs(C.Rarities) do C.RIndex[n] = i end
C.RColor = {Common=H"9AA0AA",Uncommon=H"3CCB46",Rare=H"2F7BFF",Epic=H"A050F0",Legendary=H"FFA51E",Mythic=H"FF3CC8",Exotic=H"12DCE6",Secret=H"C83CFF",Celestial=H"4660FF",Divine=H"FFD04A"}
C.AColor = {}  -- animal tag colours (match the reference image)
C.WColor = {}  -- weapon tag colours (match the reference image)
for k, v in pairs(C.RColor) do C.AColor[k] = v; C.WColor[k] = v end
C.AColor.Divine = H"22D8D0"
C.WColor.Legendary = H"FFC12A"
C.WColor.Mythic = H"EB323C"

C.HP     = {30, 80, 200, 550, 1500, 4500, 14000, 45000, 150000, 500000}
C.Income = {1, 3, 9, 28, 90, 300, 1000, 3500, 12000, 50000}
C.Weight = {40, 28, 18, 9, 4, 1.6, 0.6, 0.3, 0.1, 0.25}

-- Optional sound ids (built-in client sounds; replace with your own rbxassetid:// if you like)
C.Sounds = {
	shot = "rbxasset://sounds/snap.mp3", hit = "rbxasset://sounds/uuhhh.mp3", click = "rbxasset://sounds/button.wav",
	coin = "rbxasset://sounds/electronicpingshort.wav", win = "rbxasset://sounds/victory.wav", reload = "rbxasset://sounds/clickfast.wav",
	music = "", -- put a looping music asset id here, e.g. "rbxassetid://123456"
}

-- name|zone|rarity|kind|scale|c1|c2|c3|features
local ANIMALS = [[
Rabbit|Forest|Common|quad|0.7|F2F2F2|FFFFFF|FFB6C1|longears,tailshort,round
Deer|Forest|Uncommon|quad|1.3|B9783A|E8C898|5A3A1C|antlers,slim,longleg
Fox|Forest|Uncommon|quad|0.9|E8741E|FFFFFF|2A1A10|ears,foxtail,slim
Wolf|Forest|Rare|quad|1.1|7C838F|C9CED6|3C4048|ears,longtail
Boar|Forest|Rare|quad|1.1|6B4A30|A67C52|2A1D12|bulky,shortleg,tusks,tailshort
Bear|Forest|Epic|quad|1.6|6B4226|9A6A44|2A180C|bulky,shortleg,tailshort,round
Tiger|Forest|Epic|quad|1.5|F08A1C|FFF1D6|1A1A1A|ears,stripes,longtail
Elephant|Forest|Legendary|quad|2.6|8E94A3|B5BAC6|F4F4F4|bulky,trunk,bigears,tailshort
Gorilla|Forest|Legendary|biped|1.5|3B3F4A|6B7080|2A2D34|gorilla
