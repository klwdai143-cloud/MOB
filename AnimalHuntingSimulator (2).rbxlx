newPanel("zones", "Zones", "📍", 620, 330, H"2EE05A", {"coins", "zones"}, function(body)
	for i, z in ipairs(Config.Zones) do
		local open = D.zones[z.name]
		local c = new("Frame", {Size = UDim2.fromOffset(146, 220), Position = UDim2.fromOffset((i - 1) * 152, 0), BackgroundColor3 = z.color:Lerp(Color3.fromRGB(14, 18, 48), 0.55)}, body); corner(c, 12); stroke(c, z.color, 3); grad(c, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 190), 90)
		txt(c, {Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 8), Text = z.icon, TextSize = 56})
		txt(c, {Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 80), Text = z.name, TextSize = 24})
		txt(c, {Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 108), Text = open and "✔ Unlocked" or ("🔒 " .. fmt(z.price)), TextSize = 16, TextColor3 = open and H"7CFF8A" or H"FFD04A"})
		local best = Config.ZoneAnimals[z.name][#Config.ZoneAnimals[z.name]]
		txt(c, {Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 130), Text = "Up to " .. best.rarity, TextSize = 13, TextColor3 = Config.AColor[best.rarity]})
		if open then btn(c, "Teleport", H"2E7BE8", UDim2.new(1, -16, 0, 38), UDim2.new(0, 8, 1, -48), function() act("Teleport", z.name); closePanel("zones") end, 18)
		else btn(c, "Unlock", D.coins >= z.price and H"2FBF3A" or H"6A6F88", UDim2.new(1, -16, 0, 38), UDim2.new(0, 8, 1, -48), function() act("UnlockZone", z.name) end, 18) end
	end
	btn(body, "🏙 Hub", H"2E7BE8", UDim2.fromOffset(180, 42), UDim2.fromOffset(0, 232), function() act("Teleport", "Hub"); closePanel("zones") end, 20)
	btn(body, "🏠 My Base", H"34C759", UDim2.fromOffset(180, 42), UDim2.fromOffset(190, 232), function() act("Teleport", "Base"); closePanel("zones") end, 20)
	txt(body, {Size = UDim2.fromOffset(220, 42), Position = UDim2.fromOffset(384, 232), Text = "Walk to a gate or teleport", TextSize = 13, TextColor3 = Color3.fromRGB(190, 200, 240)})
end)

-- ===== Quests =====
newPanel("quests", "Quests", "📜", 520, 400, H"FFB020", {"quests", "hunted", "coins"}, function(body)
	local sf = scroller(body, UDim2.fromScale(1, 1), UDim2.new(), nil)
	new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, sf)
	for i, q in ipairs(Config.Quests) do
		local st = D.quests[q.id] or {t = 1, p = 0}
		local row = new("Frame", {Size = UDim2.new(1, -6, 0, 76), BackgroundColor3 = Color3.fromRGB(34, 42, 96), LayoutOrder = i}, sf); corner(row, 10); stroke(row, Color3.fromRGB(70, 90, 170), 2)
		if st.t > q.max then
			txt(row, {Size = UDim2.fromScale(1, 1), Text = "✔ " .. string.format(q.text, "") .. " - all done!", TextSize = 16, TextColor3 = H"7CFF8A"})
		else
			local target = Config.QuestTarget(q, st.t)
			local rc, rg = Config.QuestReward(q, st.t)
			local progress = math.min(st.p, target)
			txt(row, {Size = UDim2.new(1, -130, 0, 24), Position = UDim2.fromOffset(10, 4), Text = string.format(q.text, fmt(target)), TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left})
			bar(row, UDim2.new(1, -150, 0, 16), UDim2.fromOffset(10, 32), progress / target, H"3AB8FF")
			txt(row, {Size = UDim2.new(1, -150, 0, 16), Position = UDim2.fromOffset(10, 32), Text = fmt(progress) .. " / " .. fmt(target), TextSize = 12, ZIndex = 3})
			txt(row, {Size = UDim2.new(1, -150, 0, 20), Position = UDim2.fromOffset(10, 52), Text = "Reward: 🪙 " .. fmt(rc) .. "  💎 " .. rg, TextSize = 14, TextColor3 = H"FFD04A", TextXAlignment = Enum.TextXAlignment.Left})
			local can = st.p >= target
			btn(row, can and "Claim" or "...", can and H"2FBF3A" or H"4A5078", UDim2.fromOffset(100, 40), UDim2.new(1, -110, 0.5, -20), function() if can then act("ClaimQuest", q.id) end end, 18)
		end
	end
end)

-- ===== HUD =====
local function pill(y, icon, color, onPlus)
	local f = new("Frame", {Size = UDim2.fromOffset(190, 40), Position = UDim2.fromOffset(0, y), BackgroundColor3 = Color3.fromRGB(26, 32, 76)})
	corner(f, 20); stroke(f, color, 2.5)
	txt(f, {Size = UDim2.fromOffset(40, 40), Text = icon, TextSize = 26})
	local l = txt(f, {Size = UDim2.new(1, -84, 1, 0), Position = UDim2.fromOffset(42, 0), Text = "0", TextSize = 22, TextXAlignment = Enum.TextXAlignment.Left})
	if onPlus then btn(f, "+", H"2FBF3A", UDim2.fromOffset(30, 30), UDim2.new(1, -35, 0.5, -15), onPlus, 22) end
	return f, l
end
local function hbtn(parent, icon, label, color, pos, cb)
	local b = btn(parent, "", color, UDim2.fromOffset(58, 58), pos, cb)
	txt(b, {Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 2), Text = icon, TextSize = 26})
	txt(b, {Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -18), Text = label, TextSize = 12})
	return b
end
local left = cluster(Vector2.new(0, 0), UDim2.fromOffset(8, 46), UDim2.fromOffset(200, 280))
local p1, coinsL = pill(0, "🪙", H"FFC62A", function() shopTab = "coins"; if D then openPanel("shop") end end)
local p2, gemsL = pill(46, "💎", H"B050F0", function() shopTab = "gems"; if D then openPanel("shop") end end)
local p3, animL = pill(92, "🐾", H"FF9A3A")
p1.Parent, p2.Parent, p3.Parent = left, left, left
local multL = txt(left, {Size = UDim2.fromOffset(190, 18), Position = UDim2.fromOffset(4, 136), Text = "", TextSize = 14, TextColor3 = H"7CFF8A", TextXAlignment = Enum.TextXAlignment.Left})
local function openIf(id) return function() if D then togglePanel(id) end end end
local leftBtns = {{"🛒", "Shop", H"FFB020", "shop"}, {"⬆️", "Upgrades", H"3AB8FF", "upgrades"}, {"📖", "Index", H"4C86F0", "index"}, {"🎁", "Rewards", H"E8343A", "rewards"}, {"♻️", "Rebirth", H"B050F0", "rebirth"}, {"⚙️", "Settings", H"6A7090", "settings"}}
for i, b in ipairs(leftBtns) do
	local col, row = (i - 1) % 3, math.floor((i - 1) / 3)
	hbtn(left, b[1], b[2], b[3], UDim2.fromOffset(col * 64, 158 + row * 64), openIf(b[4]))
end
local right = cluster(Vector2.new(1, 0.5), UDim2.new(1, -8, 0.5, 0), UDim2.fromOffset(60, 316))
local rightBtns = {{"🔫", "Weapons", H"4C86F0", "weapons"}, {"🐾", "Animals", H"FF9A3A", "animals"}, {"🏠", "Base", H"34C759", "base"}, {"📜", "Quests", H"FFB020", "quests"}, {"📍", "Zones", H"2EE05A", "zones"}}
for i, b in ipairs(rightBtns) do hbtn(right, b[1], b[2], b[3], UDim2.fromOffset(0, (i - 1) * 64), openIf(b[4])) end

-- ammo bar
local ammoBox = cluster(Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -14), UDim2.fromOffset(240, 52))
ammoBox.Visible = false
local ammoBg = new("Frame", {Size = UDim2.fromOffset(150, 46), BackgroundColor3 = Color3.fromRGB(26, 32, 76)}, ammoBox); corner(ammoBg, 12); stroke(ammoBg, H"4C86F0", 2.5)
local ammoL = txt(ammoBg, {Size = UDim2.fromScale(1, 1), Text = "12/12", TextSize = 24})
btn(ammoBox, "R", H"E8A020", UDim2.fromOffset(80, 46), UDim2.fromOffset(158, 0), function() act("Reload") end, 22)
-- fire button (touch)
local fireCl = cluster(Vector2.new(1, 1), UDim2.new(1, -20, 1, -190), UDim2.fromOffset(96, 96))
local fireBtn = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(235, 60, 60), Text = "🔥", TextSize = 40, Font = Enum.Font.FredokaOne, AutoButtonColor = false}, fireCl)
corner(fireBtn, 48); stroke(fireBtn, Color3.fromRGB(120, 20, 20), 3)
fireCl.Visible = false
local cross = new("Frame", {Size = UDim2.fromOffset(8, 8), Position = UDim2.new(0.5, -4, 0.5, -4), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.2, Visible = false}, gui); corner(cross, 4); stroke(cross, Color3.new(0, 0, 0), 1.5)
-- target bar
local tgt = cluster(Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 46), UDim2.fromOffset(260, 46))
tgt.Visible = false
local tgtBg = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(26, 32, 76)}, tgt); corner(tgtBg, 10); local tgtSt = stroke(tgtBg, H"FFD04A", 2.5)
local tgtName = txt(tgtBg, {Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(5, 2), Text = "", TextSize = 17})
local tgtBar, tgtFill = bar(tgtBg, UDim2.new(1, -16, 0, 14), UDim2.fromOffset(8, 25), 1, H"E8343A")
local tgtTxt = txt(tgtBg, {Size = UDim2.new(1, -16, 0, 14), Position = UDim2.fromOffset(8, 25), Text = "", TextSize = 11, ZIndex = 3})
local tgtModel, tgtUntil = nil, 0
local function updateTarget()
	if tgtModel and tgtModel.Parent then
		local hp, mx = tgtModel:GetAttribute("HP") or 0, tgtModel:GetAttribute("MaxHP") or 1
		tgtFill.Size = UDim2.fromScale(math.clamp(hp / mx, 0, 1), 1)
		tgtTxt.Text = fmt(hp) .. " / " .. fmt(mx)
	end
end
-- toasts
local toastBox = cluster(Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 104), UDim2.fromOffset(330, 200))
new("UIListLayout", {Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder}, toastBox)
toast = function(text, color)
	color = color or Color3.new(1, 1, 1)
	local f = new("Frame", {Size = UDim2.fromOffset(320, 0), BackgroundColor3 = Color3.fromRGB(26, 32, 76), ClipsDescendants = true}, toastBox); corner(f, 12); stroke(f, color, 2.5)
	local t = txt(f, {Size = UDim2.new(1, -16, 0, 44), Position = UDim2.fromOffset(8, 0), Text = "📢 " .. text, TextWrapped = true, TextScaled = true})
	new("UITextSizeConstraint", {MaxTextSize = 17, MinTextSize = 9}, t)
	TS:Create(f, TweenInfo.new(0.25, Enum.EasingStyle.Back), {Size = UDim2.fromOffset(320, 44)}):Play()
	task.delay(3.2, function()
		local tw = TS:Create(f, TweenInfo.new(0.25), {Size = UDim2.fromOffset(320, 0)}); tw:Play()
		tw.Completed:Connect(function() f:Destroy() end)
	end)
end
catchPopup = function(name)
	local a = Config.AnimalByName[name]; if not a then return end
	local col = Config.AColor[a.rarity]
	local c = cluster(Vector2.new(0.5, 0.5), UDim2.new(0.5, 0, 0.6, 0), UDim2.fromOffset(230, 150))
	local f = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = col:Lerp(Color3.fromRGB(14, 18, 48), 0.6)}, c); corner(f, 14); stroke(f, col, 3.5); grad(f, Color3.new(1, 1, 1), Color3.fromRGB(165, 165, 185), 90)
	local vp = new("Frame", {Size = UDim2.new(1, -20, 0, 90), Position = UDim2.fromOffset(10, 4), BackgroundTransparency = 1}, f); viewport(vp, "animal", name)
	txt(f, {Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 96), Text = name .. "!", TextSize = 24, TextColor3 = col})
	txt(f, {Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 122), Text = a.rarity .. "  •  💰 " .. fmt(a.income) .. "/s", TextSize = 14})
	local us = c:FindFirstChildOfClass("UIScale")
	us.Scale = 0.2
	TS:Create(us, TweenInfo.new(0.35, Enum.EasingStyle.Back), {Scale = uiS}):Play()
	task.delay(2.6, function()
		TS:Create(us, TweenInfo.new(0.25), {Scale = 0}):Play()
		task.delay(0.3, function() for i, s in ipairs(scaled) do if s == us then table.remove(scaled, i) break end end c:Destroy() end)
	end)
end
zoneBanner = function(name)
	local z = Config.ZoneByName[name]; if not z then return end
	local c = cluster(Vector2.new(0.5, 0.5), UDim2.new(0.5, 0, 0.3, 0), UDim2.fromOffset(520, 120))
	local f = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = z.color:Lerp(Color3.fromRGB(30, 14, 10), 0.55)}, c); corner(f, 20); stroke(f, z.color, 4); grad(f, Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150), 90)
	txt(f, {Size = UDim2.new(1, 0, 0, 52), Position = UDim2.fromOffset(0, 8), Text = "New Zone Unlocked!", TextSize = 38, TextColor3 = H"FFE680"})
	txt(f, {Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 62), Text = z.icon .. " " .. z.name .. " Zone", TextSize = 34, TextColor3 = z.color})
	local us = c:FindFirstChildOfClass("UIScale"); us.Scale = 0.2
	TS:Create(us, TweenInfo.new(0.45, Enum.EasingStyle.Back), {Scale = uiS}):Play()
	play("win", 0.7, 1)
	task.delay(3.4, function()
		TS:Create(us, TweenInfo.new(0.3), {Scale = 0}):Play()
		task.delay(0.35, function() for i, s in ipairs(scaled) do if s == us then table.remove(scaled, i) break end end c:Destroy() end)
	end)
end

-- ===== locked zone gates (client-side collision) =====
local gates = {}
local function updateGates()
	for _, z in ipairs(Config.Zones) do
		local open = D.zones[z.name]
		if open and gates[z.name] then gates[z.name]:Destroy(); gates[z.name] = nil
		elseif not open and not gates[z.name] then
			local p = Instance.new("Part"); p.Name = "Gate_" .. z.name; p.Anchored = true; p.CanCollide = true; p.CanQuery = false
			p.Size = Vector3.new(17, 13, 2); p.Color = z.color; p.Material = Enum.Material.Neon; p.Transparency = 0.45
			local pos = z.gate + Vector3.new(0, 6.5, 0) - z.dir * 6
			p.CFrame = CFrame.lookAt(pos, pos + z.dir)
			local bb = Instance.new("BillboardGui"); bb.Size = UDim2.fromOffset(220, 60); bb.StudsOffset = Vector3.new(0, 1, 0); bb.AlwaysOnTop = true; bb.MaxDistance = 120; bb.Parent = p
			local l = txt(bb, {Size = UDim2.fromScale(1, 1), Text = "🔒 " .. z.name .. " Zone\nUnlock: " .. fmt(z.price) .. " (Zones menu)", TextScaled = true})
			p.Parent = workspace; gates[z.name] = p
		end
	end
end

-- ===== effects =====
local function burst(pos, color, count, speed, size)
	local p = Instance.new("Part"); p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.Transparency = 1; p.Size = Vector3.new(0.2, 0.2, 0.2); p.Position = pos; p.Parent = workspace
	local e = Instance.new("ParticleEmitter"); e.Rate = 0; e.Color = ColorSequence.new(color); e.Lifetime = NumberRange.new(0.4, 0.9); e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180); e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0)}); e.LightEmission = 1; e.Parent = p
	e:Emit(count); Debris:AddItem(p, 1.5)
end
local function flash(color, t)
	local f = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BackgroundTransparency = 0.3, ZIndex = 50, Active = false}, gui)
	TS:Create(f, TweenInfo.new(t or 0.8), {BackgroundTransparency = 1}):Play(); Debris:AddItem(f, (t or 0.8) + 0.1)
end
local function ring(pos, color, size, t)
	local r = Instance.new("Part"); r.Anchored = true; r.CanCollide = false; r.CanQuery = false; r.Shape = Enum.PartType.Cylinder; r.Material = Enum.Material.Neon; r.Color = color
	r.Size = Vector3.new(0.4, 2, 2); r.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2); r.Transparency = 0.2; r.Parent = workspace
	TS:Create(r, TweenInfo.new(t or 0.8, Enum.EasingStyle.Quad), {Size = Vector3.new(0.4, size, size), Transparency = 1}):Play(); Debris:AddItem(r, (t or 0.8) + 0.1)
end
local function dmgNumber(pos, dmg, crit, color)
	local p = Instance.new("Part"); p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.Transparency = 1; p.Size = Vector3.new(0.2, 0.2, 0.2); p.Position = pos; p.Parent = workspace
	local bb = Instance.new("BillboardGui"); bb.Size = UDim2.fromOffset(crit and 120 or 80, crit and 44 or 30); bb.AlwaysOnTop = true; bb.Parent = p
	local l = txt(bb, {Size = UDim2.fromScale(1, 1), Text = (crit and "💥 " or "") .. fmt(math.floor(dmg)), TextScaled = true, TextColor3 = crit and H"FF9A1E" or Color3.new(1, 1, 1), TextStrokeTransparency = 0})
	TS:Create(p, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = pos + Vector3.new(math.random(-10, 10) / 10, 3.5, math.random(-10, 10) / 10)}):Play()
	TS:Create(l, TweenInfo.new(0.7), {TextTransparency = 1, TextStrokeTransparency = 1}):Play(); Debris:AddItem(p, 0.8)
end
local function tracer(from, to, color)
	local len = (to - from).Magnitude; if len < 0.5 then return end
	local p = Instance.new("Part"); p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.Material = Enum.Material.Neon; p.Color = color
	p.Size = Vector3.new(0.14, 0.14, len); p.CFrame = CFrame.lookAt((from + to) / 2, to); p.Parent = workspace
	TS:Create(p, TweenInfo.new(0.12), {Transparency = 1, Size = Vector3.new(0.02, 0.02, len)}):Play(); Debris:AddItem(p, 0.15)
end
local function muzzlePos(tool)
	local h = tool and tool:FindFirstChild("Handle")
	local a = h and h:FindFirstChild("Muzzle")
	return a and a.WorldPosition
end
local function coinsFx(pos)
	for i = 1, 10 do
		local c = Instance.new("Part"); c.Anchored = true; c.CanCollide = false; c.CanQuery = false; c.Shape = Enum.PartType.Cylinder; c.Material = Enum.Material.Neon; c.Color = H"FFC62A"
		c.Size = Vector3.new(0.3, 1.2, 1.2); c.CFrame = CFrame.new(pos) * CFrame.Angles(math.random() * 3, math.random() * 3, math.random() * 3); c.Parent = workspace
		local tp = pos + Vector3.new(math.random(-6, 6), math.random(4, 9), math.random(-6, 6))
		TS:Create(c, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = tp}):Play()
		task.delay(0.6, function() TS:Create(c, TweenInfo.new(0.4), {Transparency = 1}):Play() end)
		Debris:AddItem(c, 1.1)
	end
	play("coin", 0.6, 1)
end

FXR.OnClientEvent:Connect(function(kind, a, b, c2, d2, e2)
	if kind == "shot" then
		local from, to, color, shooter = a, b, c2, d2
		if shooter == plr then
			local tool = plr.Character and plr.Character:FindFirstChildOfClass("Tool")
			from = muzzlePos(tool) or from
		else
			if (from - cam.CFrame.Position).Magnitude < 150 then play("shot", 0.25, 0.8) end
		end
		if (to - cam.CFrame.Position).Magnitude < 400 then tracer(from, to, color) end
	elseif kind == "hit" then
		local pos, color, dmg, crit, model = a, b, c2, d2, e2
		burst(pos, color, crit and 14 or 6, 14, 0.5)
		dmgNumber(pos, dmg, crit, color)
		play("hit", 0.3, 1.4 + math.random() * 0.4)
		if model and model.Parent and (model:GetPivot().Position - cam.CFrame.Position).Magnitude < 260 then
			tgtModel = model; tgtUntil = os.clock() + 3
			tgtName.Text = model.Name; tgtName.TextColor3 = Config.AColor[model:GetAttribute("Rarity") or "Common"]; tgtSt.Color = tgtName.TextColor3
			tgt.Visible = true; updateTarget()
		end
	elseif kind == "caught" then
		local pos, color, r = a, b, c2
		burst(pos, color, 30 + r * 4, 26, 0.9); ring(pos - Vector3.new(0, 1, 0), color, 14 + r * 2, 0.7)
		play(r >= 6 and "win" or "coin", 0.5, 1 + r * 0.03)
	elseif kind == "coins" then coinsFx(a)
	elseif kind == "upgrade" then
		local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if hrp then burst(hrp.Position, H"7CD0FF", 24, 14, 0.7); ring(hrp.Position - Vector3.new(0, 2.5, 0), H"7CD0FF", 10, 0.6) end
		play("coin", 0.6, 1.4)
	elseif kind == "rebirth" then
		local pos = a
		for i = 1, 4 do task.delay(i * 0.15, function() ring(pos - Vector3.new(0, 2.5, 0), H"E8A0FF", 20 + i * 14, 1.1) end) end
		burst(pos, H"E8A0FF", 70, 34, 1.2)
		if (pos - cam.CFrame.Position).Magnitude < 60 then flash(H"F0D0FF", 1.2) end
		play("win", 0.7, 0.9)
	elseif kind == "zone" then
		zoneBanner(a)
	end
end)
NotifyR.OnClientEvent:Connect(function(text, color, kind, extra)
	toast(text, color)
	if kind == "catch" and extra then catchPopup(extra) end
	if kind == "coin" or kind == "quest" then play("coin", 0.4, 1.1) elseif kind == "unlock" then play("win", 0.5, 1.2) end
end)
UIR.OnClientEvent:Connect(function(name) if D and panels[name] then openPanel(name) end end)

-- ===== shooting =====
local nextShot, mouseFire, touchFire = 0, false, false
local function heldTool() local c = plr.Character; return c and c:FindFirstChildOfClass("Tool") end
local function myHead() local c = plr.Character; return c and c:FindFirstChild("Head") end
local function aimAt(screenPos)
	local head = myHead(); if not head then return end
	local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
	local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances = {plr.Character}
	local res = workspace:Raycast(ray.Origin, ray.Direction * 700, rp)
	local target = res and res.Position or (ray.Origin + ray.Direction * 700)
	local d = target - head.Position
	if d.Magnitude < 1 then return ray.Direction end
	return d.Unit
end
local function assistTarget(range, radiusPx)
	local head = myHead(); if not head then return end
	local vs = cam.ViewportSize; local best, bestD
	for _, m in ipairs(CollectionService:GetTagged("Animal")) do
		if m:GetAttribute("IsAnimal") and m.PrimaryPart then
			local p = m.PrimaryPart.Position
			if (p - head.Position).Magnitude <= range then
				local v, on = cam:WorldToViewportPoint(p)
				if on then
					local dd = (Vector2.new(v.X, v.Y) - vs / 2).Magnitude
					if dd < radiusPx and (not bestD or dd < bestD) then best, bestD = m, dd end
				end
			end
		end
	end
	if best then return (best.PrimaryPart.Position + Vector3.new(0, (best:GetAttribute("Top") or 2) * 0.3, 0) - head.Position).Unit end
end
local function nearestAnimalDir(range)
	local head = myHead(); if not head then return end
	local best, bd
	for _, m in ipairs(CollectionService:GetTagged("Animal")) do
		if m:GetAttribute("IsAnimal") and m.PrimaryPart and D.zones[m:GetAttribute("Zone") or ""] then
			local d = (m.PrimaryPart.Position - head.Position).Magnitude
			if d <= range and (not bd or d < bd) then best, bd = m, d end
		end
	end
	if best then return (best.PrimaryPart.Position + Vector3.new(0, (best:GetAttribute("Top") or 2) * 0.3, 0) - head.Position).Unit end
end
local function tryShoot(dir)
	local tool = heldTool(); if not tool or not D or not dir then return end
	local w = Config.WeaponByName[tool:GetAttribute("Weapon") or ""]; if not w then return end
	if plr:GetAttribute("Reloading") then return end
	local now = os.clock(); if now < nextShot then return end
	local st = Config.Stats(w, D.upg)
	nextShot = now + 1 / st.rate
	if (plr:GetAttribute("Ammo") or 0) <= 0 then return end
	FireR:FireServer(dir)
	local mp = muzzlePos(tool)
	if mp then
		local fl = Instance.new("Part"); fl.Anchored = true; fl.CanCollide = false; fl.CanQuery = false; fl.Shape = Enum.PartType.Ball; fl.Material = Enum.Material.Neon; fl.Color = Config.WColor[w.rarity]
		fl.Size = Vector3.new(0.9, 0.9, 0.9); fl.Position = mp; fl.Parent = workspace
		local pl = Instance.new("PointLight"); pl.Color = fl.Color; pl.Range = 12; pl.Brightness = 3; pl.Parent = fl
		TS:Create(fl, TweenInfo.new(0.08), {Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2)}):Play(); Debris:AddItem(fl, 0.1)
	end
	play("shot", 0.4, 0.8 + (w.tier or 1) * 0.04)
end
UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.UserInputType == Enum.UserInputType.MouseButton1 then mouseFire = true
	elseif i.KeyCode == Enum.KeyCode.R then act("Reload") end
end)
UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then mouseFire = false end end)
fireBtn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then touchFire = true end end)
fireBtn.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then touchFire = false end end)

RunService.RenderStepped:Connect(function()
	local tool = heldTool()
	local has = tool ~= nil and D ~= nil
	ammoBox.Visible = has; cross.Visible = has and (UIS.TouchEnabled or UIS.GamepadEnabled)
	fireCl.Visible = has and UIS.TouchEnabled
	if has then
		local w = Config.WeaponByName[tool:GetAttribute("Weapon") or ""]
		if w then
			local reloading = plr:GetAttribute("Reloading")
			ammoL.Text = reloading and "Reloading..." or ((plr:GetAttribute("Ammo") or 0) .. "/" .. (plr:GetAttribute("MaxAmmo") or w.mag))
			ammoL.TextSize = reloading and 17 or 24
			local st = Config.Stats(w, D.upg)
			if D.settings.auto then
				local d = nearestAnimalDir(st.range); if d then tryShoot(d) end
			elseif touchFire then
				tryShoot(assistTarget(st.range, 110) or aimAt(cam.ViewportSize / 2))
			elseif mouseFire then
				tryShoot(aimAt(UIS:GetMouseLocation()))
			end
		end
	end
	if tgt.Visible then
		if os.clock() > tgtUntil then tgt.Visible = false else updateTarget() end
	end
end)

-- ===== animal animation (client side, Motor6D.Transform) =====
local animals = {}
local function regAnimal(m)
	if animals[m] then return end
	local a = {motors = {}, phase = math.random() * 6, caughtAt = nil}
	animals[m] = a
	local function add(d) if d:IsA("Motor6D") then a.motors[#a.motors + 1] = d end end
	for _, d in ipairs(m:GetDescendants()) do add(d) end
	m.DescendantAdded:Connect(add)
end
CollectionService:GetInstanceAddedSignal("Animal"):Connect(regAnimal)
CollectionService:GetInstanceRemovedSignal("Animal"):Connect(function(m) animals[m] = nil end)
for _, m in ipairs(CollectionService:GetTagged("Animal")) do regAnimal(m) end

local sin, abs, CFa = math.sin, math.abs, CFrame.Angles
local frameN = 0
RunService.RenderStepped:Connect(function()
	frameN = frameN + 1
	local low = D and D.settings.low
	local maxD = low and 70 or 140
	if low and frameN % 2 == 0 then return end
	local camPos = cam.CFrame.Position
	local clock = os.clock()
	for m, a in pairs(animals) do
		local root = m.PrimaryPart
		if root and (root.Position - camPos).Magnitude < maxD then
			local state = m:GetAttribute("State") or "idle"
			local moving = state == "walk" or state == "run"
			local f = state == "run" and 11 or 5
			local amp = state == "run" and 0.9 or (state == "walk" and 0.5 or 0)
			local t = clock + a.phase
			if state == "caught" and not a.caughtAt then a.caughtAt = clock end
			for _, mo in ipairs(a.motors) do
				if mo.Parent then
					local role, ph = mo:GetAttribute("Role"), mo:GetAttribute("Ph") or 0
					if role == "leg" then mo.Transform = CFa(sin(t * f + ph) * amp + (moving and 0 or sin(t * 1.2 + ph) * 0.02), 0, 0)
					elseif role == "arm" then mo.Transform = CFa(sin(t * f + ph) * amp * 0.8 + (moving and 0 or sin(t * 1.5 + ph) * 0.06), 0, 0)
					elseif role == "tail" then
						local ang = sin(t * (moving and 7 or 2.5) + ph) * (moving and 0.5 or 0.3)
						mo.Transform = CFa(0, ang, 0)
					elseif role == "head" then
						if state == "alert" then mo.Transform = CFa(-0.45, sin(t * 6) * 0.25, 0)
						elseif state == "hurt" then mo.Transform = CFa(0.4 * sin(t * 40), 0, 0)
						elseif moving then mo.Transform = CFa(0.05 + sin(t * f) * 0.06, 0, 0)
						else mo.Transform = CFa(sin(t * 1.3) * 0.08, sin(t * 0.7) * 0.2, 0) end
					elseif role == "wing" then
						local side = mo:GetAttribute("Side") or 1
						local ff = (m:GetAttribute("Fly") or moving) and 9 or 3
						mo.Transform = CFa(0, 0, side * sin(t * ff) * 0.7)
					elseif role == "seg" then
						mo.Transform = CFa(0, sin(t * (moving and 8 or 2.5) - ph) * (moving and 0.4 or 0.15), 0)
					elseif role == "body" then
						if state == "alert" then mo.Transform = CFrame.new(0, abs(sin(t * 9)) * 0.4, 0)
						elseif state == "hurt" then mo.Transform = CFrame.new(sin(t * 60) * 0.1, 0, 0) * CFa(0, 0, sin(t * 45) * 0.12)
						elseif state == "caught" then local k = clock - (a.caughtAt or clock); mo.Transform = CFrame.new(0, k * 4, 0) * CFa(0, k * 14, 0)
						elseif moving then mo.Transform = CFrame.new(0, abs(sin(t * f)) * 0.07 * (amp * 2), 0)
						else mo.Transform = CFrame.new(0, sin(t * 1.5) * 0.03, 0) end
					end
				end
			end
		end
	end
end)

-- health tags above hunted animals
local tags = {}
task.spawn(function()
	while true do
		task.wait(0.15)
		local camPos = cam.CFrame.Position
		for _, m in ipairs(CollectionService:GetTagged("Animal")) do
			local mx = m:GetAttribute("MaxHP")
			local root = m.PrimaryPart
			if mx and root then
				local near = (root.Position - camPos).Magnitude < 75
				local t = tags[m]
				if near and not t then
					local rar = m:GetAttribute("Rarity") or "Common"
					local bb = Instance.new("BillboardGui"); bb.Size = UDim2.fromOffset(130, 38); bb.StudsOffsetWorldSpace = Vector3.new(0, (m:GetAttribute("Top") or 3) + 1.5, 0); bb.AlwaysOnTop = false; bb.Adornee = root; bb.MaxDistance = 80
					local nl = txt(bb, {Size = UDim2.new(1, 0, 0, 20), Text = m.Name, TextScaled = true, TextColor3 = Config.AColor[rar]})
					local bg = new("Frame", {Size = UDim2.new(1, -10, 0, 9), Position = UDim2.new(0, 5, 0, 24), BackgroundColor3 = Color3.fromRGB(20, 20, 30), BorderSizePixel = 0}, bb); corner(bg, 4); stroke(bg, Color3.new(0, 0, 0), 1.5)
					local fill = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Config.AColor[rar], BorderSizePixel = 0}, bg); corner(fill, 4)
					bb.Parent = plr.PlayerGui
					t = {gui = bb, fill = fill}; tags[m] = t
				elseif not near and t then t.gui:Destroy(); tags[m] = nil end
				if t then t.fill.Size = UDim2.fromScale(math.clamp((m:GetAttribute("HP") or mx) / mx, 0, 1), 1) end
			end
		end
		for m, t in pairs(tags) do if not m.Parent then t.gui:Destroy(); tags[m] = nil end end
	end
end)

-- ===== data sync =====
local lastSettings = ""
local function applySettings()
	local s = D.settings
	if music then music.Volume = s.music and 0.25 or 0 end
	local low = s.low
	Lighting.GlobalShadows = not low
	for _, e in ipairs(Lighting:GetChildren()) do if e:IsA("BloomEffect") or e:IsA("SunRaysEffect") then e.Enabled = not low end end
	local mp = workspace:FindFirstChild("Map")
	if mp then for _, d in ipairs(mp:GetDescendants()) do if d:IsA("ParticleEmitter") and d:GetAttribute("Weather") then d.Enabled = not low end end end
end
local function onData()
	local total = 0
	for _, n in pairs(D.animals) do total = total + n end
	coinsL.Text = fmt(D.coins); gemsL.Text = fmt(D.gems); animL.Text = fmt(total)
	local left = boostLeft()
	multL.Text = "💰 Coins x" .. string.format("%.1f", D.mult or 1) .. (left > 0 and ("  ⭐ " .. mmss(left)) or "")
	updateGates()
	local sj = HttpService:JSONEncode(D.settings)
	if sj ~= lastSettings then lastSettings = sj; applySettings() end
	for id, p in pairs(panels) do
		if id ~= "info" and p.frame.Visible and refreshers[id] then
			local s = sigFor(id)
			if s ~= p.sig then p.sig = s; rebuild(id) end
		end
	end
	updateBasePending()
end
SyncR.OnClientEvent:Connect(function(p)
	D = p; serverOff = p.serverTime - os.time()
	onData()
end)
task.spawn(function()
	while true do
		task.wait(1)
		if D then
			updateRewardTimer()
			local left = boostLeft()
			multL.Text = "💰 Coins x" .. string.format("%.1f", D.mult or 1) .. (left > 0 and ("  ⭐ " .. mmss(left)) or "")
		end
	end
end)
print("[Client] ready")
]]></ProtectedString></Properties></Item></Item></Item></roblox>