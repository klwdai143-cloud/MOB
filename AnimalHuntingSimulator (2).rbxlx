	local sn = emitter(sky, {Rate = 90, Lifetime = NumberRange.new(7, 9), Speed = NumberRange.new(10, 14), EmissionDirection = Enum.NormalId.Bottom, Size = NumberSequence.new(0.35), Color = ColorSequence.new(Color3.new(1, 1, 1)), Acceleration = V3(3, 0, 1), LightEmission = 0.2})
	sn:SetAttribute("Weather", true)
end
-- Volcano
do
	local z = Config.ZoneByName.Volcano; local c = z.center
	local f = folder("Volcano", Map)
	local g, gAng = zoneShell(z, Enum.Material.Basalt, Enum.Material.Basalt, nil)
	-- volcano cone at the back (stacked terrain cylinders)
	local vc = c - z.dir * 108
	for i = 0, 9 do T:FillCylinder(CF(vc.X, 4 + i * 8, vc.Z), 8, 42 - i * 3.2, Enum.Material.Basalt) end
	T:FillCylinder(CF(vc.X, 80, vc.Z), 6, 9, Enum.Material.Air)
	local lava = cylV(f, V3(vc.X, 76, vc.Z), 1, 9, H"FF5A14", Neon, {CanCollide = false}); light(lava, H"FF6A24", 60, 2)
	emitter(lava, {Rate = 30, Lifetime = NumberRange.new(2, 4), Speed = NumberRange.new(15, 30), SpreadAngle = Vector2.new(30, 30), Color = ColorSequence.new(H"FF8A24"), Size = NumberSequence.new(1.2, 0), LightEmission = 1, Acceleration = V3(0, -20, 0)})
	emitter(lava, {Rate = 10, Lifetime = NumberRange.new(5, 7), Speed = NumberRange.new(8, 14), SpreadAngle = Vector2.new(20, 20), Color = ColorSequence.new(Color3.fromRGB(60, 54, 60)), Size = NumberSequence.new(6, 14), Transparency = NumberSequence.new(0.4, 1)})
	solid("Volcano", vc, 44)
	-- lava rivers running down the cone and through the zone
	local lp = folder("Lava", f)
	for k = 1, 3 do
		local a = gAng + k * 0.45
		local p0 = vc + V3(0, 0, 0)
		local prev = vc + dirv(a) * 20
		for i = 1, 7 do
			local nxt = vc + dirv(a + math.sin(i) * 0.12) * (20 + i * 11)
			if (nxt - c).Magnitude < 100 or true then lavaStrip(lp, V3(prev.X, 0, prev.Z), V3(nxt.X, 0, nxt.Z), rnd(4, 7)) end
			prev = nxt
		end
	end
	for i = 1, 14 do -- glowing fissures
		local p = c + dirv(rnd(0, PI * 2)) * rnd(40, 98)
		local d = dirv(rnd(0, PI * 2)) * rnd(8, 18)
		local fz = P(lp, V3(1.3, 0.2, d.Magnitude), CFrame.lookAt(V3(p.X, 0.15, p.Z), V3(p.X + d.X, 0.15, p.Z + d.Z)), H"FF6A1E", Neon, {CanCollide = false, CastShadow = false})
	end
	local rk = folder("Props", f)
	scatter(80, z, 96, 132, function(p) deadTree(rk, p, rnd(1, 1.5), Color3.fromRGB(36, 30, 34), "Volcano") end)
	scatter(36, z, 10, 98, function(p) rock(rk, p, rnd(0.8, 1.8), Color3.fromRGB(44, 38, 46), Enum.Material.Basalt, "Volcano") end)
	scatter(22, z, 20, 98, function(p) local k = P(rk, V3(rnd(1.5, 3), rnd(3, 8), rnd(1.5, 3)), CF(p + V3(0, 2.5, 0)) * CFrame.Angles(rnd(-0.2, 0.2), rnd(0, 3), rnd(-0.2, 0.2)), H"2A2430", Enum.Material.Basalt); solid("Volcano", p, 2)
		P(rk, V3(0.5, rnd(2, 5), 0.5), CF(p + V3(0.8, 3, 0)), H"FF5A14", Neon, {CanCollide = false}) end)
	for i = 1, 2 do hut(f, c + dirv(gAng + 0.6 + i * 0.55) * 118, gAng + 0.6 + i * 0.55 + PI / 2, H"7A2A22") end
	local embers = P(f, V3(220, 1, 220), CF(c.X, 6, c.Z), Color3.new(1, 0.4, 0.1), Smooth, {Transparency = 1, CanCollide = false, CanQuery = false})
	local em = emitter(embers, {Rate = 25, Lifetime = NumberRange.new(4, 6), Speed = NumberRange.new(4, 8), EmissionDirection = Enum.NormalId.Top, Size = NumberSequence.new(0.35), Color = ColorSequence.new(H"FF8A2A"), LightEmission = 1, Acceleration = V3(1, 2, 0)})
	em:SetAttribute("Weather", true)
	-- animated lava glow
	task.spawn(function()
		local t = 0
		while true do
			t = t + 0.4
			local col = Color3.fromRGB(255, 80 + math.floor(math.sin(t) * 30), 20)
			for _, ch in ipairs(lp:GetChildren()) do ch.Color = col end
			task.wait(0.4)
		end
	end)
end

-- ===== PLAYER BASES =====
local Plots = folder("Plots", workspace)
for i, pl in ipairs(Config.Plots) do
	local c = pl.center
	local m = inst("Model", {Name = "Plot" .. i}, Plots)
	m:SetAttribute("Index", i); m:SetAttribute("Owner", 0)
	local col = pl.color
	local floor = P(m, V3(76, 0.6, 84), CF(c.X, 0.3, c.Z), Color3.fromRGB(138, 140, 160), Enum.Material.Cobblestone)
	P(m, V3(80, 0.5, 88), CF(c.X, 0.2, c.Z), Color3.fromRGB(100, 102, 122), Enum.Material.Slate)
