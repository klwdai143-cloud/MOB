-- Weapon Shop (blue) & Upgrade Smithy (red) near the plaza
local function house(par, pos, wallC, roofC, label, uiName, facing)
	local m = folder(label, par)
	P(m, V3(22, 12, 16), CF(pos + V3(0, 6, 0)), Color3.fromRGB(232, 234, 244), Smooth)
	P(m, V3(24, 2, 18), CF(pos + V3(0, 12.8, 0)), roofC, Smooth)
	P(m, V3(20, 2, 14), CF(pos + V3(0, 14.6, 0)), roofC, Smooth)
	P(m, V3(14, 2, 10), CF(pos + V3(0, 16.4, 0)), roofC, Smooth)
	P(m, V3(24.4, 0.4, 0.4), CF(pos + V3(0, 11.9, -9.2)), wallC, Neon, {CanCollide = false})
	P(m, V3(5, 8, 0.6), CF(pos + V3(0, 4.2, -8.1)), H"2A58D8", Smooth, {Color = wallC, CanCollide = false})
	for _, sx in ipairs({-6.5, 6.5}) do P(m, V3(3.5, 3.5, 0.5), CF(pos + V3(sx, 7, -8.1)), H"FFE8A0", Neon, {CanCollide = false}) end
	sign(m, pos + V3(0, 20, -8), label, wallC, 300, 50)
	local pad = cylV(m, pos + V3(0, 0.7, -16), 0.3, 5, wallC, Neon, {CanCollide = false, Transparency = 0.3})
	local pr = prompt(pad, "Open", label, 12); pr.Triggered:Connect(function(plr) Net.UI:FireClient(plr, uiName) end)
	return m
end
house(Hub, V3(-105, 0, -30), H"3AA0FF", H"2E5AD8", "Weapon Shop", "shop")
house(Hub, V3(105, 0, -30), H"FF4A4A", H"D82E3A", "Upgrade Smithy", "upgrades")
-- Weapon showcase with floating weapons on podiums
do
	local sc = folder("Showcase", Hub)
	local items = {}
	for i, w in ipairs(Config.Weapons) do
		local side = (i <= 5) and -1 or 1
		local idx = (i - 1) % 5
		local pos = V3(side * (34 + idx * 15), 0, 108)
		cylV(sc, pos + V3(0, 0.8, 0), 1.6, 5, Color3.fromRGB(60, 62, 84), Smooth)
		local col = Config.WColor[w.rarity]
		cylV(sc, pos + V3(0, 1.7, 0), 0.2, 4.2, col, Neon, {CanCollide = false})
		local m = WeaponBuilder.build(w)
		for _, d in ipairs(m:GetDescendants()) do if d:IsA("BasePart") then d.Anchored = true; d.CanCollide = false end end
		m.Parent = sc
		m:ScaleTo(1.5)
		items[#items + 1] = {m, pos + V3(0, 6, 0)}
		sign(sc, pos + V3(0, 11, 0), w.name, col, 180, 34)
		light(m.PrimaryPart, col, 14, 1)
	end
	task.spawn(function()
		local t = 0
		while true do
			t = t + 0.05
			for i, it in ipairs(items) do it[1]:PivotTo(CF(it[2] + V3(0, math.sin(t * 2 + i) * 0.5, 0)) * CFrame.Angles(0, t * 0.8 + i, 0) * CFrame.Angles(0, PI / 2, 0)) end
			task.wait(0.05)
		end
	end)
end
-- hub spawn (fallback)
inst("SpawnLocation", {Name = "HubSpawn", Anchored = true, Size = V3(8, 1, 8), Position = V3(0, 1, 60), Transparency = 1, CanCollide = false, Neutral = true, Duration = 0}, workspace)

-- ===== ZONES =====
local function zoneShell(z, groundMat, rimMat, capMat, capY)
	local c = z.center
	T:FillCylinder(CF(c.X, -8, c.Z), 16, Config.ZoneRadius, groundMat)
	local gateAng = math.atan2(z.dir.Z, z.dir.X)
	for i = 0, 35 do
		local ang = i / 36 * PI * 2
		local diff = math.abs(((ang - gateAng + PI) % (2 * PI)) - PI)
		local r = rnd(30, 42)
		local near = diff < 0.35
		if near then r = rnd(26, 30) end
		local pos = c + dirv(ang) * (Config.ZoneRadius + 4) + V3(0, rnd(10, 20), 0)
		T:FillBall(pos, r, rimMat)
		if capMat and not near then T:FillBall(pos + V3(0, r * 0.55, 0), r * 0.7, capMat) end
	end
	-- taller back peaks
	for i = 1, 6 do
		local ang = gateAng + PI + rnd(-0.9, 0.9)
		local pos = c + dirv(ang) * (Config.ZoneRadius + 20) + V3(0, rnd(30, 50), 0)
		T:FillBall(pos, rnd(36, 50), rimMat)
		if capMat then T:FillBall(pos + V3(0, 26, 0), 26, capMat) end
	end
	-- tunnel through the rim
	local mid = c + z.dir * 150 + V3(0, 6, 0)
	T:FillBlock(CFrame.lookAt(mid, mid + z.dir), V3(16, 12, 96), Enum.Material.Air)
	-- gate decoration
	local g = folder(z.name .. "Gate", Hub)
	local G = z.gate
	local perp = V3(-z.dir.Z, 0, z.dir.X)
	local look = CFrame.lookAt(G + V3(0, 0, 0), G + z.dir)
	for _, sx in ipairs({-1, 1}) do
		P(g, V3(4, 16, 4), CF(G + perp * sx * 10 + V3(0, 8, 0)), Color3.fromRGB(96, 92, 110), Enum.Material.Slate)
		P(g, V3(0.8, 14, 0.8), CF(G + perp * sx * 8 + V3(0, 7, 0) + z.dir * 1.8), z.color, Neon, {CanCollide = false})
	end
	P(g, V3(26, 4, 5), CFrame.lookAt(G + V3(0, 16, 0), G + V3(0, 16, 0) + z.dir), Color3.fromRGB(96, 92, 110), Enum.Material.Slate)
	P(g, V3(16.5, 0.8, 0.8), CFrame.lookAt(G + V3(0, 13.8, 0) + z.dir * 1.8, G + V3(0, 13.8, 0) + z.dir * 3), z.color, Neon, {CanCollide = false})
	local glow = P(g, V3(16, 13, 0.3), CFrame.lookAt(G + V3(0, 6.5, 0) + z.dir * 0.5, G + V3(0, 6.5, 0) + z.dir * 2), z.color, Neon, {CanCollide = false, Transparency = 0.7, CanQuery = false})
	light(glow, z.color, 22, 1.4)
	sign(g, G + V3(0, 21, 0), z.icon .. " " .. string.upper(z.name) .. " ZONE", z.color, 320, 54)
	watchtower(g, G + perp * 30 + V3(0, 0, 0) + z.dir * 8); watchtower(g, G - perp * 30 + z.dir * 8)
	-- road from the plaza to the gate
	local g0 = G * V3(1, 0, 1)
	path(Hub, g0.Unit * 52, g0 + z.dir * 4, 14)
	for i = 1, 8 do
		local p = g0.Unit * (52 + i * ((g0.Magnitude - 52) / 9))
		local pp = V3(-p.Unit.Z, 0, p.Unit.X)
		lamp(Hub, p + pp * 9)
		if i % 2 == 0 then fence(Hub, p + pp * 11, p + pp * 11 + (g0 - p).Unit * 12); fence(Hub, p - pp * 11, p - pp * 11 + (g0 - p).Unit * 12) end
	end
	return g, gateAng
end
local function scatter(n, z, rmin, rmax, fn)
	local gateAng = math.atan2(z.dir.Z, z.dir.X)
	local c = z.center
	for i = 1, n do
		local ang = rnd(0, PI * 2); local r = rnd(rmin, rmax)
		local diff = math.abs(((ang - gateAng + PI) % (2 * PI)) - PI)
		if not (diff < 0.4 and r > 20) then fn(c + dirv(ang) * r, ang) end
	end
end
local function hut(par, pos, rot, roofC)
	local m = folder("Hut", par)
	local cf = CF(pos) * CFrame.Angles(0, rot, 0)
	P(m, V3(10, 6, 8), cf * CF(0, 3, 0), WOOD, Enum.Material.Wood)
	P(m, V3(11.5, 1, 9.5), cf * CF(0, 6.5, 0) * CFrame.Angles(0, 0, 0.0), roofC, Smooth)
	P(m, V3(8, 1, 8), cf * CF(0, 7.5, 0), roofC, Smooth)
	P(m, V3(5, 1, 6.5), cf * CF(0, 8.5, 0), roofC, Smooth)
	P(m, V3(2.4, 4, 0.4), cf * CF(0, 2, -4.1), WOOD2, Smooth, {CanCollide = false})
	P(m, V3(2, 2, 0.4), cf * CF(3, 3.5, -4.1), H"FFE8A0", Neon, {CanCollide = false})
	solid(nil, pos, 6)
end
local function lavaStrip(par, a, b, w)
	local d = b - a
	local p = P(par, V3(w, 0.3, d.Magnitude), CFrame.lookAt((a + b) / 2 + V3(0, 0.2, 0), V3(b.X, 0.2, b.Z)), H"FF5A14", Neon, {CanCollide = false, CastShadow = false})
	if R:NextNumber() < 0.35 then light(p, H"FF6A24", 18, 1.2) end
	return p
end

-- Forest
do
	local z = Config.ZoneByName.Forest; local c = z.center
	local f = folder("Forest", Map)
	local g, gAng = zoneShell(z, Enum.Material.Grass, Enum.Material.Rock, Enum.Material.Grass)
	-- waterfall cliff + pool + stream (behind the zone)
	local back = c - z.dir * 128
	local wf = P(f, V3(10, 46, 4), CFrame.lookAt(back + V3(0, 26, 0), back + V3(0, 26, 0) + z.dir), H"8ADCFF", Enum.Material.Glass, {CanCollide = false, Transparency = 0.35})
	emitter(wf, {Rate = 40, Lifetime = NumberRange.new(1, 2), Speed = NumberRange.new(3, 7), SpreadAngle = Vector2.new(40, 40), Color = ColorSequence.new(Color3.new(1, 1, 1)), Size = NumberSequence.new(2, 0), Transparency = NumberSequence.new(0.5, 1)})
	local pool = back + z.dir * 14
	T:FillCylinder(CF(pool.X, -3, pool.Z), 6, 16, Enum.Material.Air); T:FillCylinder(CF(pool.X, -3, pool.Z), 5.5, 16, Enum.Material.Water)
	local sdir = (c + dirv(gAng + 1.3) * 60 - pool); sdir = V3(sdir.X, 0, sdir.Z)
	local send = pool + sdir.Unit * (sdir.Magnitude * 0.9)
	local smid = (pool + send) / 2
	T:FillBlock(CFrame.lookAt(V3(smid.X, -2.5, smid.Z), V3(send.X, -2.5, send.Z)), V3(7, 5, (send - pool).Magnitude), Enum.Material.Air)
	T:FillBlock(CFrame.lookAt(V3(smid.X, -2.8, smid.Z), V3(send.X, -2.8, send.Z)), V3(7, 4.4, (send - pool).Magnitude), Enum.Material.Water)
	T:FillCylinder(CF(send.X, -3, send.Z), 6, 12, Enum.Material.Air); T:FillCylinder(CF(send.X, -3, send.Z), 5.5, 12, Enum.Material.Water)
	local bm = smid + V3(0, 0, 0)
	local bcf = CFrame.lookAt(V3(bm.X, 0.6, bm.Z), V3(bm.X, 0.6, bm.Z) + V3(-sdir.Unit.Z, 0, sdir.Unit.X))
	P(f, V3(7, 0.6, 12), bcf, WOOD, Enum.Material.Wood)
	for _, sx in ipairs({-1, 1}) do P(f, V3(0.4, 1.6, 12), bcf * CF(sx * 3.4, 1, 0), WOOD2, Smooth, {CanCollide = false}) end
	hut(f, c + dirv(gAng + 0.7) * 118, gAng + 0.7 + PI / 2, H"B8503A"); hut(f, c + dirv(gAng - 0.7) * 118, gAng - 0.7 + PI / 2, H"B8503A")
	local rk = folder("Props", f)
	scatter(90, z, 96, 132, function(p) if R:NextNumber() < 0.7 then tree(rk, p, rnd(1, 1.6), "Forest") else pine(rk, p, rnd(1, 1.5), false, "Forest") end end)
	scatter(26, z, 55, 92, function(p) tree(rk, p, rnd(0.9, 1.3), "Forest") end)
	scatter(18, z, 30, 92, function(p) pine(rk, p, rnd(0.9, 1.2), false, "Forest") end)
	scatter(40, z, 8, 95, function(p) rock(rk, p, rnd(0.5, 1.2), nil, nil, "Forest") end)
	scatter(110, z, 5, 105, function(p) bush(rk, p, rnd(0.6, 1.1)) end)
	scatter(10, z, 40, 90, function(p) P(rk, V3(1.4, 1.4, 6), CF(p + V3(0, 0.7, 0)) * CFrame.Angles(0, rnd(0, 3), 0), WOOD2, Smooth) end)
end
-- Desert
do
	local z = Config.ZoneByName.Desert; local c = z.center
	local f = folder("Desert", Map)
	local g, gAng = zoneShell(z, Enum.Material.Sand, Enum.Material.Sandstone, Enum.Material.Sand)
	-- dunes on the ring
	for i = 1, 16 do
		local a = rnd(0, PI * 2)
		T:FillBall(c + dirv(a) * rnd(100, 122) + V3(0, -9, 0), rnd(12, 20), Enum.Material.Sand)
	end
	-- mesas
	for i = 1, 5 do
		local a = gAng + PI + rnd(-1.2, 1.2)
		local p = c + dirv(a) * rnd(116, 130)
		T:FillBlock(CF(p.X, 16, p.Z) * CFrame.Angles(0, rnd(0, PI), 0), V3(rnd(26, 36), 32, rnd(20, 30)), Enum.Material.Sandstone)
	end
	-- cave mouths in the rim
	for i = 1, 2 do
		local a = gAng + PI + (i == 1 and -0.5 or 0.5)
		local p = c + dirv(a) * 136 + V3(0, 5, 0)
		T:FillBlock(CFrame.lookAt(p, p - dirv(a)), V3(9, 10, 30), Enum.Material.Air)
		P(f, V3(11, 1.6, 2), CFrame.lookAt(p + V3(0, 5.5, 0) - dirv(a) * 15, p + V3(0, 5.5, 0)), Color3.fromRGB(150, 100, 60), Enum.Material.Sandstone)
	end
	local rk = folder("Props", f)
	scatter(90, z, 20, 108, function(p) cactus(rk, p, rnd(0.8, 1.5), "Desert") end)
	scatter(26, z, 25, 98, function(p) rock(rk, p, rnd(1, 2.4), Color3.fromRGB(214, 150, 90), Enum.Material.Sandstone, "Desert") end)
	scatter(10, z, 60, 100, function(p) deadTree(rk, p, rnd(0.9, 1.3), Color3.fromRGB(120, 86, 56), "Desert") end)
	scatter(7, z, 50, 96, function(p, ang) -- rock arches
		local cf = CF(p) * CFrame.Angles(0, ang, 0)
		P(rk, V3(4, 14, 4), cf * CF(-6, 7, 0), Color3.fromRGB(214, 140, 72), Enum.Material.Sandstone); P(rk, V3(4, 14, 4), cf * CF(6, 7, 0), Color3.fromRGB(214, 140, 72), Enum.Material.Sandstone)
		P(rk, V3(18, 4, 5), cf * CF(0, 15, 0), Color3.fromRGB(200, 128, 66), Enum.Material.Sandstone, {CanCollide = false}); solid("Desert", p, 9)
	end)
	scatter(10, z, 50, 100, function(p) P(rk, V3(7, 3, 7), CF(p + V3(0, 1.5, 0)) * CFrame.Angles(0, rnd(0, 3), 0), H"E6B46A", Smooth); solid("Desert", p, 4) end)
	for i = 1, 3 do -- oasis hut
		hut(f, c + dirv(gAng + 0.5 + i * 0.35) * 112, gAng + 0.5 + i * 0.35 + PI / 2, H"C8803A")
	end
end
-- Snow
do
	local z = Config.ZoneByName.Snow; local c = z.center
	local f = folder("Snow", Map)
