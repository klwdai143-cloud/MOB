	fence(fz, V3(c.X - 38, 0, c.Z - 42), V3(c.X - 10, 0, c.Z - 42)); fence(fz, V3(c.X + 10, 0, c.Z - 42), V3(c.X + 38, 0, c.Z - 42))
	fence(fz, V3(c.X - 38, 0, c.Z - 42), V3(c.X - 38, 0, c.Z + 42)); fence(fz, V3(c.X + 38, 0, c.Z - 42), V3(c.X + 38, 0, c.Z + 42))
	fence(fz, V3(c.X - 38, 0, c.Z + 42), V3(c.X + 38, 0, c.Z + 42))
	lamp(m, V3(c.X - 10, 0, c.Z - 43)); lamp(m, V3(c.X + 10, 0, c.Z - 43))
	-- house
	local hz = c + V3(0, 0, 33)
	P(m, V3(22, 12, 14), CF(hz.X, 6.6, hz.Z), Color3.fromRGB(232, 234, 244), Smooth)
	P(m, V3(24, 2, 16), CF(hz.X, 13.4, hz.Z), col, Smooth); P(m, V3(20, 2, 12), CF(hz.X, 15.2, hz.Z), col, Smooth); P(m, V3(14, 2, 8), CF(hz.X, 17, hz.Z), col, Smooth)
	P(m, V3(24.4, 0.4, 0.4), CF(hz.X, 12.5, hz.Z - 8.2), col, Neon, {CanCollide = false})
	P(m, V3(5, 8, 0.5), CF(hz.X, 4.6, hz.Z - 7.1), col, Smooth, {CanCollide = false})
	for _, sx in ipairs({-6.5, 6.5}) do P(m, V3(3.5, 3.5, 0.5), CF(hz.X + sx, 7.5, hz.Z - 7.1), H"FFE8A0", Neon, {CanCollide = false}) end
	-- slots
	local slots = folder("Slots", m)
	for j = 1, Config.MaxSlots do
		local col_i = (j - 1) % 4; local row = math.floor((j - 1) / 4)
		local sp = V3(c.X - 24 + col_i * 16, 0, c.Z - 12 + row * 16)
		local sm = inst("Model", {Name = "Slot" .. j}, slots)
		local base = cylV(sm, sp + V3(0, 0.9, 0), 1.2, 3.8, Color3.fromRGB(70, 72, 96), Smooth); base.Name = "Base"
		cylV(sm, sp + V3(0, 1.55, 0), 0.2, 3.2, col, Neon, {CanCollide = false, Name = "Ring"})
		local mount = P(sm, V3(0.4, 0.4, 0.4), CF(sp + V3(0, 1.7, 0)), col, Smooth, {Transparency = 1, CanCollide = false, CanQuery = false, Name = "Mount"})
		local bb = inst("BillboardGui", {Name = "Info", Size = UDim2.fromOffset(190, 52), StudsOffset = V3(0, 9, 0), MaxDistance = 55, AlwaysOnTop = false}, mount)
		inst("TextLabel", {Name = "Label", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.FredokaOne, TextScaled = true, TextStrokeTransparency = 0}, bb)
		local pr = prompt(base, "Interact", "Slot " .. j, 9)
		pr.Name = "Prompt"
	end
	-- collector pad + boards + upgrade stand
	local coll = folder("Collector", m)
	local pad = P(coll, V3(10, 0.5, 8), CF(c.X, 0.85, c.Z - 33), H"34C759", Neon, {CanCollide = false, Name = "Pad", Transparency = 0.15})
	local cp = prompt(pad, "Collect", "Cash", 10); cp.Name = "Prompt"
	sign(coll, c + V3(0, 6, -33), "💰 COLLECT", H"7CFF8A", 220, 40)
	local board = P(m, V3(18, 9, 0.8), CF(c.X + 28, 6, c.Z - 34), Color3.fromRGB(34, 40, 80), Smooth, {Name = "EarnBoard"})
	P(m, V3(1, 3, 1), CF(c.X + 28 - 7, 1.5, c.Z - 34), WOOD2, Smooth); P(m, V3(1, 3, 1), CF(c.X + 28 + 7, 1.5, c.Z - 34), WOOD2, Smooth)
	local sg = inst("SurfaceGui", {Name = "Gui", Face = Enum.NormalId.Front, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 40}, board)
	inst("TextLabel", {Name = "Title", Size = UDim2.fromScale(1, 0.3), BackgroundTransparency = 1, Text = "EARNINGS", TextColor3 = H"FFD04A", Font = Enum.Font.FredokaOne, TextScaled = true}, sg)
	inst("TextLabel", {Name = "Amount", Position = UDim2.fromScale(0, 0.3), Size = UDim2.fromScale(1, 0.4), BackgroundTransparency = 1, Text = "$0", TextColor3 = H"7CFF8A", Font = Enum.Font.FredokaOne, TextScaled = true}, sg)
	inst("TextLabel", {Name = "Rate", Position = UDim2.fromScale(0, 0.72), Size = UDim2.fromScale(1, 0.24), BackgroundTransparency = 1, Text = "+0/s", TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.FredokaOne, TextScaled = true}, sg)
	local nb = P(m, V3(20, 6, 0.8), CF(c.X - 28, 5, c.Z - 34), col, Smooth, {Name = "NameBoard"})
	P(m, V3(1, 2, 1), CF(c.X - 28 - 8, 1, c.Z - 34), WOOD2, Smooth); P(m, V3(1, 2, 1), CF(c.X - 28 + 8, 1, c.Z - 34), WOOD2, Smooth)
	local ng = inst("SurfaceGui", {Name = "Gui", Face = Enum.NormalId.Front, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 40}, nb)
	inst("TextLabel", {Name = "Owner", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "FREE BASE", TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.FredokaOne, TextScaled = true, TextStrokeTransparency = 0.3}, ng)
	-- upgrade stand
	local up = c + V3(-30, 0, -20)
	P(m, V3(7, 3, 4), CF(up.X, 1.8, up.Z), Color3.fromRGB(84, 86, 112), Enum.Material.Metal)
	P(m, V3(4, 1.2, 3), CF(up.X, 4, up.Z), col, Neon)
	local ucp = prompt(P(m, V3(7, 1, 4), CF(up.X, 1.2, up.Z), col, Smooth, {Transparency = 1, CanCollide = false}), "Upgrades", "Upgrade Station", 10)
	ucp.Triggered:Connect(function(plr) Net.UI:FireClient(plr, "upgrades") end)
	sign(m, up + V3(0, 8, 0), "⬆ UPGRADES", H"7CD0FF", 220, 40)
	-- trees / props around
	for k = 1, 4 do tree(m, c + V3(rnd(-34, 34), 0, rnd(20, 38)), rnd(0.8, 1.1)) end
	-- spawn
	inst("SpawnLocation", {Name = "Spawn", Anchored = true, Size = V3(6, 1, 6), Position = c + V3(0, 1.1, -26), Transparency = 1, CanCollide = false, Neutral = true, Duration = 0, Enabled = true}, m)
end

-- spin loop (crystals / orbs)
task.spawn(function()
	local t = 0
	while true do
		t = t + 0.05
		for _, s in ipairs(spinners) do
			local p = s[1]
			local base = p.Position
			p.CFrame = CF(base.X, s[3] + math.sin(t * 1.5) * 0.6, base.Z) * CFrame.Angles(0, t * s[2], 0) * CFrame.Angles(0.35, 0, 0.35)
		end
		task.wait(0.05)
	end
end)

workspace:SetAttribute("WorldReady", true)
print("[WorldBuilder] world ready")
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX17"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- Main server entry: wires modules together
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Modules = script.Parent.Modules
if not workspace:GetAttribute("WorldReady") then workspace:GetAttributeChangedSignal("WorldReady"):Wait() end
local Config = require(RS.Config)
local Net = require(Modules.Net)
local Data = require(Modules.Data)
local Animals = require(Modules.Animals)
local Weapons = require(Modules.Weapons)
local Base = require(Modules.Base)
local Economy = require(Modules.Economy)

Animals.Init()
Base.Init()
Data.extra = Base.Extra

local handlers = {}
for k, v in pairs(Economy.Handlers) do handlers[k] = v end
for k, v in pairs(Base.Handlers) do handlers[k] = v end
Net.Act.OnServerEvent:Connect(function(plr, act, a, b)
	local h = type(act) == "string" and handlers[act]
	if h and Data.Get(plr) then
		local ok, err = pcall(h, plr, a, b)
		if not ok then warn("[Act " .. act .. "] " .. tostring(err)) end
	end
end)

local function onPlayer(plr)
	local function onChar(c) if Data.Get(plr) then Weapons.ApplyCharacter(plr, c) end end
	plr.CharacterAdded:Connect(onChar)
	task.spawn(function()
		Data.Load(plr)
		local plot = Base.Assign(plr)
		Base.Render(plr)
		Data.Mark(plr)
		if plr.Character then
			if plot then plr.Character:PivotTo(CFrame.new(plot.Spawn.Position + Vector3.new(0, 4, 0))) end
			onChar(plr.Character)
		end
	end)
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do onPlayer(p) end

Players.PlayerRemoving:Connect(function(plr)
	Base.Release(plr)
	Data.Save(plr)
	Data.profiles[plr] = nil; Data.dirty[plr] = nil; Data.saveOK[plr] = nil
end)
game:BindToClose(function()
	for _, plr in ipairs(Players:GetPlayers()) do task.spawn(Data.Save, plr) end
	task.wait(3)
end)
print("[GameServer] running")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX15"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[local RS = game:GetService("ReplicatedStorage")
local f = RS:FindFirstChild("Remotes")
if not f then f = Instance.new("Folder"); f.Name = "Remotes"; f.Parent = RS end
for _, n in ipairs({"Act", "Fire", "Sync", "Notify", "FX", "UI"}) do
	if not f:FindFirstChild(n) then
		local r = Instance.new("RemoteEvent"); r.Name = n; r.Parent = f
	end
end
return f
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- Player data: load / save (DataStoreService, retries, never overwrites on failed load) + replication
local Players = game:GetService("Players")
local DSS = game:GetService("DataStoreService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Config)
local Net = require(script.Parent.Net)

local D = {profiles = {}, dirty = {}, saveOK = {}, extra = nil}
local store
pcall(function() store = DSS:GetDataStore("AnimalHuntingSim_v1") end)

local function default()
	return {
		coins = 0, gems = 10, weapons = {Pistol = true}, equipped = "Pistol", animals = {}, placed = {}, slots = 4,
		upg = {}, rebirths = 0, rp = 0, idxA = {}, idxW = {Pistol = true}, quests = {}, zones = {Forest = true},
		hunted = 0, daily = {last = 0, streak = 0}, boostUntil = 0, boostMult = 1, pending = 0,
		settings = {music = true, sfx = true, auto = false, low = false},
	}
end
local function merge(dst, src)
	for k, v in pairs(src) do
		if type(v) == "table" and type(dst[k]) == "table" then merge(dst[k], v) else dst[k] = v end
	end
end

function D.Get(plr) return D.profiles[plr] end
function D.Mark(plr) D.dirty[plr] = true end
function D.Notify(plr, text, color, kind, extra)
	Net.Notify:FireClient(plr, text, color or Color3.new(1, 1, 1), kind, extra)
end

function D.Load(plr)
	local key = "P_" .. plr.UserId
	local ok, data
	for i = 1, 3 do
		ok, data = pcall(function() return store and store:GetAsync(key) end)
		if ok and store then break end
		ok = false
		task.wait(1.5)
	end
	local p = default()
	if ok and type(data) == "table" then merge(p, data) end
	D.saveOK[plr] = ok == true
	if not ok then warn("[Data] could not load " .. plr.Name .. " - progress will NOT be saved this session (enable Studio API Services / Game Settings > Security).") end
	D.profiles[plr] = p
	return p
end

function D.Save(plr)
	local d = D.profiles[plr]
	if not d or not D.saveOK[plr] or not store then return false end
	for i = 1, 3 do
		local ok, err = pcall(function() store:UpdateAsync("P_" .. plr.UserId, function() return d end) end)
		if ok then return true end
		warn("[Data] save failed (" .. tostring(err) .. "), retry " .. i)
		task.wait(1)
	end
	return false
end

function D.Payload(plr)
	local d = D.profiles[plr]
	if not d then return nil end
	local t = {}
	for k, v in pairs(d) do t[k] = v end
	if D.extra then for k, v in pairs(D.extra(plr)) do t[k] = v end end
	t.serverTime = os.time()
	return t
end

task.spawn(function()
	while true do
		task.wait(0.25)
		for plr in pairs(D.dirty) do
			D.dirty[plr] = nil
			if plr.Parent then
				local pl = D.Payload(plr)
				if pl then Net.Sync:FireClient(plr, pl) end
			end
		end
	end
end)
task.spawn(function()
	while true do -- autosave
		task.wait(60)
		for _, plr in ipairs(Players:GetPlayers()) do task.spawn(D.Save, plr); end
	end
end)
return D
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[local RS = game:GetService("ReplicatedStorage")
local Config = require(RS.Config)
local Data = require(script.Parent.Data)
local Q = {}

function Q.State(d, id)
	local q = d.quests[id]
	if not q then q = {t = 1, p = 0}; d.quests[id] = q end
	return q
end
function Q.Add(plr, id, amount)
	local d = Data.Get(plr); if not d then return end
	local def = Config.QuestById[id]; if not def then return end
	local q = Q.State(d, id)
	if q.t > def.max then return end
	q.p = q.p + (amount or 1)
	Data.Mark(plr)
end
function Q.Claim(plr, id)
	local d = Data.Get(plr); if not d then return end
	local def = Config.QuestById[id]; if not def then return end
	local q = Q.State(d, id)
	if q.t > def.max then return end
	local target = Config.QuestTarget(def, q.t)
	if q.p < target then return end
	local rc, rg = Config.QuestReward(def, q.t)
	d.coins = d.coins + rc; d.gems = d.gems + rg
	q.t = q.t + 1; q.p = 0
	Data.Notify(plr, "Quest complete!  +" .. Config.Fmt(rc) .. " coins  +" .. rg .. " gems", Color3.fromRGB(255, 208, 74), "quest")
	Data.Mark(plr)
end
return Q
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Animals</string><ProtectedString name="Source"><![CDATA[-- Animal spawning, wandering AI (server) + hunting damage / capture
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Config = require(RS.Config)
local AnimalBuilder = require(RS.AnimalBuilder)
local Net = require(script.Parent.Net)
local Data = require(script.Parent.Data)
local Quests = require(script.Parent.Quests)

local A = {byModel = {}, list = {}}
local R = Random.new()
local PER_ZONE = 38
local folder = Instance.new("Folder"); folder.Name = "Animals"; folder.Parent = workspace
local templates = {}
for _, spec in ipairs(Config.Animals) do templates[spec.name] = AnimalBuilder.build(spec) end

local function pickSpec(zoneName)
	local pool = Config.ZoneAnimals[zoneName]
	local total = 0
	for _, s in ipairs(pool) do total = total + s.weight end
	local roll = R:NextNumber() * total
	for _, s in ipairs(pool) do
		roll = roll - s.weight
		if roll <= 0 then return s end
	end
	return pool[1]
end
local function blocked(zoneName, x, z)
	local list = shared.Solids and shared.Solids[zoneName]
	if not list then return false end
	for _, s in ipairs(list) do
		local dx, dz = x - s[1], z - s[2]
		local rr = s[3] + 3
		if dx * dx + dz * dz < rr * rr then return true end
	end
	return false
end
local function randPos(zone, cx, cz, radius)
	for i = 1, 14 do
		local ang, r = R:NextNumber() * math.pi * 2, math.sqrt(R:NextNumber()) * radius
		local x, z = cx + math.cos(ang) * r, cz + math.sin(ang) * r
		local dx, dz = x - zone.center.X, z - zone.center.Z
		if dx * dx + dz * dz < Config.PlayRadius ^ 2 and not blocked(zone.name, x, z) then return x, z end
	end
	return zone.center.X, zone.center.Z
end

local function setState(a, s)
	if a.state ~= s then a.state = s; a.model:SetAttribute("State", s) end
end

function A.SpawnOne(zone)
	local spec = pickSpec(zone.name)
	local m = templates[spec.name]:Clone()
	local x, z = randPos(zone, zone.center.X, zone.center.Z, Config.PlayRadius)
	m:SetAttribute("IsAnimal", true); m:SetAttribute("Rarity", spec.rarity); m:SetAttribute("Zone", zone.name)
	m:SetAttribute("HP", spec.hp); m:SetAttribute("MaxHP", spec.hp); m:SetAttribute("Income", spec.income)
	local hip, fly = m:GetAttribute("Hip"), m:GetAttribute("Fly")
	local baseY = fly and (hip + 6 + R:NextNumber() * 8) or hip
	local yaw = R:NextNumber() * math.pi * 2
	m.PrimaryPart.Anchored = true
	m:PivotTo(CFrame.new(x, baseY, z) * CFrame.Angles(0, yaw, 0))
	m.Parent = folder
	CollectionService:AddTag(m, "Animal")
	local heavy = spec.s >= 2.4 or spec.r >= 9
	local a = {
		model = m, root = m.PrimaryPart, spec = spec, zone = zone, hp = spec.hp, max = spec.hp, state = "idle", x = x, z = z, y = baseY, baseY = baseY,
		yaw = yaw, tx = x, tz = z, waitUntil = os.clock() + R:NextNumber() * 3, lastHit = 0, fly = fly, heavy = heavy, phase = R:NextNumber() * 6,
		walk = heavy and 3 or (4 + R:NextNumber() * 2), run = heavy and 8 or 15, alertCool = 0, shy = false,
	}
	A.byModel[m] = a
	A.list[#A.list + 1] = a
	return a
end

function A.Init()
	for _, zone in ipairs(Config.Zones) do
		for i = 1, PER_ZONE do A.SpawnOne(zone) end
	end
end

local function remove(a)
	A.byModel[a.model] = nil
	for i, v in ipairs(A.list) do if v == a then table.remove(A.list, i) break end end
end

local function rewardCapture(plr, a)
	local d = Data.Get(plr); if not d then return end
	local name, r = a.spec.name, a.spec.r
	d.animals[name] = (d.animals[name] or 0) + 1
	d.idxA[name] = true
	d.hunted = d.hunted + 1
	Quests.Add(plr, "hunt", 1)
	if r >= 5 then d.gems = d.gems + (r - 3) end
	Data.Notify(plr, "You caught " .. name .. "!  (" .. a.spec.rarity .. ")", Config.AColor[a.spec.rarity], "catch", name)
	Data.Mark(plr)
end

function A.Hit(plr, model, dmg, crit, hitPos)
	local a = A.byModel[model]
	if not a or a.dead then return end
	local d = Data.Get(plr)
	if not d or not d.zones[a.zone.name] then return end
	local now = os.clock()
	a.hp = a.hp - dmg; a.lastHit = now; a.hitBy = plr
	local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	a.hitFrom = hrp and hrp.Position or nil
	model:SetAttribute("HP", math.max(0, math.floor(a.hp)))
	Net.FX:FireAllClients("hit", hitPos or a.root.Position, Config.AColor[a.spec.rarity], dmg, crit, model)
	if a.hp <= 0 then
		a.dead = true
		setState(a, "caught")
		Net.FX:FireAllClients("caught", a.root.Position, Config.AColor[a.spec.rarity], a.spec.r)
		rewardCapture(plr, a)
		remove(a)
		task.delay(0.6, function() model:Destroy() end)
		task.delay(6 + R:NextNumber() * 10, function() A.SpawnOne(a.zone) end)
	elseif a.state ~= "hurt" then
		setState(a, "hurt"); a.hurtEnd = now + 0.45
	end
end

local function pickTarget(a, awayFrom)
	local z = a.zone
	for i = 1, 8 do
		local tx, tz
		if awayFrom then
			local dx, dz = a.x - awayFrom.X, a.z - awayFrom.Z
			local m = math.max(0.1, math.sqrt(dx * dx + dz * dz))
			local jit = (R:NextNumber() - 0.5) * 1.4
			local c, s = math.cos(jit), math.sin(jit)
			local ux, uz = (dx * c - dz * s) / m, (dx * s + dz * c) / m
			tx, tz = a.x + ux * 30, a.z + uz * 30
		else
			local ang = R:NextNumber() * math.pi * 2
			local r = 8 + R:NextNumber() * 25
			tx, tz = a.x + math.cos(ang) * r, a.z + math.sin(ang) * r
		end
		local dx, dz = tx - z.center.X, tz - z.center.Z
		local d = math.sqrt(dx * dx + dz * dz)
		if d > Config.PlayRadius - 2 then tx, tz = z.center.X + dx / d * (Config.PlayRadius - 2), z.center.Z + dz / d * (Config.PlayRadius - 2) end
		if not blocked(z.name, tx, tz) then a.tx, a.tz = tx, tz; return end
	end
	a.tx, a.tz = z.center.X, z.center.Z
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc = acc + dt
	if acc < 1 / 14 then return end
	local step = acc; acc = 0
	local now = os.clock()
	local pp = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if hrp then pp[#pp + 1] = hrp.Position end
	end
	for _, a in ipairs(A.list) do
		if not a.dead then
			local near, nearPos = math.huge, nil
			for _, p in ipairs(pp) do
				local dx, dz = p.X - a.x, p.Z - a.z
				local d = math.sqrt(dx * dx + dz * dz)
				if d < near then near, nearPos = d, p end
			end
			if near < 230 then
				if a.hp < a.max and now - a.lastHit > 5 then
					a.hp = math.min(a.max, a.hp + a.max * 0.04 * step)
					a.model:SetAttribute("HP", math.floor(a.hp))
				end
				local st = a.state
				local moving = false
				local speed = 0
				if st == "hurt" then
					if now > a.hurtEnd then setState(a, "run"); a.fleeEnd = now + 4; pickTarget(a, a.hitFrom or nearPos) end
				elseif st == "alert" then
					if now > a.alertEnd then
						if a.shy and nearPos then setState(a, "run"); a.fleeEnd = now + 3; pickTarget(a, nearPos)
						else setState(a, "idle"); a.waitUntil = now + 1 end
					end
				elseif st == "run" then
					speed = a.run; moving = true
					if now > a.fleeEnd then setState(a, "idle"); a.waitUntil = now + 1.5; moving = false end
				else
					if near < 20 and now > a.alertCool then
						a.alertCool = now + 12
						a.shy = not a.heavy and a.spec.r < 9
						setState(a, "alert"); a.alertEnd = now + 0.8
					elseif st == "idle" then
						if now > a.waitUntil then pickTarget(a); setState(a, "walk"); a.walkEnd = now + 12 end
					elseif st == "walk" then
						speed = a.walk; moving = true
						if now > a.walkEnd then setState(a, "idle"); a.waitUntil = now + 1 + R:NextNumber() * 4; moving = false end
					end
				end
				if moving then
					local dx, dz = a.tx - a.x, a.tz - a.z
					local d = math.sqrt(dx * dx + dz * dz)
					if d < 1.5 then
						if a.state == "run" then pickTarget(a, nearPos) else setState(a, "idle"); a.waitUntil = now + 1 + R:NextNumber() * 4 end
					else
						local want = math.atan2(-dx, -dz)
						local diff = ((want - a.yaw + math.pi) % (2 * math.pi)) - math.pi
						a.yaw = a.yaw + diff * math.min(1, step * 8)
						local mv = math.min(d, speed * step)
						a.x = a.x + dx / d * mv; a.z = a.z + dz / d * mv
					end
				end
				if a.fly then a.y = a.baseY + math.sin(now * 1.5 + a.phase) * 0.8 end
				if moving or a.fly then a.root.CFrame = CFrame.new(a.x, a.y, a.z) * CFrame.Angles(0, a.yaw, 0) end
			end
		end
	end
end)
return A
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Weapons</string><ProtectedString name="Source"><![CDATA[-- Weapon tools, ammo, reload and server-authoritative shooting
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Config = require(RS.Config)
local WeaponBuilder = require(RS.WeaponBuilder)
local Net = require(script.Parent.Net)
local Data = require(script.Parent.Data)
local Animals = require(script.Parent.Animals)

local W = {sess = {}}
local R = Random.new()

function W.Stats(plr)
	local d = Data.Get(plr)
	return Config.Stats(Config.WeaponByName[d.equipped], d.upg)
end

function W.Reset(plr)
	local st = W.Stats(plr)
	W.sess[plr] = {ammo = st.mag, last = 0, reloading = false}
	plr:SetAttribute("Ammo", st.mag); plr:SetAttribute("MaxAmmo", st.mag); plr:SetAttribute("Reloading", false)
end

function W.Give(plr)
	local d = Data.Get(plr); if not d then return end
	local w = Config.WeaponByName[d.equipped]
	local function clear(par) if par then for _, c in ipairs(par:GetChildren()) do if c:IsA("Tool") then c:Destroy() end end end end
	clear(plr:FindFirstChildOfClass("Backpack")); clear(plr.Character)
	local model = WeaponBuilder.build(w)
	local tool = Instance.new("Tool")
	tool.Name = w.name; tool.CanBeDropped = false; tool.RequiresHandle = true; tool.ToolTip = w.name
	tool:SetAttribute("Weapon", w.name)
	for _, c in ipairs(model:GetChildren()) do c.Parent = tool end
	model:Destroy()
	W.Reset(plr)
	tool.Parent = plr:FindFirstChildOfClass("Backpack") or plr
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum then task.defer(function() if tool.Parent and hum.Parent then hum:EquipTool(tool) end end) end
end

function W.Reload(plr)
	local s = W.sess[plr]; if not s or s.reloading then return end
	s.reloading = true; plr:SetAttribute("Reloading", true)
	local st = W.Stats(plr)
	task.delay(st.reload, function()
		if W.sess[plr] ~= s then return end
		s.ammo = st.mag; s.reloading = false
		plr:SetAttribute("MaxAmmo", st.mag); plr:SetAttribute("Ammo", st.mag); plr:SetAttribute("Reloading", false)
	end)
end

function W.ApplyCharacter(plr, char)
	local d = Data.Get(plr); if not d then return end
	local hum = char:WaitForChild("Humanoid", 10); if not hum then return end
	hum.WalkSpeed = W.Stats(plr).speed
	hum.MaxSlopeAngle = 50
	W.Give(plr)
end

Net.Fire.OnServerEvent:Connect(function(plr, dir)
	if typeof(dir) ~= "Vector3" or dir.Magnitude < 0.1 or dir.Magnitude ~= dir.Magnitude then return end
	local s, d, char = W.sess[plr], Data.Get(plr), plr.Character
	if not s or not d or not char then return end
	local hum, head = char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("Head")
	if not hum or hum.Health <= 0 or not head or not char:FindFirstChildOfClass("Tool") then return end
	if s.reloading then return end
	if s.ammo <= 0 then W.Reload(plr) return end
	local st, now = W.Stats(plr), os.clock()
	if now - s.last < (1 / st.rate) * 0.85 then return end
	s.last = now; s.ammo = s.ammo - 1
	plr:SetAttribute("Ammo", s.ammo)
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
	local ex = {}
	for _, p in ipairs(Players:GetPlayers()) do if p.Character then ex[#ex + 1] = p.Character end end
	params.FilterDescendantsInstances = ex
	local origin = head.Position
	dir = dir.Unit
	local w = Config.WeaponByName[d.equipped]
	local color = Config.WColor[w.rarity]
	for i = 1, st.pellets do
		local dd = dir
		if st.spread > 0 then
			dd = (CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(math.rad(R:NextNumber(-st.spread, st.spread)), math.rad(R:NextNumber(-st.spread, st.spread)), 0)).LookVector
		end
		local res = workspace:Raycast(origin, dd * st.range, params)
		local endP = res and res.Position or (origin + dd * st.range)
		if res then
			local model = res.Instance:FindFirstAncestorOfClass("Model")
			if model and model:GetAttribute("IsAnimal") then
				local crit = R:NextNumber() < st.crit
				Animals.Hit(plr, model, st.dmg * (crit and 2 or 1), crit, res.Position)
			end
		end
		Net.FX:FireAllClients("shot", origin, endP, color, plr)
	end
	if s.ammo <= 0 then W.Reload(plr) end
end)
return W
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Base</string><ProtectedString name="Source"><![CDATA[-- Player bases: plot assignment, animal pedestals, passive income, collection
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Config = require(RS.Config)
local AnimalBuilder = require(RS.AnimalBuilder)
local Net = require(script.Parent.Net)
local Data = require(script.Parent.Data)
local Quests = require(script.Parent.Quests)

local B = {plotOf = {}}
local Plots = workspace:WaitForChild("Plots")
local function slotOf(plot, j) return plot.Slots["Slot" .. j] end

function B.Mult(d)
	local m = 1 + 0.5 * d.rebirths
	if d.boostUntil > os.time() then m = m * d.boostMult end
	return m
end
function B.Income(plr)
	local d = Data.Get(plr); if not d then return 0 end
	local sum = 0
	for _, name in pairs(d.placed) do
		local a = Config.AnimalByName[name]
		if a then sum = sum + a.income end
	end
	return sum * B.Mult(d)
end
function B.Extra(plr)
	local d = Data.Get(plr)
	return {income = B.Income(plr), mult = d and B.Mult(d) or 1, hasPlot = B.plotOf[plr] ~= nil}
end
local function placedCount(d, name)
	local n = 0
	for _, v in pairs(d.placed) do if v == name then n = n + 1 end end
	return n
end
local function available(d, name) return (d.animals[name] or 0) - placedCount(d, name) end

function B.Render(plr)
	local plot, d = B.plotOf[plr], Data.Get(plr)
	if not plot or not d then return end
	for j = 1, Config.MaxSlots do
		local sm = slotOf(plot, j)
		local label, prompt, ring = sm.Mount.Info.Label, sm.Base.Prompt, sm.Ring
		local old = sm:FindFirstChild("Display"); if old then old:Destroy() end
		prompt.Enabled = true
		if j > d.slots then
			local cost = Config.SlotCost(j)
			label.Text = "🔒 " .. Config.Fmt(cost); ring.Color = Color3.fromRGB(90, 90, 100)
			prompt.ActionText = "Unlock (" .. Config.Fmt(cost) .. ")"; prompt.ObjectText = "Slot " .. j
		else
			local name = d.placed[tostring(j)]
			local a = name and Config.AnimalByName[name]
			if a then
				local m = AnimalBuilder.build(a)
				local ext = m:GetExtentsSize()
				local f = math.min(1.5, 5.5 / math.max(ext.X, ext.Y, ext.Z))
				m:ScaleTo(f)
				m.Name = "Display"
				m.PrimaryPart.Anchored = true
				local hip = m:GetAttribute("Hip") * f
				local mp = sm.Mount.Position
				m:PivotTo(CFrame.new(mp.X, mp.Y + hip, mp.Z))
				m.Parent = sm
				game:GetService("CollectionService"):AddTag(m, "Animal")
				label.Text = name .. "  +" .. Config.Fmt(a.income * B.Mult(d)) .. "/s"
				label.TextColor3 = Config.AColor[a.rarity]
				ring.Color = Config.AColor[a.rarity]
				prompt.ActionText = "Pick up"; prompt.ObjectText = name
			else
				label.Text = "Empty"; label.TextColor3 = Color3.new(1, 1, 1)
				ring.Color = plot:GetAttribute("Color") or Color3.new(1, 1, 1)
				prompt.ActionText = "Place best animal"; prompt.ObjectText = "Slot " .. j
			end
		end
	end
end

function B.Assign(plr)
	for _, plot in ipairs(Plots:GetChildren()) do
		if plot:GetAttribute("Owner") == 0 then
			plot:SetAttribute("Owner", plr.UserId)
			B.plotOf[plr] = plot
			plot.NameBoard.Gui.Owner.Text = plr.DisplayName .. "'s Base"
			plr.RespawnLocation = plot.Spawn
			return plot
		end
	end
end
function B.Release(plr)
	local plot = B.plotOf[plr]; if not plot then return end
	B.plotOf[plr] = nil
	plot:SetAttribute("Owner", 0)
	plot.NameBoard.Gui.Owner.Text = "FREE BASE"
	plot.EarnBoard.Gui.Amount.Text = "$0"; plot.EarnBoard.Gui.Rate.Text = "+0/s"
	for j = 1, Config.MaxSlots do
		local sm = slotOf(plot, j)
		local old = sm:FindFirstChild("Display"); if old then old:Destroy() end
		sm.Mount.Info.Label.Text = ""
		sm.Base.Prompt.Enabled = false
	end
end

local function ownerOf(plot) return Players:GetPlayerByUserId(plot:GetAttribute("Owner")) end

function B.Collect(plr)
	local d, plot = Data.Get(plr), B.plotOf[plr]; if not d then return end
	local amt = math.floor(d.pending)
	if amt < 1 then Data.Notify(plr, "Nothing to collect yet. Place animals on your pedestals!", Color3.fromRGB(255, 220, 120)); return end
	d.pending = d.pending - amt
	d.coins = d.coins + amt
	Quests.Add(plr, "earn", amt)
	local pos = plot and plot.Collector.Pad.Position or Vector3.zero
	Net.FX:FireClient(plr, "coins", pos + Vector3.new(0, 3, 0))
	Data.Notify(plr, "+" .. Config.Fmt(amt) .. " coins", Color3.fromRGB(255, 215, 70), "coin")
	Data.Mark(plr)
end

function B.Place(plr, name, slot)
	local d = Data.Get(plr); if not d or not B.plotOf[plr] then return end
	if type(name) ~= "string" or type(slot) ~= "number" or not Config.AnimalByName[name] then return end
	slot = math.floor(slot)
	if slot < 1 or slot > d.slots or d.placed[tostring(slot)] then return end
	if available(d, name) <= 0 then return end
	d.placed[tostring(slot)] = name
	Quests.Add(plr, "place", 1)
	B.Render(plr); Data.Mark(plr)
end
function B.Remove(plr, slot)
	local d = Data.Get(plr); if not d or type(slot) ~= "number" then return end
	if not d.placed[tostring(math.floor(slot))] then return end
	d.placed[tostring(math.floor(slot))] = nil
	B.Render(plr); Data.Mark(plr)
end
function B.Move(plr, from, to)
	local d = Data.Get(plr); if not d or type(from) ~= "number" or type(to) ~= "number" then return end
	from, to = math.floor(from), math.floor(to)
	local name = d.placed[tostring(from)]
	if not name or to < 1 or to > d.slots or d.placed[tostring(to)] then return end
	d.placed[tostring(from)] = nil; d.placed[tostring(to)] = name
	B.Render(plr); Data.Mark(plr)
end
function B.BuySlot(plr, slot)
	local d = Data.Get(plr); if not d or type(slot) ~= "number" then return end
	slot = math.floor(slot)
	if slot ~= d.slots + 1 or slot > Config.MaxSlots then Data.Notify(plr, "Unlock the previous slots first!", Color3.fromRGB(255, 120, 120)); return end
	local cost = Config.SlotCost(slot)
	if d.coins < cost then Data.Notify(plr, "Not enough coins (" .. Config.Fmt(cost) .. ")", Color3.fromRGB(255, 120, 120)); return end
	d.coins = d.coins - cost; d.slots = slot
	Data.Notify(plr, "Slot " .. slot .. " unlocked!", Color3.fromRGB(120, 255, 140), "unlock")
	B.Render(plr); Data.Mark(plr)
end
function B.AutoPlace(plr, only)
	local d = Data.Get(plr); if not d or not B.plotOf[plr] then return end
	local names = {}
	for name, n in pairs(d.animals) do if Config.AnimalByName[name] and n > 0 then names[#names + 1] = name end end
	table.sort(names, function(a, b) return Config.AnimalByName[a].income > Config.AnimalByName[b].income end)
	local placedAny = false
	for j = 1, d.slots do
		if (not only or only == j) and not d.placed[tostring(j)] then
			for _, name in ipairs(names) do
				if available(d, name) > 0 then d.placed[tostring(j)] = name; Quests.Add(plr, "place", 1); placedAny = true; break end
			end
		end
	end
	if not placedAny then Data.Notify(plr, "No free slot or no spare animals.", Color3.fromRGB(255, 220, 120)) end
	B.Render(plr); Data.Mark(plr)
end

function B.Init()
	for _, plot in ipairs(Plots:GetChildren()) do
		for j = 1, Config.MaxSlots do
			local sm = slotOf(plot, j)
			sm.Base.Prompt.Triggered:Connect(function(plr)
				if ownerOf(plot) ~= plr then return end
				local d = Data.Get(plr); if not d then return end
				if j > d.slots then B.BuySlot(plr, j)
				elseif d.placed[tostring(j)] then B.Remove(plr, j)
				else B.AutoPlace(plr, j) end
			end)
			sm.Base.Prompt.Enabled = false
		end
		plot.Collector.Pad.Prompt.Triggered:Connect(function(plr) if ownerOf(plot) == plr then B.Collect(plr) end end)
		local deb = {}
		plot.Collector.Pad.Touched:Connect(function(hit)
			local plr = Players:GetPlayerFromCharacter(hit.Parent)
			if plr and ownerOf(plot) == plr and not deb[plr] then deb[plr] = true; B.Collect(plr); task.delay(3, function() deb[plr] = nil end) end
		end)
		plot:SetAttribute("Color", slotOf(plot, 1).Ring.Color)
	end
	task.spawn(function()
		local n = 0
		while true do
			task.wait(1); n = n + 1
			for plr, plot in pairs(B.plotOf) do
				local d = Data.Get(plr)
				if d then
					local inc = B.Income(plr)
					d.pending = math.min(d.pending + inc, math.max(inc * 43200, d.pending))
					plot.EarnBoard.Gui.Amount.Text = "$" .. Config.Fmt(d.pending)
					plot.EarnBoard.Gui.Rate.Text = "+" .. Config.Fmt(inc) .. "/s"
					if n % 2 == 0 then Data.Mark(plr) end
				end
			end
		end
	end)
end

B.Handlers = {
	Collect = function(plr) B.Collect(plr) end,
	Place = function(plr, a, b) B.Place(plr, a, b) end,
	Remove = function(plr, a) B.Remove(plr, a) end,
	Move = function(plr, a, b) B.Move(plr, a, b) end,
	BuySlot = function(plr, a) B.BuySlot(plr, a) end,
	AutoPlace = function(plr) B.AutoPlace(plr) end,
}
return B
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Economy</string><ProtectedString name="Source"><![CDATA[-- Shop, upgrades, rebirth, zones, quests, daily rewards, settings
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local MPS = game:GetService("MarketplaceService")
local Config = require(RS.Config)
local Net = require(script.Parent.Net)
local Data = require(script.Parent.Data)
local Quests = require(script.Parent.Quests)
local Weapons = require(script.Parent.Weapons)
local Base = require(script.Parent.Base)

local E = {}
local RED, GREEN, GOLD = Color3.fromRGB(255, 110, 110), Color3.fromRGB(120, 255, 140), Color3.fromRGB(255, 208, 74)
local function fail(plr, t) Data.Notify(plr, t, RED) end
local last = {}

local H = {}
function H.Equip(plr, name)
	local d = Data.Get(plr); if not d or type(name) ~= "string" or not d.weapons[name] then return end
	d.equipped = name; Weapons.Give(plr); Data.Mark(plr)
end
function H.EquipBest(plr)
	local d = Data.Get(plr); if not d then return end
	local best
	for _, w in ipairs(Config.Weapons) do if d.weapons[w.name] then best = w.name end end
	if best then H.Equip(plr, best) end
end
function H.BuyWeapon(plr, name)
	local d = Data.Get(plr); local w = Config.WeaponByName[name]
	if not d or not w or d.weapons[name] then return end
	local key = w.cur
	if d[key] < w.cost then fail(plr, "Not enough " .. key .. "!"); return end
	d[key] = d[key] - w.cost
	d.weapons[name] = true; d.idxW[name] = true
	Quests.Add(plr, "weapon", 1)
	Data.Notify(plr, "New weapon: " .. name .. "!", Config.WColor[w.rarity], "unlock")
	if w.tier > Config.WeaponByName[d.equipped].tier then d.equipped = name; Weapons.Give(plr) end
	Data.Mark(plr)
end
function H.Upgrade(plr, id)
	local d = Data.Get(plr); local u = Config.UpgradeById[id]
	if not d or not u then return end
	local lvl = d.upg[id] or 0
	if lvl >= u.max then return end
	local cost = Config.UpgradeCost(u, lvl)
	if d.coins < cost then fail(plr, "Not enough coins!"); return end
	d.coins = d.coins - cost; d.upg[id] = lvl + 1
	Quests.Add(plr, "upgrade", 1)
	Net.FX:FireClient(plr, "upgrade")
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum.WalkSpeed = Weapons.Stats(plr).speed end
	if not (plr:GetAttribute("Reloading")) then Weapons.Reset(plr) end
	Data.Mark(plr)
end
function H.Rebirth(plr)
	local d = Data.Get(plr); if not d then return end
	local cost = Config.RebirthCost(d.rebirths)
	if d.coins < cost then fail(plr, "You need " .. Config.Fmt(cost) .. " coins to rebirth."); return end
	d.coins = 0; d.upg = {}; d.zones = {Forest = true}
	d.rebirths = d.rebirths + 1; d.rp = d.rp + 1; d.slots = math.min(Config.MaxSlots, d.slots + 1)
	d.gems = d.gems + 25
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum.WalkSpeed = Weapons.Stats(plr).speed end
	Weapons.Reset(plr)
	Net.FX:FireAllClients("rebirth", plr.Character and plr.Character:GetPivot().Position or Vector3.zero)
	Data.Notify(plr, "REBIRTH " .. d.rebirths .. "!  Coins x" .. (1 + 0.5 * d.rebirths), Color3.fromRGB(230, 150, 255), "unlock")
	Base.Render(plr); Data.Mark(plr)
end
function H.UnlockZone(plr, name)
	local d = Data.Get(plr); local z = Config.ZoneByName[name]
	if not d or not z or d.zones[name] then return end
	if d.coins < z.price then fail(plr, "Not enough coins! (" .. Config.Fmt(z.price) .. ")"); return end
	d.coins = d.coins - z.price; d.zones[name] = true
	Quests.Add(plr, "zone", 1)
	Net.FX:FireClient(plr, "zone", name)
	Data.Mark(plr)
end
function H.Teleport(plr, name)
	local d = Data.Get(plr); local char = plr.Character
	if not d or not char or type(name) ~= "string" then return end
	if last[plr] and os.clock() - last[plr] < 2 then return end
	last[plr] = os.clock()
	local pos
	if name == "Hub" then pos = Vector3.new(0, 5, 64)
	elseif name == "Base" then
		local plot = Base.plotOf[plr]; if not plot then return end
		pos = plot.Spawn.Position + Vector3.new(0, 4, 0)
	else
		local z = Config.ZoneByName[name]
		if not z or not d.zones[name] then fail(plr, "Zone locked!"); return end
		pos = z.inside + Vector3.new(0, 5, 0)
	end
	char:PivotTo(CFrame.new(pos))
end
function H.ClaimQuest(plr, id) if type(id) == "string" then Quests.Claim(plr, id) end end
function H.ClaimDaily(plr)
	local d = Data.Get(plr); if not d then return end
	local now = os.time()
	if now - d.daily.last < 86400 then fail(plr, "Come back later for your next reward!"); return end
	if now - d.daily.last >= 172800 then d.daily.streak = 0 end
	local r = Config.Daily[d.daily.streak % 7 + 1]
	d.coins = d.coins + (r.coins or 0); d.gems = d.gems + (r.gems or 0)
	d.daily.streak = d.daily.streak + 1; d.daily.last = now
	Data.Notify(plr, "Daily reward claimed!", GOLD, "quest")
	Data.Mark(plr)
end
function H.BuyCoins(plr, i)
	local d = Data.Get(plr); local p = Config.CoinPacks[i]
	if not d or not p then return end
	if d.gems < p.gems then fail(plr, "Not enough gems!"); return end
	d.gems = d.gems - p.gems; d.coins = d.coins + p.coins
	Data.Notify(plr, "+" .. Config.Fmt(p.coins) .. " coins", GOLD, "coin"); Data.Mark(plr)
end
function H.BuyGems(plr, i)
	local p = Config.GemPacks[i]; if not p then return end
	if p.product == 0 then Data.Notify(plr, "Set a Developer Product ID in Config.GemPacks to enable Robux purchases.", GOLD); return end
	MPS:PromptProductPurchase(plr, p.product)
end
function H.BuyBoost(plr, id)
	local d = Data.Get(plr); if not d then return end
	for _, b in ipairs(Config.Boosts) do
		if b.id == id then
			if d.gems < b.gems then fail(plr, "Not enough gems!"); return end
			d.gems = d.gems - b.gems
			d.boostMult = b.mult; d.boostUntil = math.max(os.time(), d.boostUntil) + b.dur
			Data.Notify(plr, b.name .. " activated!", GREEN, "unlock"); Base.Render(plr); Data.Mark(plr)
			return
		end
	end
end
function H.BuySpecial(plr, id)
	local d = Data.Get(plr); if not d then return end
	for _, s in ipairs(Config.Special) do
		if s.id == id then
			if d.gems < s.gems then fail(plr, "Not enough gems!"); return end
			if id == "slot" then
				if d.slots >= Config.MaxSlots then fail(plr, "All slots already unlocked!"); return end
				d.slots = d.slots + 1
			else
				d.coins = d.coins + math.floor(Base.Income(plr) * 600) + 100
			end
			d.gems = d.gems - s.gems
			Data.Notify(plr, s.name .. " purchased!", GREEN, "unlock"); Base.Render(plr); Data.Mark(plr)
			return
		end
	end
end
function H.Setting(plr, key, val)
	local d = Data.Get(plr)
	if not d or type(key) ~= "string" or d.settings[key] == nil or type(val) ~= "boolean" then return end
	d.settings[key] = val; Data.Mark(plr)
end
function H.Reload(plr) Weapons.Reload(plr) end

E.Handlers = H

MPS.ProcessReceipt = function(info)
	local plr = Players:GetPlayerByUserId(info.PlayerId)
	if not plr then return Enum.ProductPurchaseDecision.NotProcessedYet end
	local d = Data.Get(plr)
	if not d then return Enum.ProductPurchaseDecision.NotProcessedYet end
	for _, p in ipairs(Config.GemPacks) do
		if p.product ~= 0 and p.product == info.ProductId then
			d.gems = d.gems + p.gems
			Data.Notify(plr, "+" .. p.gems .. " gems!", Color3.fromRGB(220, 120, 255), "coin"); Data.Mark(plr)
			Data.Save(plr)
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end
return E
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX21"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX20"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX19"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Client: HUD, panels, shooting, animal animation, effects
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local TS = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")
local HttpService = game:GetService("HttpService")
local Debris = game:GetService("Debris")

local plr = Players.LocalPlayer
local Config = require(RS:WaitForChild("Config"))
local AnimalBuilder = require(RS:WaitForChild("AnimalBuilder"))
local WeaponBuilder = require(RS:WaitForChild("WeaponBuilder"))
local Remotes = RS:WaitForChild("Remotes")
local ActR, FireR, SyncR, NotifyR, FXR, UIR = Remotes:WaitForChild("Act"), Remotes:WaitForChild("Fire"), Remotes:WaitForChild("Sync"), Remotes:WaitForChild("Notify"), Remotes:WaitForChild("FX"), Remotes:WaitForChild("UI")
local cam = workspace.CurrentCamera
local H, fmt = Config.H, Config.Fmt
pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)

local D, serverOff = nil, 0
local function act(...) ActR:FireServer(...) end
local function nowT() return os.time() + serverOff end
local function isTouch() return UIS.TouchEnabled and not UIS.MouseEnabled end

-- ===== sounds =====
local sfxGroup = Instance.new("SoundGroup"); sfxGroup.Name = "SFX"; sfxGroup.Volume = 1; sfxGroup.Parent = SoundService
local function play(name, vol, pitch, parent)
	if D and D.settings and not D.settings.sfx then return end
	local id = Config.Sounds[name]; if not id or id == "" then return end
	local s = Instance.new("Sound"); s.SoundId = id; s.Volume = vol or 0.5; s.PlaybackSpeed = pitch or 1; s.SoundGroup = sfxGroup
	s.Parent = parent or SoundService; s:Play(); Debris:AddItem(s, 3)
end
local music
if Config.Sounds.music ~= "" then
	music = Instance.new("Sound"); music.SoundId = Config.Sounds.music; music.Looped = true; music.Volume = 0.25; music.Parent = SoundService; music:Play()
end

-- ===== UI helpers =====
local function new(cls, props, parent)
	local i = Instance.new(cls)
	for k, v in pairs(props or {}) do i[k] = v end
	if parent then i.Parent = parent end
	return i
end
local function corner(p, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, p) end
local function stroke(p, c, t) return new("UIStroke", {Color = c, Thickness = t or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, p) end
local function grad(p, a, b, rot) return new("UIGradient", {Color = ColorSequence.new(a, b), Rotation = rot or 90}, p) end
local function txt(parent, props)
	local d = {BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, TextColor3 = Color3.new(1, 1, 1), TextSize = 18, TextStrokeTransparency = 0.35, TextStrokeColor3 = Color3.new(0, 0, 0)}
	for k, v in pairs(props) do d[k] = v end
	return new("TextLabel", d, parent)
end
local function clear(p) for _, c in ipairs(p:GetChildren()) do c:Destroy() end end
local function btn(parent, text, color, size, pos, cb, tsize)
	local b = new("TextButton", {Text = text, Font = Enum.Font.FredokaOne, TextSize = tsize or 18, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = color, Size = size, Position = pos or UDim2.new(), AutoButtonColor = false, TextStrokeTransparency = 0.4}, parent)
	corner(b, 9); stroke(b, color:Lerp(Color3.new(0, 0, 0), 0.65), 2); grad(b, Color3.new(1, 1, 1), Color3.fromRGB(185, 185, 195), 90)
	local us = new("UIScale", {Scale = 1}, b)
	b.MouseButton1Down:Connect(function() TS:Create(us, TweenInfo.new(0.07), {Scale = 0.92}):Play() end)
	local function up() TS:Create(us, TweenInfo.new(0.12, Enum.EasingStyle.Back), {Scale = 1}):Play() end
	b.MouseButton1Up:Connect(up); b.MouseLeave:Connect(up)
	b.Activated:Connect(function() play("click", 0.4, 1.2); if cb then cb() end end)
	return b
end
local function scroller(parent, size, pos, cell, pad)
	local sf = new("ScrollingFrame", {Name = "Scroll", Size = size, Position = pos, BackgroundColor3 = Color3.fromRGB(18, 24, 60), BackgroundTransparency = 0.25, BorderSizePixel = 0, ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, parent)
	corner(sf, 10)
	if cell then new("UIGridLayout", {CellSize = cell, CellPadding = UDim2.fromOffset(pad or 8, pad or 8), SortOrder = Enum.SortOrder.LayoutOrder}, sf) end
	new("UIPadding", {PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8)}, sf)
	return sf
end
local function bar(parent, size, pos, frac, color)
	local bg = new("Frame", {Size = size, Position = pos, BackgroundColor3 = Color3.fromRGB(10, 14, 36)}, parent); corner(bg, 6); stroke(bg, Color3.fromRGB(60, 80, 150), 1.5)
	local fill = new("Frame", {Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1), BackgroundColor3 = color or H"3CCB46"}, bg); corner(fill, 6)
	grad(fill, Color3.new(1, 1, 1), Color3.fromRGB(180, 180, 180), 90)
	return bg, fill
end

-- ===== root gui =====
local gui = new("ScreenGui", {Name = "GameUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 5}, plr:WaitForChild("PlayerGui"))
local uiS = 1
local scaled = {}
local panels = {}
local function rescale()
	local v = cam.ViewportSize
	uiS = math.clamp(math.min(v.X / 1100, v.Y / 600), 0.5, 1.25)
	for _, s in ipairs(scaled) do s.Scale = uiS end
	for _, p in pairs(panels) do if p.frame.Visible then p.scale.Scale = uiS end end
end
rescale(); cam:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
local function cluster(anchor, pos, size)
	local f = new("Frame", {AnchorPoint = anchor, Position = pos, Size = size, BackgroundTransparency = 1}, gui)
	local us = new("UIScale", {Scale = uiS}, f); scaled[#scaled + 1] = us
	return f
end

-- ===== model views / tiles =====
local modelCache = {}
local function getModel(kind, name)
	local key = kind .. name
	if not modelCache[key] then
		modelCache[key] = kind == "animal" and AnimalBuilder.build(Config.AnimalByName[name]) or WeaponBuilder.build(Config.WeaponByName[name])
	end
	return modelCache[key]
end
local function viewport(parent, kind, name)
	local vf = new("ViewportFrame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Ambient = Color3.fromRGB(180, 180, 195), LightColor = Color3.fromRGB(255, 250, 240), LightDirection = Vector3.new(-0.5, -1, -0.6)}, parent)
	local m = getModel(kind, name):Clone(); m.Parent = vf
	local cf, sz = m:GetBoundingBox()
	local dim = math.max(sz.X, sz.Y, sz.Z)
	local c = new("Camera", {FieldOfView = 35}, vf); vf.CurrentCamera = c
	local dir = kind == "animal" and Vector3.new(-0.75, 0.4, -1) or Vector3.new(1, 0.25, 0.2)
	c.CFrame = CFrame.lookAt(cf.Position + dir.Unit * dim * 1.9, cf.Position)
	return vf
end
local function defOf(kind, name) return kind == "animal" and Config.AnimalByName[name] or Config.WeaponByName[name] end
local function colOf(kind, rarity) return (kind == "animal" and Config.AColor or Config.WColor)[rarity] end
local function tile(parent, kind, name, o)
	o = o or {}
	local def = defOf(kind, name)
	local col = colOf(kind, def.rarity)
	local f = new("Frame", {Size = o.size or UDim2.fromOffset(88, 106), BackgroundColor3 = col:Lerp(Color3.fromRGB(14, 18, 48), 0.6), LayoutOrder = o.order or 0}, parent)
	corner(f, 10); stroke(f, o.locked and Color3.fromRGB(80, 86, 120) or col, 2.5); grad(f, Color3.new(1, 1, 1), Color3.fromRGB(165, 165, 185), 90)
	local vp = new("Frame", {Size = UDim2.new(1, -8, 1, -38), Position = UDim2.fromOffset(4, 3), BackgroundTransparency = 1}, f)
	if o.locked then txt(vp, {Size = UDim2.fromScale(1, 1), Text = "?", TextSize = 42, TextColor3 = Color3.fromRGB(150, 156, 190)})
	else viewport(vp, kind, name) end
	local nl = txt(f, {Size = UDim2.new(1, -6, 0, 17), Position = UDim2.new(0, 3, 1, -34), Text = o.locked and "???" or name, TextScaled = true})
	new("UITextSizeConstraint", {MaxTextSize = 14, MinTextSize = 7}, nl)
	local tag = new("Frame", {Size = UDim2.new(1, -10, 0, 15), Position = UDim2.new(0, 5, 1, -17), BackgroundColor3 = o.locked and Color3.fromRGB(70, 76, 110) or col}, f); corner(tag, 5)
	local tl = txt(tag, {Size = UDim2.fromScale(1, 1), Text = o.sub or def.rarity, TextScaled = true})
	new("UITextSizeConstraint", {MaxTextSize = 11, MinTextSize = 6}, tl)
	if o.count and o.count > 0 then
		local b = new("Frame", {Size = UDim2.fromOffset(28, 18), Position = UDim2.new(1, -30, 0, 3), BackgroundColor3 = Color3.fromRGB(20, 24, 56)}, f); corner(b, 6)
		txt(b, {Size = UDim2.fromScale(1, 1), Text = "x" .. o.count, TextSize = 12})
	end
	if o.badge then
		local b = new("Frame", {Size = UDim2.fromOffset(60, 17), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = o.badgeColor or H"3CCB46"}, f); corner(b, 6)
		txt(b, {Size = UDim2.fromScale(1, 1), Text = o.badge, TextSize = 11})
	end
	if o.selected then stroke(f, Color3.new(1, 1, 1), 3) end
	if o.onClick then
		local c = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5}, f)
		c.Activated:Connect(function() play("click", 0.4, 1.2); o.onClick() end)
	end
	return f
end

-- ===== panels =====
local current = nil
local refreshers, sigKeys = {}, {}
local function makePanel(id, title, icon, w, h, accent)
	accent = accent or H"4C86F0"
	local f = new("Frame", {Name = id, Size = UDim2.fromOffset(w, h), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(34, 42, 92), Visible = false, ZIndex = 10}, gui)
	corner(f, 14); stroke(f, accent, 3); grad(f, Color3.fromRGB(52, 62, 128), Color3.fromRGB(26, 32, 74), 90)
	local us = new("UIScale", {Scale = uiS}, f)
	txt(f, {Size = UDim2.new(1, -90, 0, 40), Position = UDim2.fromOffset(46, 4), Text = title, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Left})
	txt(f, {Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(6, 4), Text = icon, TextSize = 28})
	local body = new("Frame", {Name = "Body", Size = UDim2.new(1, -16, 1, -54), Position = UDim2.fromOffset(8, 46), BackgroundTransparency = 1}, f)
	local p = {frame = f, scale = us, body = body, id = id}
	panels[id] = p
	local x = btn(f, "X", H"E8343A", UDim2.fromOffset(34, 34), UDim2.new(1, -42, 0, 6), function() p.close() end, 20)
	return p
end
local sigFor
local function rebuild(id)
	local p = panels[id]; local r = refreshers[id]
	if not p or not r then return end
	local saved = {}
	for _, d in ipairs(p.body:GetDescendants()) do if d:IsA("ScrollingFrame") then saved[d.Name] = d.CanvasPosition end end
	clear(p.body)
	r(p.body)
	for _, d in ipairs(p.body:GetDescendants()) do if d:IsA("ScrollingFrame") and saved[d.Name] then d.CanvasPosition = saved[d.Name] end end
end
local function closePanel(id, instant)
	local p = panels[id]; if not p or not p.frame.Visible then return end
	if current == id then current = nil end
	if instant then p.frame.Visible = false; return end
	local tw = TS:Create(p.scale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.6 * uiS}); tw:Play()
	tw.Completed:Connect(function() if current ~= id then p.frame.Visible = false end end)
end
local function openPanel(id)
	local p = panels[id]; if not p then return end
	if current and current ~= id then closePanel(current, true) end
	if panels.info then panels.info.frame.Visible = false end
	current = id
	rebuild(id)
	p.sig = sigFor(id)
	p.scale.Scale = 0.6 * uiS; p.frame.Visible = true
	TS:Create(p.scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = uiS}):Play()
	play("click", 0.4, 0.9)
end
local function togglePanel(id) if current == id and panels[id].frame.Visible then closePanel(id) else openPanel(id) end end
local function newPanel(id, title, icon, w, h, accent, keys, refresh)
	local p = makePanel(id, title, icon, w, h, accent)
	p.close = function() closePanel(id) end
	refreshers[id] = refresh; sigKeys[id] = keys
	p.sig = nil
	return p
end
sigFor = function(id)
	local t = {}
	for _, k in ipairs(sigKeys[id] or {}) do t[#t + 1] = D[k] end
	local ok, s = pcall(function() return HttpService:JSONEncode(t) end)
	return ok and s or tostring(os.clock())
end

local function owned(name) return D and D.animals[name] or 0 end
local function placedCount(name)
	local n = 0
	for _, v in pairs(D.placed) do if v == name then n = n + 1 end end
	return n
end
local function availCount(name) return owned(name) - placedCount(name) end
local function firstEmptySlot()
	for j = 1, D.slots do if not D.placed[tostring(j)] then return j end end
end

-- ===== toasts (forward) =====
local toast, catchPopup, zoneBanner

-- ===== info popup =====
local info = makePanel("info", "Info", "ℹ️", 300, 372, H"FFD04A")
info.frame.ZIndex = 30
info.close = function() info.frame.Visible = false end
local function showInfo(kind, name)
	if not D then return end
	local p = panels.info; clear(p.body)
	local def = defOf(kind, name); local col = colOf(kind, def.rarity)
	local vfr = new("Frame", {Size = UDim2.new(1, 0, 0, 130), BackgroundColor3 = col:Lerp(Color3.fromRGB(14, 18, 48), 0.6)}, p.body)
	corner(vfr, 12); stroke(vfr, col, 2.5); viewport(vfr, kind, name)
	txt(p.body, {Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 134), Text = name, TextSize = 24, TextColor3 = col})
	local chip = new("Frame", {Size = UDim2.fromOffset(110, 20), Position = UDim2.new(0.5, -55, 0, 164), BackgroundColor3 = col}, p.body); corner(chip, 6)
	txt(chip, {Size = UDim2.fromScale(1, 1), Text = def.rarity, TextSize = 14})
	local lines = {}
	if kind == "animal" then
		lines = {"📍 Zone: " .. def.zone, "💰 Income: " .. fmt(def.income) .. "/s", "❤ HP: " .. fmt(def.hp), "🐾 Owned: " .. owned(name) .. "  (placed " .. placedCount(name) .. ")"}
	else
		local st = Config.Stats(def, D.upg)
		lines = {"💥 Damage: " .. fmt(math.floor(st.dmg)) .. (def.pellets > 1 and (" x" .. def.pellets) or ""), "⚡ Fire rate: " .. string.format("%.1f", st.rate) .. "/s", "🧰 Ammo: " .. st.mag, "🔄 Reload: " .. string.format("%.1f", st.reload) .. "s", "🎯 Range: " .. math.floor(st.range)}
	end
	for i, l in ipairs(lines) do txt(p.body, {Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 190 + (i - 1) * 19), Text = l, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left}) end
	local by = 190 + #lines * 19 + 6
	if kind == "animal" then
		if availCount(name) > 0 then
			btn(p.body, "Place in Base", H"2FBF3A", UDim2.new(1, 0, 0, 36), UDim2.fromOffset(0, by), function()
				local j = firstEmptySlot()
				if j then act("Place", name, j); p.close() else toast("No free slot! Unlock more slots in your base.", Color3.fromRGB(255, 130, 130)) end
			end)
		end
	else
		if D.weapons[name] then
			if D.equipped == name then txt(p.body, {Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, by), Text = "✔ Equipped", TextSize = 20, TextColor3 = H"7CFF8A"})
			else btn(p.body, "Equip", H"2FBF3A", UDim2.new(1, 0, 0, 36), UDim2.fromOffset(0, by), function() act("Equip", name); p.close() end) end
		else
			local can = D[def.cur] >= def.cost
			btn(p.body, "Buy  " .. (def.cur == "gems" and "💎 " or "🪙 ") .. fmt(def.cost), can and H"2FBF3A" or H"6A6F88", UDim2.new(1, 0, 0, 36), UDim2.fromOffset(0, by), function() act("BuyWeapon", name); p.close() end)
		end
	end
	p.scale.Scale = 0.7 * uiS; p.frame.Visible = true
	TS:Create(p.scale, TweenInfo.new(0.2, Enum.EasingStyle.Back), {Scale = uiS}):Play()
end

-- ===== Weapon inventory =====
newPanel("weapons", "Inventory", "🔫", 520, 350, H"4C86F0", {"weapons", "equipped", "upg"}, function(body)
	local sf = scroller(body, UDim2.new(1, 0, 1, -44), UDim2.new(), UDim2.fromOffset(94, 110), 8)
	local n = 0
	for i, w in ipairs(Config.Weapons) do
		if D.weapons[w.name] then
			n = n + 1
			tile(sf, "weapon", w.name, {size = UDim2.fromOffset(94, 110), order = i, badge = D.equipped == w.name and "EQUIPPED" or nil, onClick = function() showInfo("weapon", w.name) end})
		end
	end
	for i = n + 1, #Config.Weapons do
		local e = new("Frame", {Size = UDim2.fromOffset(94, 110), BackgroundColor3 = Color3.fromRGB(34, 40, 84), LayoutOrder = 100 + i}, sf); corner(e, 10); stroke(e, Color3.fromRGB(60, 70, 120), 2)
	end
	txt(body, {Size = UDim2.fromOffset(200, 34), Position = UDim2.new(0, 4, 1, -38), Text = "Weapons: " .. n .. "/" .. #Config.Weapons, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left})
	btn(body, "Equip Best", H"2FBF3A", UDim2.fromOffset(150, 34), UDim2.new(1, -150, 1, -38), function() act("EquipBest") end)
end)

-- ===== Animals collection =====
newPanel("animals", "Animals", "🐾", 520, 350, H"3AB8FF", {"animals", "placed"}, function(body)
	local sf = scroller(body, UDim2.new(1, 0, 1, -44), UDim2.new(), UDim2.fromOffset(94, 110), 8)
	local total, kinds = 0, 0
	for i, a in ipairs(Config.Animals) do
		local n = owned(a.name)
		if n > 0 then
			total = total + n; kinds = kinds + 1
			tile(sf, "animal", a.name, {size = UDim2.fromOffset(94, 110), order = i, count = n, badge = placedCount(a.name) > 0 and ("🏠 " .. placedCount(a.name)) or nil, badgeColor = H"2E7BE8", onClick = function() showInfo("animal", a.name) end})
		end
	end
	if total == 0 then txt(sf, {Size = UDim2.new(1, 0, 0, 120), Text = "No animals yet.\nGo hunt in the Forest Zone!", TextSize = 22}) end
	txt(body, {Size = UDim2.fromOffset(260, 34), Position = UDim2.new(0, 4, 1, -38), Text = "Animals: " .. total .. "  (" .. kinds .. " kinds)", TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left})
	btn(body, "Auto Place", H"2FBF3A", UDim2.fromOffset(150, 34), UDim2.new(1, -150, 1, -38), function() act("AutoPlace") end)
end)

-- ===== Base GUI =====
local baseUI = {}
local selAnimal, selSlot
newPanel("base", "My Base", "🏠", 668, 412, H"34C759", {"animals", "placed", "slots", "coins", "rebirths", "boostUntil"}, function(body)
	local grid = new("Frame", {Size = UDim2.fromOffset(372, 272), BackgroundColor3 = Color3.fromRGB(18, 24, 60), BackgroundTransparency = 0.25}, body); corner(grid, 10)
	new("UIGridLayout", {CellSize = UDim2.fromOffset(84, 80), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder}, grid)
	new("UIPadding", {PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8)}, grid)
	for j = 1, Config.MaxSlots do
		local name = D.placed[tostring(j)]
		local cell = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(36, 44, 96), LayoutOrder = j}, grid); corner(cell, 10)
		local st = stroke(cell, Color3.fromRGB(70, 84, 150), 2)
		if j > D.slots then
			cell.BackgroundColor3 = Color3.fromRGB(28, 30, 56)
			txt(cell, {Size = UDim2.new(1, 0, 0.55, 0), Text = "🔒", TextSize = 26})
			txt(cell, {Size = UDim2.new(1, 0, 0.4, 0), Position = UDim2.fromScale(0, 0.55), Text = j == D.slots + 1 and ("🪙 " .. fmt(Config.SlotCost(j))) or "Locked", TextSize = 13, TextColor3 = j == D.slots + 1 and H"FFD04A" or Color3.fromRGB(150, 150, 170)})
		elseif name then
			local a = Config.AnimalByName[name]
			st.Color = Config.AColor[a.rarity]; st.Thickness = 2.5
			local vp = new("Frame", {Size = UDim2.new(1, -6, 1, -20), Position = UDim2.fromOffset(3, 2), BackgroundTransparency = 1}, cell); viewport(vp, "animal", name)
			local nl = txt(cell, {Size = UDim2.new(1, -4, 0, 16), Position = UDim2.new(0, 2, 1, -18), Text = name, TextScaled = true, TextColor3 = Config.AColor[a.rarity]})
			new("UITextSizeConstraint", {MaxTextSize = 12, MinTextSize = 6}, nl)
			if selSlot == j then st.Color = Color3.new(1, 1, 1); st.Thickness = 3.5 end
		else
			txt(cell, {Size = UDim2.fromScale(1, 1), Text = (selAnimal or selSlot) and "＋" or "Empty", TextSize = (selAnimal or selSlot) and 34 or 14, TextColor3 = (selAnimal or selSlot) and H"7CFF8A" or Color3.fromRGB(130, 136, 170)})
		end
		cell.Activated:Connect(function()
			play("click", 0.4, 1.2)
			if j > D.slots then
				if j == D.slots + 1 then act("BuySlot", j) else toast("Unlock the previous slots first!", Color3.fromRGB(255, 130, 130)) end
			elseif name then
				selSlot = (selSlot == j) and nil or j; selAnimal = nil; rebuild("base")
			elseif selSlot then act("Move", selSlot, j); selSlot = nil
			elseif selAnimal then
				act("Place", selAnimal, j)
				if availCount(selAnimal) <= 1 then selAnimal = nil end
			else toast("Pick an animal from the list first.", Color3.fromRGB(255, 220, 120)) end
		end)
	end
	-- available animals list
	local list = scroller(body, UDim2.fromOffset(256, 272), UDim2.fromOffset(380, 0), nil)
	new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, list)
	local names = {}
	for _, a in ipairs(Config.Animals) do if availCount(a.name) > 0 then names[#names + 1] = a end end
	table.sort(names, function(a, b) return a.income > b.income end)
	if #names == 0 then txt(list, {Size = UDim2.new(1, 0, 0, 80), Text = "No spare animals.\nHunt more!", TextSize = 18}) end
	for i, a in ipairs(names) do
		local row = new("TextButton", {Text = "", AutoButtonColor = false, Size = UDim2.new(1, -4, 0, 50), BackgroundColor3 = Color3.fromRGB(36, 44, 96), LayoutOrder = i}, list); corner(row, 8)
		stroke(row, selAnimal == a.name and Color3.new(1, 1, 1) or Config.AColor[a.rarity], selAnimal == a.name and 3 or 2)
		local vp = new("Frame", {Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(3, 3), BackgroundTransparency = 1}, row); viewport(vp, "animal", a.name)
		txt(row, {Size = UDim2.new(1, -100, 0, 20), Position = UDim2.fromOffset(52, 4), Text = a.name, TextSize = 15, TextColor3 = Config.AColor[a.rarity], TextXAlignment = Enum.TextXAlignment.Left})
		txt(row, {Size = UDim2.new(1, -100, 0, 18), Position = UDim2.fromOffset(52, 26), Text = "💰 " .. fmt(a.income) .. "/s", TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
		txt(row, {Size = UDim2.fromOffset(40, 24), Position = UDim2.new(1, -44, 0.5, -12), Text = "x" .. availCount(a.name), TextSize = 16})
		row.Activated:Connect(function() play("click", 0.4, 1.2); selAnimal = (selAnimal == a.name) and nil or a.name; selSlot = nil; rebuild("base") end)
	end
	baseUI.pending = txt(body, {Size = UDim2.fromOffset(300, 30), Position = UDim2.fromOffset(2, 280), Text = "", TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left})
	baseUI.hint = txt(body, {Size = UDim2.fromOffset(372, 22), Position = UDim2.fromOffset(2, 308), Text = selSlot and "Tap an empty slot to move it, or Remove." or (selAnimal and ("Selected: " .. selAnimal .. " - tap an empty slot") or "Select an animal, then tap an empty slot."), TextSize = 13, TextColor3 = Color3.fromRGB(190, 200, 240), TextXAlignment = Enum.TextXAlignment.Left})
	btn(body, "Collect 💰", H"2FBF3A", UDim2.fromOffset(150, 36), UDim2.fromOffset(380, 280), function() act("Collect") end)
	if selSlot then btn(body, "Remove", H"E8343A", UDim2.fromOffset(94, 36), UDim2.fromOffset(536, 280), function() act("Remove", selSlot); selSlot = nil end)
	else btn(body, "Auto", H"2E7BE8", UDim2.fromOffset(94, 36), UDim2.fromOffset(536, 280), function() act("AutoPlace") end) end
end)
local function updateBasePending()
	if baseUI.pending and baseUI.pending.Parent and D then
		baseUI.pending.Text = "💰 Pending: " .. fmt(math.floor(D.pending or 0)) .. "  (+" .. fmt(D.income or 0) .. "/s)"
	end
end

-- ===== Index =====
local indexTab = "animals"
newPanel("index", "Index", "📖", 640, 410, H"4C86F0", {"idxA", "idxW", "zones"}, function(body)
	local tabs = {{"animals", "🐾 Animals"}, {"weapons", "🔫 Weapons"}, {"zones", "📍 Zones"}}
	for i, t in ipairs(tabs) do
		btn(body, t[2], indexTab == t[1] and H"3AA0FF" or H"3A4478", UDim2.fromOffset(110, 44), UDim2.fromOffset(0, (i - 1) * 52), function() indexTab = t[1]; rebuild("index") end, 16)
	end
	local cx = 118
	local frac, label
	if indexTab == "animals" then
		local sf = scroller(body, UDim2.new(1, -cx, 1, -46), UDim2.fromOffset(cx, 0), UDim2.fromOffset(94, 108), 8)
		local n = 0
		for i, a in ipairs(Config.Animals) do
			local have = D.idxA[a.name]
			if have then n = n + 1 end
			tile(sf, "animal", a.name, {size = UDim2.fromOffset(94, 108), order = i, locked = not have, sub = have and (fmt(a.income) .. "/s") or a.rarity, onClick = have and function() showInfo("animal", a.name) end or nil})
		end
		frac, label = n / #Config.Animals, "Collected: " .. n .. "/" .. #Config.Animals
	elseif indexTab == "weapons" then
		local sf = scroller(body, UDim2.new(1, -cx, 1, -46), UDim2.fromOffset(cx, 0), UDim2.fromOffset(94, 108), 8)
		local n = 0
		for i, w in ipairs(Config.Weapons) do
			local have = D.idxW[w.name]
			if have then n = n + 1 end
			tile(sf, "weapon", w.name, {size = UDim2.fromOffset(94, 108), order = i, locked = not have, sub = w.rarity, onClick = function() showInfo("weapon", w.name) end})
		end
		frac, label = n / #Config.Weapons, "Collected: " .. n .. "/" .. #Config.Weapons
	else
		local sf = scroller(body, UDim2.new(1, -cx, 1, -46), UDim2.fromOffset(cx, 0), nil)
		new("UIListLayout", {Padding = UDim.new(0, 8)}, sf)
		local all, got = 0, 0
		for _, z in ipairs(Config.Zones) do
			local n, tot = 0, #Config.ZoneAnimals[z.name]
			for _, a in ipairs(Config.ZoneAnimals[z.name]) do if D.idxA[a.name] then n = n + 1 end end
			all = all + tot; got = got + n
			local row = new("Frame", {Size = UDim2.new(1, -6, 0, 56), BackgroundColor3 = z.color:Lerp(Color3.fromRGB(14, 18, 48), 0.65)}, sf); corner(row, 10); stroke(row, z.color, 2)
			txt(row, {Size = UDim2.new(0.5, 0, 0, 26), Position = UDim2.fromOffset(10, 4), Text = z.icon .. " " .. z.name .. " Zone", TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left})
			bar(row, UDim2.new(1, -20, 0, 14), UDim2.new(0, 10, 1, -22), n / tot, z.color)
			txt(row, {Size = UDim2.fromOffset(80, 26), Position = UDim2.new(1, -90, 0, 4), Text = n .. "/" .. tot, TextSize = 18})
		end
		frac, label = got / all, "Animals found: " .. got .. "/" .. all
	end
	txt(body, {Size = UDim2.fromOffset(190, 30), Position = UDim2.new(0, cx, 1, -34), Text = label, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left})
	bar(body, UDim2.new(1, -cx - 200, 0, 18), UDim2.new(0, cx + 196, 1, -28), frac, H"3AB8FF")
end)

-- ===== Shop =====
local shopTab = "coins"
local function boostLeft() return math.max(0, (D.boostUntil or 0) - nowT()) end
local function mmss(s) return string.format("%02d:%02d", math.floor(s / 60), s % 60) end
newPanel("shop", "Shop", "🛒", 650, 410, H"FFB020", {"coins", "gems", "weapons", "equipped", "boostUntil", "slots", "upg"}, function(body)
	local tabs = {{"coins", "🪙 Coins", H"E8B420"}, {"gems", "💎 Gems", H"A050F0"}, {"boosts", "⭐ Boosts", H"3A4478"}, {"weapons", "🔫 Weapons", H"3A4478"}, {"special", "🎁 Special", H"3A4478"}}
	for i, t in ipairs(tabs) do
		btn(body, t[2], shopTab == t[1] and t[3] or H"3A4478", UDim2.fromOffset(112, 46), UDim2.fromOffset(0, (i - 1) * 54), function() shopTab = t[1]; rebuild("shop") end, 16)
	end
	local sf = scroller(body, UDim2.new(1, -120, 1, 0), UDim2.fromOffset(120, 0), UDim2.fromOffset(152, 176), 8)
	local function card(title, c, order) 
		local f = new("Frame", {BackgroundColor3 = c:Lerp(Color3.fromRGB(14, 18, 48), 0.55), LayoutOrder = order}, sf); corner(f, 12); stroke(f, c, 2.5); grad(f, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 190), 90)
		txt(f, {Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 4), Text = title, TextSize = 17})
		return f
	end
	if shopTab == "coins" then
		for i, p in ipairs(Config.CoinPacks) do
			local f = card("Coins Pack", H"E8B420", i)
			txt(f, {Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 36), Text = "🪙\n" .. fmt(p.coins), TextSize = 26, TextColor3 = H"FFD04A"})
			btn(f, "💎 " .. p.gems, D.gems >= p.gems and H"2FBF3A" or H"6A6F88", UDim2.new(1, -16, 0, 34), UDim2.new(0, 8, 1, -44), function() act("BuyCoins", i) end)
		end
	elseif shopTab == "gems" then
		for i, p in ipairs(Config.GemPacks) do
			local f = card("Gems Pack", H"A050F0", i)
			txt(f, {Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 36), Text = "💎\n" .. fmt(p.gems), TextSize = 26, TextColor3 = H"E8A0FF"})
			btn(f, "R$ " .. p.robux, H"2FBF3A", UDim2.new(1, -16, 0, 34), UDim2.new(0, 8, 1, -44), function() act("BuyGems", i) end)
		end
	elseif shopTab == "boosts" then
		for i, b in ipairs(Config.Boosts) do
			local f = card(b.name, H"FFB020", i)
			txt(f, {Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 34), Text = "⭐ x" .. b.mult .. "\n" .. b.desc, TextSize = 20})
			local left = boostLeft()
			txt(f, {Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 100), Text = left > 0 and ("Active: " .. mmss(left)) or "", TextSize = 14, TextColor3 = H"7CFF8A"})
			btn(f, "💎 " .. b.gems, D.gems >= b.gems and H"2FBF3A" or H"6A6F88", UDim2.new(1, -16, 0, 34), UDim2.new(0, 8, 1, -44), function() act("BuyBoost", b.id) end)
		end
	elseif shopTab == "weapons" then
		for i, w in ipairs(Config.Weapons) do
			local col = Config.WColor[w.rarity]
			local f = card(w.name, col, i)
			local vp = new("Frame", {Size = UDim2.new(1, -16, 0, 70), Position = UDim2.fromOffset(8, 28), BackgroundTransparency = 1}, f); viewport(vp, "weapon", w.name)
			txt(f, {Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 100), Text = w.rarity .. " • " .. fmt(w.dmg) .. " dmg", TextSize = 12, TextColor3 = col})
			if D.weapons[w.name] then
				if D.equipped == w.name then txt(f, {Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 1, -44), Text = "✔ Equipped", TextSize = 17, TextColor3 = H"7CFF8A"})
				else btn(f, "Equip", H"2E7BE8", UDim2.new(1, -16, 0, 34), UDim2.new(0, 8, 1, -44), function() act("Equip", w.name) end) end
			else
				local can = D[w.cur] >= w.cost
				btn(f, (w.cur == "gems" and "💎 " or "🪙 ") .. fmt(w.cost), can and H"2FBF3A" or H"6A6F88", UDim2.new(1, -16, 0, 34), UDim2.new(0, 8, 1, -44), function() act("BuyWeapon", w.name) end, 16)
			end
		end
	else
		for i, s in ipairs(Config.Special) do
			local f = card(s.name, H"3AB8FF", i)
			txt(f, {Size = UDim2.new(1, -8, 0, 70), Position = UDim2.fromOffset(4, 34), Text = (s.id == "slot" and "🏠" or "💰") .. "\n" .. s.desc, TextSize = 18})
			btn(f, "💎 " .. s.gems, D.gems >= s.gems and H"2FBF3A" or H"6A6F88", UDim2.new(1, -16, 0, 34), UDim2.new(0, 8, 1, -44), function() act("BuySpecial", s.id) end)
		end
	end
end)

-- ===== Upgrades =====
newPanel("upgrades", "Upgrades", "⬆️", 480, 380, H"3AB8FF", {"coins", "upg"}, function(body)
	local sf = scroller(body, UDim2.fromScale(1, 1), UDim2.new(), nil)
	new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, sf)
	for i, u in ipairs(Config.Upgrades) do
		local lvl = D.upg[u.id] or 0
		local row = new("Frame", {Size = UDim2.new(1, -6, 0, 58), BackgroundColor3 = Color3.fromRGB(32, 40, 90), LayoutOrder = i}, sf); corner(row, 10); stroke(row, Color3.fromRGB(70, 90, 170), 2)
		txt(row, {Size = UDim2.fromOffset(46, 46), Position = UDim2.fromOffset(6, 6), Text = u.icon, TextSize = 30})
		txt(row, {Size = UDim2.new(1, -190, 0, 22), Position = UDim2.fromOffset(56, 5), Text = u.name, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left})
		local bonus = u.id == "speed" and ("+" .. string.format("%.1f", u.per * lvl) .. u.unit) or ("+" .. string.format("%.1f", u.per * lvl * 100):gsub("%.0$", "") .. u.unit)
		txt(row, {Size = UDim2.new(1, -190, 0, 16), Position = UDim2.fromOffset(56, 27), Text = "Lv. " .. lvl .. "/" .. u.max .. "   " .. bonus, TextSize = 13, TextColor3 = Color3.fromRGB(190, 205, 255), TextXAlignment = Enum.TextXAlignment.Left})
		bar(row, UDim2.new(1, -200, 0, 7), UDim2.fromOffset(56, 46), lvl / u.max, H"3AB8FF")
		if lvl >= u.max then txt(row, {Size = UDim2.fromOffset(110, 36), Position = UDim2.new(1, -118, 0.5, -18), Text = "MAX", TextSize = 20, TextColor3 = H"FFD04A"})
		else
			local cost = Config.UpgradeCost(u, lvl)
			btn(row, fmt(cost), D.coins >= cost and H"2FBF3A" or H"6A6F88", UDim2.fromOffset(112, 38), UDim2.new(1, -120, 0.5, -19), function() act("Upgrade", u.id) end, 17)
		end
	end
end)

-- ===== Rebirth =====
local rebirthConfirm = false
newPanel("rebirth", "Rebirth", "♻️", 420, 400, H"B050F0", {"coins", "rebirths"}, function(body)
	local cost = Config.RebirthCost(D.rebirths)
	txt(body, {Size = UDim2.new(1, 0, 0, 24), Text = "Rebirths: " .. D.rebirths .. "   (Coins x" .. (1 + 0.5 * D.rebirths) .. ")", TextSize = 20})
	txt(body, {Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 28), Text = "Requirement: 🪙 " .. fmt(D.coins) .. " / " .. fmt(cost), TextSize = 16, TextColor3 = D.coins >= cost and H"7CFF8A" or H"FF9A9A"})
	bar(body, UDim2.new(1, -20, 0, 14), UDim2.fromOffset(10, 52), D.coins / cost, H"B050F0")
	local rw = new("Frame", {Size = UDim2.new(1, 0, 0, 120), Position = UDim2.fromOffset(0, 76), BackgroundColor3 = Color3.fromRGB(26, 24, 70), BackgroundTransparency = 0.2}, body); corner(rw, 10)
	local lines = {"⭐ Coins x" .. (1 + 0.5 * (D.rebirths + 1)) .. " (+50% permanent)", "♻️ +1 Rebirth Point", "🏠 +1 free base slot", "💎 +25 gems", "🆕 New abilities & prestige"}
	for i, l in ipairs(lines) do txt(rw, {Size = UDim2.new(1, -14, 0, 21), Position = UDim2.fromOffset(10, 4 + (i - 1) * 22), Text = l, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = H"FFE890"}) end
	local ls = new("Frame", {Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 202), BackgroundColor3 = Color3.fromRGB(70, 24, 34), BackgroundTransparency = 0.3}, body); corner(ls, 10)
	txt(ls, {Size = UDim2.new(1, -14, 1, 0), Position = UDim2.fromOffset(8, 0), Text = "You will RESET: coins, weapon upgrades, unlocked zones.\nYou KEEP: animals, weapons, index, rebirth bonuses.", TextSize = 14, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left})
	btn(body, "Rebirth!", D.coins >= cost and H"2FBF3A" or H"6A6F88", UDim2.new(1, -20, 0, 48), UDim2.fromOffset(10, 284), function()
		if D.coins < cost then toast("You need " .. fmt(cost) .. " coins!", Color3.fromRGB(255, 130, 130)); return end
		rebirthConfirm = true; rebuild("rebirth")
	end, 24)
	if rebirthConfirm then
		local ov = new("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(10, 10, 30), BackgroundTransparency = 0.1, ZIndex = 20}, body); corner(ov, 10)
		txt(ov, {Size = UDim2.new(1, -20, 0, 120), Position = UDim2.fromOffset(10, 50), Text = "Are you sure?\n\nCoins, upgrades and zones will reset.\nYou get permanent bonuses!", TextSize = 20, ZIndex = 21})
		btn(ov, "Confirm", H"2FBF3A", UDim2.fromOffset(150, 46), UDim2.new(0.5, -160, 0, 220), function() rebirthConfirm = false; act("Rebirth"); closePanel("rebirth") end, 20).ZIndex = 21
		btn(ov, "Cancel", H"E8343A", UDim2.fromOffset(150, 46), UDim2.new(0.5, 10, 0, 220), function() rebirthConfirm = false; rebuild("rebirth") end, 20).ZIndex = 21
	end
end)

