="CFrame"><X>-242.5</X><Y>3</Y><Z>-49.38268590217984</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="Size"><X>2</X><Y>5</Y><Z>2</Z></Vector3><int name="BrickColor">1001</int><token name="Material">256</token><token name="Shape">1</token><float name="Transparency">0</float><float name="Reflectance">0</float><bool name="CastShadow">true</bool></Properties></Item><Item class="Part"><Properties><string name="Name">BaseDecoration_9</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">true</bool><bool name="CanQuery">true</bool><CoordinateFrame name="CFrame"><X>-229.0</X><Y>3</Y><Z>-53.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="Size"><X>2</X><Y>5</Y><Z>2</Z></Vector3><int name="BrickColor">1001</int><token name="Material">256</token><token name="Shape">1</token><float name="Transparency">0</float><float name="Reflectance">0</float><bool name="CastShadow">true</bool></Properties></Item><Item class="Part"><Properties><string name="Name">BaseDecoration_10</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">true</bool><bool name="CanQuery">true</bool><CoordinateFrame name="CFrame"><X>-215.5</X><Y>3</Y><Z>-49.382685902179844</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="Size"><X>2</X><Y>5</Y><Z>2</Z></Vector3><int name="BrickColor">1001</int><token name="Material">256</token><token name="Shape">1</token><float name="Transparency">0</float><float name="Reflectance">0</float><bool name="CastShadow">true</bool></Properties></Item><Item class="Part"><Properties><string name="Name">BaseDecoration_11</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">true</bool><bool name="CanQuery">true</bool><CoordinateFrame name="CFrame"><X>-205.61731409782016</X><Y>3</Y><Z>-39.500000000000014</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="Size"><X>2</X><Y>5</Y><Z>2</Z></Vector3><int name="BrickColor">1001</int><token name="Material">256</token><token name="Shape">1</token><float name="Transparency">0</float><float name="Reflectance">0</float><bool name="CastShadow">true</bool></Properties></Item></Item></Item><Item class="Folder"><Properties><string name="Name">LiveCrystals</string></Properties></Item></Item><Item class="ServerScriptService"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script"><Properties><string name="Name">CrystalGameServer</string><ProtectedString name="Source">
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local ADMIN = {[&quot;amin_12in2&quot;] = true}
local remotes = Instance.new(&quot;Folder&quot;); remotes.Name = &quot;CrystalRemotes&quot;; remotes.Parent = ReplicatedStorage
local action = Instance.new(&quot;RemoteEvent&quot;); action.Name = &quot;Action&quot;; action.Parent = remotes
local notice = Instance.new(&quot;RemoteEvent&quot;); notice.Name = &quot;Notice&quot;; notice.Parent = remotes
local bases = workspace:WaitForChild(&quot;PlayerBases&quot;):GetChildren()
local claimed = {}
local zoneNames = {&quot;Meadow&quot;,&quot;Frost&quot;,&quot;Ember&quot;,&quot;Storm&quot;,&quot;Celestial&quot;}
local zoneValues = {5,20,75,250,1000}
local zoneColors = {Color3.fromRGB(80,255,130),Color3.fromRGB(100,220,255),Color3.fromRGB(255,110,55),Color3.fromRGB(170,120,255),Color3.fromRGB(255,240,120)}
local function tell(p,msg) notice:FireClient(p,msg) end
local function stats(p)
 local f=Instance.new(&quot;Folder&quot;); f.Name=&quot;leaderstats&quot;; f.Parent=p
 local cash=Instance.new(&quot;IntValue&quot;); cash.Name=&quot;Cash&quot;; cash.Value=100; cash.Parent=f
 local reb=Instance.new(&quot;IntValue&quot;); reb.Name=&quot;Rebirths&quot;; reb.Value=0; reb.Parent=f
 local inv=Instance.new(&quot;Folder&quot;); inv.Name=&quot;CrystalInventory&quot;; inv.Parent=p
end
local function assignBase(p)
 for _,b in ipairs(bases) do
  if not claimed[b] then
   claimed[b]=p
   local marker=b:FindFirstChild(&quot;BaseSign&quot;,true)
   if marker then marker.Name=&quot;BaseSign_&quot;..p.UserId end
   p:SetAttribute(&quot;BaseName&quot;,b.Name)
   return b
  end
 end
end
local function makeCrystal(zone, index)
 local m=Instance.new(&quot;Model&quot;); m.Name=zone..&quot; Crystal&quot;
 local core=Instance.new(&quot;Part&quot;); core.Name=&quot;Core&quot;; core.Shape=Enum.PartType.Ball
 core.Size=Vector3.new(3,3,3); core.Material=Enum.Material.Neon
 core.Color=zoneColors[index]; core.Anchored=true; core.CanCollide=false
 core.Position=Vector3.new(math.random(-44,44),5,({-35,-90,-145,-200,-255})[index]+math.random(-14,14))
 core.Parent=m
 local prompt=Instance.new(&quot;ProximityPrompt&quot;); prompt.ActionText=&quot;Collect&quot;; prompt.ObjectText=zone..&quot; Crystal&quot;
 prompt.HoldDuration=0.25; prompt.MaxActivationDistance=12; prompt.Parent=core
 m:SetAttribute(&quot;Value&quot;,zoneValues[index]); m:SetAttribute(&quot;Zone&quot;,zone); m.Parent=workspace:WaitForChild(&quot;LiveCrystals&quot;)
 prompt.Triggered:Connect(function(player)
  local ls=player:FindFirstChild(&quot;leaderstats&quot;); if not ls then return end
  local cash=ls:FindFirstChild(&quot;Cash&quot;); if not cash then return end
  cash.Value += zoneValues[index]
  local inv=player:FindFirstChild(&quot;CrystalInventory&quot;)
  if inv then local v=Instance.new(&quot;IntValue&quot;); v.Name=zone..&quot; Crystal&quot;; v.Value=1; v.Parent=inv end
  tell(player,&quot;+&quot;..zoneValues[index]..&quot; Cash • &quot;..zone..&quot; Crystal collected!&quot;)
  m:Destroy()
 end)
end
Players.PlayerAdded:Connect(function(p)
 stats(p); assignBase(p)
 p.CharacterAdded:Connect(function(char)
  task.wait(.4)
  local bName=p:GetAttribute(&quot;BaseName&quot;)
  local b=bName and workspace.PlayerBases:FindFirstChild(bName)
  local floor=b and b:FindFirstChild(&quot;BaseFloor&quot;,true)
  if floor then char:PivotTo(floor.CFrame+Vector3.new(0,5,0)) end
 end)
end)
Players.PlayerRemoving:Connect(function(p)
 for b,owner in pairs(claimed) do if owner==p then claimed[b]=nil end end
end)
task.spawn(function()
 while true do
  for i,z in ipairs(zoneNames) do makeCrystal(z,i) end
  task.wait(9)
 end
end)
task.spawn(function()
 while true do
  for _,p in ipairs(Players:GetPlayers()) do
   local ls=p:FindFirstChild(&quot;leaderstats&quot;)
   if ls then
    local inv=p:FindFirstChild(&quot;CrystalInventory&quot;)
    local count=inv and #inv:GetChildren() or 0
    ls.Cash.Value += count
   end
  end
  task.wait(10)
 end
end)
action.OnServerEvent:Connect(function(p,cmd,arg)
 local ls=p:FindFirstChild(&quot;leaderstats&quot;); if not ls then return end
 if cmd==&quot;UpgradeSpeed&quot; then
  local cost=100*(p:GetAttribute(&quot;SpeedLevel&quot;) or 0+1)
  if ls.Cash.Value&gt;=cost then
   ls.Cash.Value-=cost; local level=(p:GetAttribute(&quot;SpeedLevel&quot;) or 0)+1
   p:SetAttribute(&quot;SpeedLevel&quot;,level)
   if p.Character and p.Character:FindFirstChildOfClass(&quot;Humanoid&quot;) then p.Character:FindFirstChildOfClass(&quot;Humanoid&quot;).WalkSpeed=16+level*3 end
   tell(p,&quot;Speed upgraded!&quot;)
  else tell(p,&quot;Not enough Cash!&quot;) end
 elseif cmd==&quot;Rebirth&quot; then
  if ls.Cash.Value&gt;=5000 then ls.Cash.Value=100; ls.Rebirths.Value+=1; p:SetAttribute(&quot;RebirthMultiplier&quot;,ls.Rebirths.Value+1); tell(p,&quot;Rebirth complete! Income bonus increased.&quot;) else tell(p,&quot;Need 5,000 Cash to Rebirth.&quot;) end
 elseif cmd==&quot;Admin&quot; and ADMIN[p.Name] then
  if arg==&quot;GiveCash&quot; then ls.Cash.Value+=100000
  elseif arg==&quot;Broadcast&quot; then for _,plr in ipairs(Players:GetPlayers()) do tell(plr,&quot;[ADMIN] &quot;..p.Name..&quot; says hello!&quot;) end
  elseif arg==&quot;ClearCrystals&quot; then workspace.LiveCrystals:ClearAllChildren() end
  tell(p,&quot;Admin command executed.&quot;)
 end
end)
</ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item><Item class="StarterGui"><Properties><string name="Name">StarterGui</string></Properties><Item class="ScreenGui"><Properties><string name="Name">CrystalHUD</string><bool name="ResetOnSpawn">false</bool><bool name="IgnoreGuiInset">true</bool></Properties><Item class="LocalScript"><Properties><string name="Name">CrystalHUD</string><ProtectedString name="Source">
local Players=game:GetService(&quot;Players&quot;)
local ReplicatedStorage=game:GetService(&quot;ReplicatedStorage&quot;)
local player=Players.LocalPlayer
local remotes=ReplicatedStorage:WaitForChild(&quot;CrystalRemotes&quot;)
local action=remotes:WaitForChild(&quot;Action&quot;)
local notice=remotes:WaitForChild(&quot;Notice&quot;)
local gui=script.Parent
local function make(class,props,parent)
 local o=Instance.new(class); for k,v in pairs(props) do o[k]=v end; o.Parent=parent; return o
end
local main=make(&quot;Frame&quot;,{Name=&quot;Main&quot;,Size=UDim2.fromOffset(310,220),Position=UDim2.new(0,15,0.5,-110),BackgroundColor3=Color3.fromRGB(20,25,42),BackgroundTransparency=.08},gui)
make(&quot;UICorner&quot;,{CornerRadius=UDim.new(0,16)},main)
make(&quot;UIStroke&quot;,{Color=Color3.fromRGB(80,220,255),Thickness=2},main)
make(&quot;TextLabel&quot;,{Size=UDim2.new(1,0,0,42),BackgroundTransparency=1,Text=&quot;💎  STEAL A CRYSTAL&quot;,TextColor3=Color3.new(1,1,1),TextScaled=true,Font=Enum.Font.GothamBlack},main)
local cash=make(&quot;TextLabel&quot;,{Name=&quot;Cash&quot;,Position=UDim2.fromOffset(12,48),Size=UDim2.new(1,-24,0,30),BackgroundColor3=Color3.fromRGB(35,45,65),Text=&quot;Cash: 0&quot;,TextColor3=Color3.fromRGB(255,230,100),TextScaled=true,Font=Enum.Font.GothamBold},main)
make(&quot;UICorner&quot;,{CornerRadius=UDim.new(0,8)},cash)
local function button(text,y,cmd)
 local b=make(&quot;TextButton&quot;,{Size=UDim2.new(1,-24,0,34),Position=UDim2.fromOffset(12,y),BackgroundColor3=Color3.fromRGB(45,125,180),Text=text,TextColor3=Color3.new(1,1,1),TextScaled=true,Font=Enum.Font.GothamBold},main)
 make(&quot;UICorner&quot;,{CornerRadius=UDim.new(0,9)},b); b.Activated:Connect(function() action:FireServer(cmd) end)
end
button(&quot;⚡ Upgrade Speed  •  100+&quot;,86,&quot;UpgradeSpeed&quot;)
button(&quot;♻ Rebirth  •  5,000&quot;,126,&quot;Rebirth&quot;)
local admin=make(&quot;TextButton&quot;,{Name=&quot;AdminButton&quot;,Size=UDim2.fromOffset(120,34),Position=UDim2.new(1,-135,0,15),BackgroundColor3=Color3.fromRGB(110,55,180),Text=&quot;ADMIN PANEL&quot;,TextColor3=Color3.new(1,1,1),TextScaled=true,Font=Enum.Font.GothamBold,Visible=player.Name==&quot;amin_12in2&quot;},gui)
make(&quot;UICorner&quot;,{CornerRadius=UDim.new(0,9)},admin)
local panel=make(&quot;Frame&quot;,{Name=&quot;AdminPanel&quot;,Size=UDim2.fromOffset(230,170),Position=UDim2.new(1,-245,0,58),BackgroundColor3=Color3.fromRGB(30,20,48),Visible=false},gui)
make(&quot;UICorner&quot;,{CornerRadius=UDim.new(0,12)},panel)
make(&quot;TextLabel&quot;,{Size=UDim2.new(1,0,0,34),BackgroundTransparency=1,Text=&quot;OWNER CONTROL • amin_12in2&quot;,TextColor3=Color3.new(1,1,1),TextScaled=true,Font=Enum.Font.GothamBold},panel)
local function adminButton(label,y,cmd)
 local b=make(&quot;TextButton&quot;,{Size=UDim2.new(1,-16,0,32),Position=UDim2.fromOffset(8,y),BackgroundColor3=Color3.fromRGB(95,65,155),Text=label,TextColor3=Color3.new(1,1,1),TextScaled=true},panel)
 b.Activated:Connect(function() action:FireServer(&quot;Admin&quot;,cmd) end)
end
adminButton(&quot;Give 100,000 Cash&quot;,40,&quot;GiveCash&quot;); adminButton(&quot;Broadcast&quot;,78,&quot;Broadcast&quot;); adminButton(&quot;Clear Crystals&quot;,116,&quot;ClearCrystals&quot;)
admin.Activated:Connect(function() panel.Visible=not panel.Visible end)
local toast=make(&quot;TextLabel&quot;,{Size=UDim2.new(0,360,0,42),Position=UDim2.new(.5,-180,0,20),BackgroundColor3=Color3.fromRGB(20,25,42),Text=&quot;&quot;,TextColor3=Color3.new(1,1,1),TextScaled=true,Visible=false,Font=Enum.Font.GothamBold},gui)
make(&quot;UICorner&quot;,{CornerRadius=UDim.new(0,10)},toast)
notice.OnClientEvent:Connect(function(msg) toast.Text=msg; toast.Visible=true; task.delay(2.5,function() toast.Visible=false end) end)
task.spawn(function()
 while true do
  local ls=player:FindFirstChild(&quot;leaderstats&quot;); local c=ls and ls:FindFirstChild(&quot;Cash&quot;)
  if c then cash.Text=&quot;💰 Cash: &quot;..c.Value end
  task.wait(.25)
 end
end)
